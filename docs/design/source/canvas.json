      "x": 3040,
      "y": 0
    },
    "nkoy": {
      "fill": "orange",
      "page": "koy",
      "text": "Karar: Koy tam ekran bir uygulama olmasın, orta boy yeter. Pencereyi kapatmak Koy'u kapatmaz; çıkış yalnız sağ alttaki menüden ya da pencerenin sol altındaki düğmeden.",
      "w": 300,
      "x": 4400,
      "y": 0
    },
