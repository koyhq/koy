<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Koy</Company>
    <Product>Koy</Product>
    <Version>0.2.8</Version> <!-- x-release-please-version -->
    <PlatformTarget>x64</PlatformTarget>
    <Authors>Burhan Şahin</Authors>
    <Copyright>Copyright (c) 2026 Burhan Şahin</Copyright>
    <Description>Lightweight spring-animated notch and smart desktop dock for Windows 11</Description>
    <RepositoryUrl>https://github.com/koyhq/koy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Katı derleme (issue #138): uyarı hata sayılır, önerilen .NET analizcileri ve kod biçimi kuralları derlemede çalışır.
    Kural seçimi ve susturmalar kökteki .editorconfig'te.
    NU1901–NU1904 (paket güvenlik bildirimi) hata sayılmaz: dış veritabanına bağlıdır, kod değişmeden derlemeyi
    kırabilir. Görünür kalırlar; CI "dotnet list package" ile açıkları ayrıca denetler.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Tekrarlanabilir derleme: PDB ve assembly içine yerel dizin yolu (C:\Users\...) gömülmesin. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!-- SourceLink eşlemesindeki yerel kök dizin de /_/ olarak yazılsın (yerel derlemede de). -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
