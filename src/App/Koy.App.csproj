<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Koy.App</RootNamespace>
    <AssemblyName>Koy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <StartupObject>Koy.App.Program</StartupObject>

    <!-- Bellek: masaüstü uygulaması için en hafif GC ayarları. Değiştirmeden önce ölç (AGENTS.md). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\backgrounds\*.mp4" Link="assets\backgrounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\backgrounds\*.png" Link="assets\backgrounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Koy.Core.csproj" />
    <ProjectReference Include="..\Platform\Koy.Platform.csproj" />
  </ItemGroup>

  <!-- Takvim OAuth istemcileri: sürümde CI gizli anahtarlarından (release.yml) gelir, depoda değer yoktur.
       Boş kalırsa kullanıcı Ayarlar'da kendi istemcisini girebilir. Okuyan: Features/Calendar/BuiltInCalendarClients. -->
  <ItemGroup>
    <AssemblyMetadata Include="KoyOAuthGoogleClientId" Value="$(KOY_BUILD_GOOGLE_CLIENT_ID)" />
    <AssemblyMetadata Include="KoyOAuthGoogleClientSecret" Value="$(KOY_BUILD_GOOGLE_CLIENT_SECRET)" />
    <AssemblyMetadata Include="KoyOAuthOutlookClientId" Value="$(KOY_BUILD_OUTLOOK_CLIENT_ID)" />
  </ItemGroup>
</Project>
