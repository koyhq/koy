<Window x:Class="Koy.App.Features.Menu.SagAltMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Menu"
        xmlns:res="clr-namespace:Koy.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SagAltMenuViewModel}"
        Title="{Binding [MenuWindowTitle], Source={x:Static res:Loc.Instance}}"
        Width="320"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource KoyFont}"
        Deactivated="Window_Deactivated">

    <!-- Katmansız pencere, çerçeve istemci alanına uzatılır; bulanıklık, gölge ve köşeler DWM'den (WindowFrame). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MenuActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource KoyRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource KoyBgControl}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource KoyBorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource KoyDangerText}" />
        </Style>

        <Style x:Key="UpdateActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource KoyOnAccent}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource KoyRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource KoyAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAvailableUpdate}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Ana açılır menü kabuğu: 320 px; köşe, kenarlık ve gölge DWM'den (WindowFrame), yüzey malzemeyi izler. -->
    <Border Background="{DynamicResource KoyBgWindow}"
            Padding="14">

        <StackPanel>
            <!-- Başlık Alanı -->
            <Grid Margin="2,2,4,12">
                <TextBlock Text="Koy"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource KoyTextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding MonitorSummary}"
                           FontSize="12"
                           Foreground="{DynamicResource KoyTextSecondary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 2 Sütunlu Aç/Kapa Izgarası (64 px kartlar) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Çentik Düğmesi -->
                <Button Grid.Column="0"
                        Height="64"
                        Command="{Binding ToggleNotchCommand}"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cardBorder"
                                    CornerRadius="{DynamicResource KoyRadiusRow}"
                                    Padding="14,0"
                                    Background="{DynamicResource KoyAccent}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblTitle"
                                               Text="{Binding [NavNotch], Source={x:Static res:Loc.Instance}}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource KoyOnAccent}" />
                                    <TextBlock x:Name="lblStateOn"
                                               Text="{Binding [On], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource KoyOnAccent}"
                                               Opacity="0.8"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="lblStateOff"
                                               Text="{Binding [Off], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource KoyTextSecondary}"
                                               Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding NotchEnabled}" Value="False">
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource KoyBgControl}" />
                                    <Setter TargetName="lblTitle" Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
                                    <Setter TargetName="lblStateOn" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="lblStateOff" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Dock Düğmesi -->
                <Button Grid.Column="2"
                        Height="64"
                        Command="{Binding ToggleDockCommand}"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cardBorder"
                                    CornerRadius="{DynamicResource KoyRadiusRow}"
                                    Padding="14,0"
                                    Background="{DynamicResource KoyAccent}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblTitle"
                                               Text="{Binding [NavDock], Source={x:Static res:Loc.Instance}}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource KoyOnAccent}" />
                                    <TextBlock x:Name="lblStateOn"
                                               Text="{Binding [On], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource KoyOnAccent}"
                                               Opacity="0.8"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="lblStateOff"
                                               Text="{Binding [Off], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource KoyTextSecondary}"
                                               Margin="0,2,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding DockEnabled}" Value="False">
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource KoyBgControl}" />
                                    <Setter TargetName="lblTitle" Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
                                    <Setter TargetName="lblStateOn" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="lblStateOff" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Eylem Listesi -->
            <StackPanel>
                <Button Style="{StaticResource MenuActionButtonStyle}" Command="{Binding OpenKoyWindowCommand}">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{DynamicResource IconAppWindow}" Size="16" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding [OpenKoyWindowAction], Source={x:Static res:Loc.Instance}}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuActionButtonStyle}" Command="{Binding PauseOneHourCommand}">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{DynamicResource IconPause}" Size="16" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding PauseText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource UpdateActionButtonStyle}" Command="{Binding OpenUpdateCommand}" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{StaticResource IconDownload}" Size="16" Margin="0,0,12,0" Foreground="{DynamicResource KoyOnAccent}" />
                        <TextBlock Text="{Binding AvailableVersionText}" FontWeight="SemiBold" Foreground="{DynamicResource KoyOnAccent}" />
                    </StackPanel>
                </Button>

                <Rectangle Height="1"
                           Fill="{DynamicResource KoyBorderHairline}"
                           Margin="0,6" />

                <Button Style="{StaticResource DangerActionButtonStyle}" Command="{Binding ExitCommand}">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{DynamicResource IconPower}" Size="16" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ExitText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
