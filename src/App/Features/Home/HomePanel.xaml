<UserControl x:Class="Koy.App.Features.Home.HomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Home"
             xmlns:status="clr-namespace:Koy.App.Features.Status"
             xmlns:music="clr-namespace:Koy.App.Features.Music"
             xmlns:focus="clr-namespace:Koy.App.Features.Focus"
             xmlns:livebg="clr-namespace:Koy.App.Features.Notch.LiveBackground"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:HomeViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <!--
    Ana sekmesinin iki yüzü (D tasarımı, docs/design/taslak/centik-d.html); üst ortadaki anahtar seçer:
    - Müzik: tam sayfa oynatıcı (büyük kapak, başlık, sözler, ilerleme, denetimler). Canlı yayında CANLI rozeti, çubuk yok.
    - Ana: solda "Bugün" (gün, hava, sıradaki etkinlikler), sağda Odak satırı, sistem kartı ve hızlı başlat.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Müzik kartı renkleri: varsayılan Tokens fırçaları (Düz stil, gri ya da kapaksız parça); kapaktan palet
         çıkmışsa MusicViewModel'in dondurulmuş fırçaları. -->
    <Style x:Key="MusicSubText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchMusicSub}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Music.HasTint}" Value="True">
          <Setter Property="Foreground" Value="{Binding Music.SubTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MusicArtistText" TargetType="TextBlock" BasedOn="{StaticResource MusicSubText}">
      <Style.Triggers>
        <!-- Videolarda sanatçı boş gelir; boş satır başlıkla uygulama adı arasında boşluk bırakmasın. -->
        <DataTrigger Binding="{Binding Music.Artist}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MusicSpectrumBars" TargetType="music:SpectrumBars">
      <Setter Property="Fill" Value="{DynamicResource KoyNotchMusicSpectrum}" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Music.HasTint}" Value="True" />
            <Condition Binding="{Binding Music.VisualizerColorSource}" Value="Artwork" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Fill" Value="{Binding Music.SpectrumBrush}" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Albüm kapağı stili: kapağın üstüne kart tonu, onun üstüne koyu perde (#0A0A0B 0,55 → 0,85). BlurEffect yok. -->
    <LinearGradientBrush x:Key="MusicArtworkVeil" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#8C0A0A0B" Offset="0" />
      <GradientStop Color="#D90A0A0B" Offset="1" />
    </LinearGradientBrush>

    <!-- Yuvarlak oynatıcı düğmesi: fare üstünde hafif ışık, basınca hafif küçülme -->
    <Style x:Key="PlayerButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform />
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Hover" Fill="{DynamicResource KoyNotchHover}" Visibility="Collapsed" />
              <Ellipse Fill="{TemplateBinding Background}" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kart içi düz düğme: yalnız tıklanabilir yüzey -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource KoyNotchText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- Saydam zemin: içerik boşluklarına (ör. "+" çerçevesinin ortası) tıklama da düğmeye gider; yoksa tıklama
                 arkadaki karta düşer ve çentik boşluğa tıklandı sanıp kapanır. -->
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Satır düğmesi: fare üstünde hafif zemin (etkinlik satırları) -->
    <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource CardButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kare kapak ya da (video) yatay kapak: yatayda resmin tamamı, arkada bulanık hâli. Kapak yoksa nota. -->
    <DataTemplate x:Key="CoverArt">
      <Grid>
        <Path Width="56" Height="56" Stretch="Uniform" Fill="#60FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
        <Rectangle Margin="-24" Opacity="0.85" RenderOptions.BitmapScalingMode="LowQuality"
                   Visibility="{Binding Music.IsWideCover, Converter={StaticResource BoolToVis}}">
          <Rectangle.Fill>
            <ImageBrush ImageSource="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
          </Rectangle.Fill>
          <Rectangle.Effect>
            <BlurEffect Radius="18" KernelType="Gaussian" />
          </Rectangle.Effect>
        </Rectangle>
        <Rectangle RenderOptions.BitmapScalingMode="HighQuality">
          <Rectangle.Style>
            <Style TargetType="Rectangle">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Music.IsWideCover}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Rectangle.Style>
          <Rectangle.Fill>
            <ImageBrush ImageSource="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
          </Rectangle.Fill>
        </Rectangle>
        <Image Source="{Binding Music.Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding Music.IsWideCover, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- ============================== MÜZİK YÜZÜ ============================== -->
    <Border CornerRadius="20" Padding="18" BorderBrush="{DynamicResource KoyNotchCardBorder}" BorderThickness="1"
            MouseLeftButtonDown="MusicCard_MouseLeftButtonDown" RenderOptions.BitmapScalingMode="Linear"
            Visibility="{Binding IsMusicPage, Converter={StaticResource BoolToVis}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource KoyNotchMusicCard}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Music.HasTint}" Value="True">
              <Setter Property="Background" Value="{Binding Music.CardBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Music.HasBackdrop}" Value="True">
              <Setter Property="Background" Value="{Binding Music.BackdropBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <Grid>
        <!-- Albüm kapağı stili: kart zemini büyütülmüş kapak; üstüne kart tonu ve koyu perde. Kenarlara kadar uzanır. -->
        <Border Margin="-18" CornerRadius="20" IsHitTestVisible="False" Background="{Binding Music.TintOverlayBrush}"
                Visibility="{Binding Music.HasBackdrop, Converter={StaticResource BoolToVis}}">
          <Border CornerRadius="20" Background="{StaticResource MusicArtworkVeil}" />
        </Border>

        <!-- Canlı arka plan (issue #67): kapalıyken (varsayılan) hiçbir şey çizilmez; koyu perde yazıyı korur. -->
        <livebg:LiveBackgroundHost Margin="-18" CornerRadius="20"
                                   Selection="{Binding LiveBackground.Selection}"
                                   Mode="{Binding LiveBackground.MusicCardMode}"
                                   ScrimOpacity="{Binding LiveBackground.ScrimOpacity}" />

        <!-- Çalan bir şey yok -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Music.HasTrack}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <res:KoyIcon Data="{DynamicResource IconMusic}" Size="28" Foreground="{DynamicResource KoyNotchDim}" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static res:Strings.NoMediaPlaying}" FontSize="13" Foreground="{DynamicResource KoyNotchMuted}" Margin="0,10,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Oynatıcı -->
        <Grid Visibility="{Binding Music.HasTrack, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Width="200" Height="200" CornerRadius="20" Background="{DynamicResource KoyNotchMusicCover}" ClipToBounds="True" VerticalAlignment="Center">
            <Grid>
              <Grid.Clip>
                <RectangleGeometry Rect="0,0,200,200" RadiusX="20" RadiusY="20" />
              </Grid.Clip>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CoverArt}" />
            </Grid>
          </Border>

          <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık satırı: canlıysa rozet, başlık (iki satıra kadar), sanatçı ve uygulama; sağ üstte sözler düğmesi -->
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Border HorizontalAlignment="Left" CornerRadius="9" Background="#EF4444" Padding="7,2" Margin="0,0,0,6"
                        Visibility="{Binding Music.IsLive, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="White" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding [MusicLive], Source={x:Static res:Loc.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding Music.Title}" FontFamily="{DynamicResource KoyNotchDisplayFont}" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" LineHeight="25" LineStackingStrategy="BlockLineHeight" />
                <TextBlock Text="{Binding Music.Artist}" FontSize="12.5" Style="{StaticResource MusicArtistText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Music.SourceAppId}" FontSize="11" Style="{StaticResource MusicSubText}" Opacity="0.7" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <!-- Sözler: varsayılan kapalı (başlık LRCLIB'e gider); kullanıcı buradan açar. Açıkken tam, kapalıyken soluk. -->
              <Button Grid.Column="1" Style="{StaticResource PlayerButtonStyle}" Width="30" Height="30" VerticalAlignment="Top" Margin="8,0,0,0"
                      Command="{Binding Music.Lyrics.ToggleEnabledCommand}"
                      Visibility="{Binding Music.Lyrics.CanToggle, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding [LyricsToggle], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [LyricsSettingTitle], Source={x:Static res:Loc.Instance}}">
                <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource KoyNotchText}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4 6h16M4 11h16M4 16h9M4 21h6">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Setter Property="Opacity" Value="0.45" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Music.Lyrics.IsEnabled}" Value="True">
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
              </Button>
            </Grid>

            <!-- Orta: sözler açıksa sözler, değilse ses çubukları (çalan sesten; yakalama yalnız bu yüz görünürken) -->
            <music:SpectrumBars Grid.Row="1" Height="30" BarWidth="6" Gap="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Feed="{Binding Music.Spectrum}" VisualizerStyle="{Binding Music.VisualizerStyle}"
                                Style="{StaticResource MusicSpectrumBars}" IsHitTestVisible="False">
              <music:SpectrumBars.Visibility>
                <MultiBinding Converter="{x:Static local:AllTrueToVisibility.Instance}">
                  <Binding Path="Music.ShowSpectrum" />
                  <Binding Path="Music.Lyrics.IsShown" Converter="{x:Static local:NotConverter.Instance}" />
                </MultiBinding>
              </music:SpectrumBars.Visibility>
            </music:SpectrumBars>
            <music:LyricsView Grid.Row="1" FontSize="13.5" Margin="0,10,0,8" DataContext="{Binding Music.Lyrics}"
                              Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}" />

            <!-- İlerleme: tam genişlik ince çubuk, süreler altında. Canlı yayında yok. -->
            <StackPanel Grid.Row="2" Margin="0,0,0,6">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Music.IsLive}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Music.Progress, Mode=OneWay}" Height="4"
                           Background="#2EFFFFFF" Foreground="{DynamicResource KoyNotchText}" BorderThickness="0"
                           Cursor="Hand" MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown" />
              <Grid Margin="0,5,0,0">
                <TextBlock Text="{Binding Music.PositionText}" FontSize="11" Foreground="#8CFFFFFF" />
                <TextBlock Text="{Binding Music.DurationText}" FontSize="11" Foreground="#8CFFFFFF" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>

            <!-- Denetimler: büyük beyaz oynat / duraklat, iki yanında önceki / sonraki (canlıda soluk) -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Style="{StaticResource PlayerButtonStyle}" Width="40" Height="40" Command="{Binding Music.PreviousCommand}"
                      IsEnabled="{Binding Music.IsLive, Converter={x:Static local:NotConverter.Instance}}"
                      ToolTip="{Binding [MusicPrevious], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [MusicPrevious], Source={x:Static res:Loc.Instance}}">
                <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M6 5h2v14H6zM20 5v14L9 12z" />
              </Button>
              <Button Style="{StaticResource PlayerButtonStyle}" Width="52" Height="52" Margin="24,0" Background="{DynamicResource KoyNotchText}"
                      Command="{Binding Music.PlayPauseCommand}"
                      ToolTip="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}">
                <Button.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="Black" />
                </Button.Effect>
                <Grid>
                  <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource KoyNotchSurface}" Data="M7 4l12 8-12 8z">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Music.IsPlaying}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                  <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource KoyNotchSurface}" Data="M7 5h4v14H7zM13 5h4v14h-4z"
                        Visibility="{Binding Music.IsPlaying, Converter={StaticResource BoolToVis}}" />
                </Grid>
              </Button>
              <Button Style="{StaticResource PlayerButtonStyle}" Width="40" Height="40" Command="{Binding Music.NextCommand}"
                      IsEnabled="{Binding Music.IsLive, Converter={x:Static local:NotConverter.Instance}}"
                      ToolTip="{Binding [MusicNext], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [MusicNext], Source={x:Static res:Loc.Instance}}">
                <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M16 5h2v14h-2zM4 5v14l11-7z" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- ============================== ANA YÜZÜ ============================== -->
    <Grid Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="268" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- SOL: Bugün. Gün, hava (konum yoksa "Konum seç"), ince çizgi, sıradaki etkinlik ve sonraki ikisi. -->
      <Border Grid.Column="0" CornerRadius="18" Background="{DynamicResource KoyNotchCard}" BorderBrush="{DynamicResource KoyNotchCardBorder}" BorderThickness="1" Padding="16,14,16,10">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Status.Greeting}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding Status.DayDate}" FontFamily="{DynamicResource KoyNotchDisplayFont}" FontSize="21" FontWeight="SemiBold"
                     Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

          <Button DockPanel.Dock="Top" Style="{StaticResource CardButtonStyle}" Margin="0,10,0,0" Command="{Binding Status.RefreshWeatherCommand}"
                  ToolTip="{Binding Status.WindToolTip}"
                  Visibility="{Binding ShowWeather, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                <status:WeatherGlyph DataContext="{Binding Status}" />
              </Viewbox>
              <TextBlock Text="{Binding Status.TemperatureShort}" FontFamily="{DynamicResource KoyNotchDisplayFont}" FontSize="25" FontWeight="SemiBold"
                         Margin="10,0,10,0" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status.WeatherDescription}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                <TextBlock Text="{Binding Status.PlaceName}" FontSize="11.5" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Top" Style="{StaticResource CardButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Left"
                  Command="{Binding ChooseWeatherLocationCommand}"
                  Visibility="{Binding ShowNoLocation, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding [WeatherPickLocation], Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" />
          </Button>

          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource KoyNotchDivider}" Margin="0,12,0,8" />

          <!-- Sıradaki: vurgulu kutu; tıklayınca Takvim o günde açılır -->
          <Button DockPanel.Dock="Top" Style="{StaticResource CardButtonStyle}" Margin="-6,0"
                  Command="{Binding OpenEventCommand}" CommandParameter="{Binding NextEvent}"
                  Visibility="{Binding HasNextEvent, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="12" Background="#1438BDF8" Padding="10,7">
              <StackPanel>
                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchAccentCalendar}" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding [HomeNextUp], Source={x:Static res:Loc.Instance}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding NextEvent.Until, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding NextEvent.Title}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NextEvent.When}" FontSize="11.5" Foreground="{DynamicResource KoyNotchMuted}" />
              </StackPanel>
            </Border>
          </Button>
          <TextBlock DockPanel.Dock="Top" Text="{Binding [HomeNoEvents], Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasNextEvent}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding LaterEvents}" Focusable="False" Margin="-4,4,-4,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:UpcomingEventRow}">
                <Button Style="{StaticResource RowButtonStyle}" Padding="4,3"
                        Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=local:HomePanel}}"
                        CommandParameter="{Binding}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="82" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="13" CornerRadius="2" Background="{DynamicResource KoyNotchAccentCalendar}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- SAĞ: Odak satırı (yalnız Zamanlayıcılar kartı açıksa), sonra kartlar ayardaki sırayla (kulaklık, sistem, hızlı başlat). -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="58" Margin="0,0,0,10" CornerRadius="18" Background="{DynamicResource KoyNotchCard}" BorderBrush="{DynamicResource KoyNotchCardBorder}" BorderThickness="1" Padding="12,0,10,0"
                Visibility="{Binding ShowFocusRow, Converter={StaticResource BoolToVis}}">
          <Grid>
            <!-- Çalışıyor: halka, tür ve kalan süre, duraklat ve (Pomodoro'da) sonraki aşama -->
            <Grid Visibility="{Binding Focus.HasRunning, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <focus:ArcRing Width="36" Height="36" Progress="{Binding Focus.Progress}" Thickness="4"
                             TrackBrush="{DynamicResource KoyNotchHover}" FillBrush="{DynamicResource KoyNotchAccentFocus}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Margin="12,0,8,0" VerticalAlignment="Center" Command="{Binding OpenFocusCommand}">
                <StackPanel>
                  <TextBlock Text="{Binding Focus.HomeLine}" FontSize="11" Foreground="{DynamicResource KoyNotchAccentFocus}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Focus.RunningText}" FontFamily="{DynamicResource KoyNotchDisplayFont}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PlayerButtonStyle}" Width="30" Height="30" Background="{DynamicResource KoyNotchChip}"
                        Command="{Binding Focus.ToggleRunningCommand}"
                        ToolTip="{Binding [MusicPlayPause], Source={x:Static res:Loc.Instance}}">
                  <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M7 5h4v14H7zM13 5h4v14h-4z" />
                </Button>
                <Button Style="{StaticResource PlayerButtonStyle}" Width="30" Height="30" Margin="4,0,0,0"
                        Command="{Binding Focus.SkipCommand}"
                        Visibility="{Binding Focus.CanSkip, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding [FocusSkip], Source={x:Static res:Loc.Instance}}">
                  <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M16 5h2v14h-2zM4 5v14l11-7z" />
                </Button>
              </StackPanel>
            </Grid>
            <!-- Çalışmıyor: başlat / sürdür (seçili zamanlayıcı) -->
            <Button Style="{StaticResource CardButtonStyle}" Command="{Binding Focus.ToggleRunningCommand}">
              <Button.Visibility>
                <Binding Path="Focus.HasRunning" Converter="{x:Static local:NotConverter.Instance}" ConverterParameter="Visibility" />
              </Button.Visibility>
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <res:KoyIcon Data="{DynamicResource IconTabFocus}" Size="17" Foreground="{DynamicResource KoyNotchAccentFocus}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding [HomeFocusStart], Source={x:Static res:Loc.Instance}}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Focus.TimeText}" FontSize="12.5" Foreground="{DynamicResource KoyNotchDim}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource KoyNotchChip}" HorizontalAlignment="Right">
                  <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}" Data="M7 4l12 8-12 8z" Margin="2,0,0,0" />
                </Border>
              </Grid>
            </Button>
          </Grid>
        </Border>

        <Grid x:Name="RightColumnGrid" Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Kulaklık kartı: bağlı ses cihazının adı ve (varsa) pili. -->
          <Border x:Name="HeadphoneCardBorder" Grid.Row="0" Height="40" Margin="0,0,0,10" CornerRadius="16" Background="{DynamicResource KoyNotchCard}" BorderBrush="{DynamicResource KoyNotchCardBorder}" BorderThickness="1" Padding="12,0"
                  Visibility="{Binding ShowHeadphoneCard, Converter={StaticResource BoolToVis}}">
            <Grid DataContext="{Binding Bluetooth.PrimaryAudio}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <res:KoyIcon Size="15" StrokeWidth="2" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center">
                <res:KoyIcon.Style>
                  <Style TargetType="res:KoyIcon">
                    <Setter Property="Data" Value="{DynamicResource IconHeadphones}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="Speaker">
                        <Setter Property="Data" Value="{DynamicResource IconSpeaker}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </res:KoyIcon.Style>
              </res:KoyIcon>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding BatteryText}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center"
                         Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
            </Grid>
          </Border>

          <!-- Sistem: işlemci, bellek ve ağ tek kartta; tıklayınca Sistem sayfası -->
          <Button x:Name="SystemCardGrid" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource CardButtonStyle}" Command="{Binding OpenSystemCommand}"
                  Visibility="{Binding ShowSystemCard, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="18" Background="{DynamicResource KoyNotchCard}" BorderBrush="{DynamicResource KoyNotchCardBorder}" BorderThickness="1" Padding="16,0">
              <StackPanel VerticalAlignment="Center">
                <Grid>
                  <TextBlock Text="{Binding [HomeCpu], Source={x:Static res:Loc.Instance}}" FontSize="12.5" />
                  <TextBlock HorizontalAlignment="Right" FontSize="12.5">
                    <Run Text="{Binding Stats.CpuText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Stats.TopProcessText, Mode=OneWay}" Foreground="{DynamicResource KoyNotchMuted}" FontSize="11.5" />
                  </TextBlock>
                </Grid>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Stats.CpuProgress, Mode=OneWay}" Height="4" Margin="0,6,0,0" BorderThickness="0"
                             Background="{DynamicResource KoyNotchHover}" Foreground="#BFFFFFFF" />
                <Grid Margin="0,12,0,0">
                  <TextBlock Text="{Binding [HomeRam], Source={x:Static res:Loc.Instance}}" FontSize="12.5" />
                  <TextBlock HorizontalAlignment="Right" FontSize="12.5">
                    <Run Text="{Binding Stats.RamText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Stats.MemoryDetailText, Mode=OneWay}" Foreground="{DynamicResource KoyNotchMuted}" FontSize="11.5" />
                  </TextBlock>
                </Grid>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Stats.RamProgress, Mode=OneWay}" Height="4" Margin="0,6,0,0" BorderThickness="0"
                             Background="{DynamicResource KoyNotchHover}" Foreground="#BFFFFFFF" />
                <Grid Margin="0,12,0,0">
                  <StackPanel Orientation="Horizontal">
                    <res:KoyIcon Data="{DynamicResource IconWifi}" Size="14" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Stats.NetworkName}" FontSize="12.5" Margin="8,0,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center">
                    <Run Text="{Binding Stats.DownloadText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Stats.UploadText, Mode=OneWay}" />
                  </TextBlock>
                </Grid>
              </StackPanel>
            </Border>
          </Button>

          <!-- Hızlı başlat: başlık ve simgeler tek satırda -->
          <Border x:Name="QuickLaunchCardBorder" Grid.Row="2" Height="54" CornerRadius="18" Background="{DynamicResource KoyNotchCard}" BorderBrush="{DynamicResource KoyNotchCardBorder}" BorderThickness="1" Padding="14,0,10,0"
                  Visibility="{Binding ShowQuickLaunchCard, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding [QuickLaunchTitle], Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
              <ItemsControl ItemsSource="{Binding QuickLaunch.Items}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:QuickLaunchItemViewModel}">
                    <Button Style="{StaticResource CardButtonStyle}" Margin="0,0,5,0" ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name}"
                            Command="{Binding DataContext.QuickLaunch.LaunchCommand, RelativeSource={RelativeSource AncestorType=local:HomePanel}}"
                            CommandParameter="{Binding}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{Binding [QuickLaunchRemove], Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding PlacementTarget.Tag.QuickLaunch.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Button.Tag>
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=local:HomePanel}" />
                      </Button.Tag>
                      <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource KoyNotchChip}">
                        <Grid>
                          <Image Source="{Binding Icon}" Width="19" Height="19" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                 Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                          <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource CardButtonStyle}" Command="{Binding QuickLaunch.AddCommand}"
                      Visibility="{Binding QuickLaunch.CanAdd, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding [QuickLaunchAdd], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [QuickLaunchAdd], Source={x:Static res:Loc.Instance}}">
                <Button.ContextMenu>
                  <ContextMenu Opened="AddButton_ContextMenuOpened" Closed="AddButton_ContextMenuClosed">
                    <MenuItem Header="{Binding [QuickLaunchAddFile], Source={x:Static res:Loc.Instance}}"
                              Command="{Binding PlacementTarget.Tag.QuickLaunch.AddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{Binding [QuickLaunchAddFolder], Source={x:Static res:Loc.Instance}}"
                              Command="{Binding PlacementTarget.Tag.QuickLaunch.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Button.Tag>
                  <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=local:HomePanel}" />
                </Button.Tag>
                <Grid Width="30" Height="30">
                  <Rectangle RadiusX="9" RadiusY="9" Stroke="{DynamicResource KoyNotchDash}" StrokeThickness="1.5" StrokeDashArray="3 3" />
                  <res:KoyIcon Data="{DynamicResource IconPlus}" Size="13" StrokeWidth="2.2" Foreground="{DynamicResource KoyNotchMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
