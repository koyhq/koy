<Window x:Class="Koy.App.Features.Wizard.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Wizard"
        xmlns:res="clr-namespace:Koy.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SetupWizardViewModel}"
        Title="{Binding [WizardWindowTitle], Source={x:Static res:Loc.Instance}}"
        Width="880"
        Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource KoyFont}"
        FontWeight="{DynamicResource KoyFontWeightBase}"
        Foreground="{DynamicResource KoyTextPrimary}">

    <!-- Katmansız pencere, çerçeve istemci alanına uzatılır; bulanıklık, gölge ve köşeler DWM'den (WindowFrame). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WizardNavButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderStrong}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource KoyRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource KoyBgControl}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource WizardNavButton}">
            <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource KoyOnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource KoyRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource KoyAccentPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ana pencere gövdesi: köşe ve kenarlık DWM'den (WindowFrame). -->
    <Border Background="{DynamicResource KoyBgWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" /> <!-- Başlık çubuğu / sürükleme alanı -->
                <RowDefinition Height="*" />  <!-- Adım içeriği -->
                <RowDefinition Height="76" /> <!-- Alt gezinme çubuğu -->
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="16,4,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Text="{Binding [WizTitle], Source={x:Static res:Loc.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource KoyTextSecondary}" Cursor="Hand" Click="Close_Click">
                    <res:KoyIcon Data="{StaticResource IconX}" Size="14" />
                </Button>
            </Grid>

            <!-- ADIM 1: Hoş Geldiniz ve Dil Seçimi -->
            <Grid Grid.Row="1" Margin="56,20,56,0" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [WizStep1], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding [WizWelcomeTitle], Source={x:Static res:Loc.Instance}}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding [WizWelcomeBody], Source={x:Static res:Loc.Instance}}"
                               FontSize="15" Foreground="{DynamicResource KoyTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,28" LineHeight="22" />

                    <!-- Dil Seçimi Bölümü -->
                    <Border Background="{DynamicResource KoyBgRow}" CornerRadius="{DynamicResource KoyRadiusRow}" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizLangTitle], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                                <TextBlock Text="{Binding [WizLangDesc], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140" Height="36" VerticalAlignment="Center"
                                      SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}"
                                      Style="{StaticResource SettingComboBoxStyle}">
                                <ComboBoxItem Content="Türkçe" Tag="tr" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ADIM 2: Koy ekranında ne olsun? (3 Kartlı Seçim) -->
            <Grid Grid.Row="1" Margin="56,16,56,0" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding [WizStep2], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding [WizLayoutTitle], Source={x:Static res:Loc.Instance}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding [WizLayoutSub], Source={x:Static res:Loc.Instance}}" FontSize="14" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,0,0,24" />

                    <!-- 3 Kartlı Izgara -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Kart 0: Çentik ve dock -->
                        <Border Grid.Column="0" Height="248" CornerRadius="14" Background="{DynamicResource KoyBgRow}" Cursor="Hand" MouseLeftButtonDown="Card0_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayoutIndex}" Value="0">
                                            <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Üst Önizleme Tuvali -->
                                <Border Grid.Row="0" Background="{DynamicResource KoyBorderHairline}" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <!-- Mini Çentik -->
                                        <Border Width="64" Height="12" Background="#0A0A0B" CornerRadius="0,0,7,7"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        <!-- Mini Dock -->
                                        <Border Width="120" Height="18" Background="{DynamicResource KoyBgWindow}" CornerRadius="7"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                    </Grid>
                                </Border>
                                <!-- Alt Açıklama -->
                                <StackPanel Grid.Row="1" Margin="14,12">
                                    <TextBlock Text="{Binding [WizBothTitle], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                                    <TextBlock Text="{Binding [WizBothDesc], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource KoyTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Kart 1: Yalnız çentik -->
                        <Border Grid.Column="2" Height="248" CornerRadius="14" Background="{DynamicResource KoyBgRow}" Cursor="Hand" MouseLeftButtonDown="Card1_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayoutIndex}" Value="1">
                                            <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource KoyBorderHairline}" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <!-- Mini Çentik -->
                                        <Border Width="64" Height="12" Background="#0A0A0B" CornerRadius="0,0,7,7"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12">
                                    <TextBlock Text="{Binding [WizNotchTitle], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                                    <TextBlock Text="{Binding [WizNotchDesc], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource KoyTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Kart 2: Yalnız dock -->
                        <Border Grid.Column="4" Height="248" CornerRadius="14" Background="{DynamicResource KoyBgRow}" Cursor="Hand" MouseLeftButtonDown="Card2_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLayoutIndex}" Value="2">
                                            <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource KoyBorderHairline}" CornerRadius="12,12,0,0">
                                    <Grid>
                                        <!-- Mini Dock -->
                                        <Border Width="120" Height="18" Background="{DynamicResource KoyBgWindow}" CornerRadius="7"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12">
                                    <TextBlock Text="{Binding [WizDockTitle], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                                    <TextBlock Text="{Binding [WizDockDesc], Source={x:Static res:Loc.Instance}}"
                                               FontSize="12" Foreground="{DynamicResource KoyTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ADIM 3: Hava durumu için konum (Evet / Şimdi değil) -->
            <Grid Grid.Row="1" Margin="56,20,56,0" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [WizStep3], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding [WizLocationTitle], Source={x:Static res:Loc.Instance}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [WizLocationBody], Source={x:Static res:Loc.Instance}}"
                               FontSize="14" Foreground="{DynamicResource KoyTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,22" LineHeight="21" />

                    <!-- Evet -->
                    <Border CornerRadius="{DynamicResource KoyRadiusRow}" Background="{DynamicResource KoyBgRow}" Padding="20,16" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="LocationYes_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseLocation}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding [WizLocationYes], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                            <TextBlock Text="{Binding [WizLocationYesDesc], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Şimdi değil -->
                    <Border CornerRadius="{DynamicResource KoyRadiusRow}" Background="{DynamicResource KoyBgRow}" Padding="20,16" Cursor="Hand" MouseLeftButtonDown="LocationNo_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseLocation}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding [WizLocationNo], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                            <TextBlock Text="{Binding [WizLocationNoDesc], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [WizLocating], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,14,0,0"
                               Visibility="{Binding IsLocating, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <!-- ADIM 4: Başlangıç ve İzinler / Tamamlandı -->
            <Grid Grid.Row="1" Margin="56,20,56,0" Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [WizStep4], Source={x:Static res:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding [WizDoneTitle], Source={x:Static res:Loc.Instance}}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding [WizDoneBody], Source={x:Static res:Loc.Instance}}"
                               FontSize="15" Foreground="{DynamicResource KoyTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,28" LineHeight="22" />

                    <!-- Başlangıç Seçeneği -->
                    <Border Background="{DynamicResource KoyBgRow}" CornerRadius="{DynamicResource KoyRadiusRow}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizStartupTitle], Source={x:Static res:Loc.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" />
                                <TextBlock Text="{Binding [WizStartupDesc], Source={x:Static res:Loc.Instance}}"
                                           FontSize="13" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding RunAtStartup}"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Alt Gezinme Çubuğu (76 px) -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource KoyBorderShell}" Padding="56,0">
                <Grid VerticalAlignment="Center">
                    <!-- Sol: 3 Hap Noktası -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Nokta 1 -->
                        <Border x:Name="dot1" CornerRadius="4" Height="8" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="{DynamicResource KoyBorderControl}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Nokta 2 -->
                        <Border x:Name="dot2" CornerRadius="4" Height="8" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="{DynamicResource KoyBorderControl}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Nokta 3 -->
                        <Border x:Name="dot3" CornerRadius="4" Height="8" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="{DynamicResource KoyBorderControl}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Nokta 4 -->
                        <Border x:Name="dot4" CornerRadius="4" Height="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Background" Value="{DynamicResource KoyBorderControl}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>

                    <!-- Sağ: Geri ve Devam Düğmeleri -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding [WizBack], Source={x:Static res:Loc.Instance}}"
                                Style="{StaticResource WizardNavButton}"
                                Command="{Binding BackCommand}"
                                Margin="0,0,10,0"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{Binding NextButtonText}"
                                Style="{StaticResource WizardPrimaryButton}"
                                Command="{Binding NextCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
