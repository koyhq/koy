<UserControl x:Class="Koy.App.Features.ControlCenter.ControlCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.ControlCenter"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:radio="clr-namespace:Koy.Core.Radio;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ControlCenterViewModel}"
             Foreground="{DynamicResource KoyNotchText}"
             FontSize="12">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Döşeme Düğmesi Stili (Tile Button) -->
    <Style x:Key="TileButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource KoyNotchControlTile}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TileBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="18"
                    Padding="10,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TileBorder" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Açık radyo döşemesi sayfa renginde (mavi) dolar; Content bir RadioTileViewModel iken geçerli -->
        <DataTrigger Binding="{Binding Content.IsOn, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource KoyNotchAccentControl}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Bölünmüş döşemenin sağ bölümü: küçük ok. Hover'da hafif parlar, basınca vurgulanır; basınca Wi-Fi / Bluetooth listesi açılır.
         Zemin döşemeyle aynı (açıkken mavi); Tag döşemenin açık olup olmadığını taşır. -->
    <Style x:Key="TileChevronStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource KoyNotchControlTile}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Zone" Background="{TemplateBinding Background}" CornerRadius="0,18,18,0">
              <Grid>
                <Rectangle x:Name="Divider" Width="1" Height="30" HorizontalAlignment="Left" Fill="#26FFFFFF" />
                <Border x:Name="Glow" Background="Transparent" CornerRadius="0,18,18,0" />
                <res:KoyIcon x:Name="Chevron" Data="{DynamicResource IconChevronRight}" Size="14" StrokeWidth="2.6"
                             Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="Divider" Property="Fill" Value="#26000000" />
                <Setter TargetName="Chevron" Property="Foreground" Value="#B30A0A0B" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Background" Value="#26FFFFFF" />
                <Setter TargetName="Chevron" Property="Foreground" Value="#FFFFFFFF" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Glow" Property="Background" Value="#1F000000" />
                <Setter TargetName="Chevron" Property="Foreground" Value="#FF0A0A0B" />
              </MultiDataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Glow" Property="Background" Value="#47FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource KoyNotchAccentControl}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Bölünmüş döşemenin sol bölümü: aç/kapa. Köşeler yalnız solda yuvarlak; hover yalnız bu bölümü soldurur. -->
    <Style x:Key="TileMainStyle" TargetType="Button" BasedOn="{StaticResource TileButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TileBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="18,0,0,18"
                    Padding="8,0,2,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TileBorder" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TileBorder" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Wi-Fi / Bluetooth döşemesinin içeriği: simge, ad ve durum (Açık, Kapalı, Bulunamadı, İzin yok...) -->
    <DataTemplate x:Key="RadioTileTemplate" DataType="{x:Type local:RadioTileViewModel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBorder" Width="26" Height="26" CornerRadius="9" VerticalAlignment="Center" Background="#20FFFFFF">
          <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform"
                Stroke="#FFFFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
          <TextBlock x:Name="Title" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchText}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static radio:RadioKind.WiFi}">
          <Setter TargetName="Title" Property="Text" Value="{x:Static res:Strings.WiFi}" />
          <Setter TargetName="Icon" Property="Data" Value="M 12,18 A 1.5,1.5 0 1 1 12,15 A 1.5,1.5 0 0 1 12,18 M 7.05,12.05 A 7,7 0 0 1 16.95,12.05 M 3.5,8.5 A 12,12 0 0 1 20.5,8.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static radio:RadioKind.Bluetooth}">
          <Setter TargetName="Title" Property="Text" Value="{x:Static res:Strings.Bluetooth}" />
          <Setter TargetName="Icon" Property="Width" Value="9" />
          <Setter TargetName="Icon" Property="Height" Value="14" />
          <Setter TargetName="Icon" Property="StrokeThickness" Value="1.5" />
          <Setter TargetName="Icon" Property="StrokeLineJoin" Value="Round" />
          <Setter TargetName="Icon" Property="Data" Value="{DynamicResource IconBluetooth}" />
        </DataTrigger>
        <!-- Açık: mavi zeminde koyu yazı (tasarımdaki gibi) -->
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter TargetName="IconBorder" Property="Background" Value="#26000000" />
          <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource KoyNotchSurface}" />
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource KoyNotchSurface}" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyNotchSurface}" />
        </DataTrigger>
        <!-- Değiştirilemeyen radyo soluk görünür; durum satırı nedenini sarıyla yazar -->
        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
          <Setter TargetName="IconBorder" Property="Opacity" Value="0.5" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource KoyStatusWarn}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kaydırıcı (Slider) Modern Minimal Stili -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Height="22">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="4,0,0,4" Height="8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{DynamicResource KoyNotchControlTrack}" CornerRadius="0,4,4,0" Height="8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource KoyNotchText}" Stroke="#33000000" StrokeThickness="1" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
   <!-- Ana görünüm: döşemeler + kaydırıcılar, sağda "Bağlı cihazlar" -->
   <Grid x:Name="MainView" Visibility="{Binding IsMainPage, Converter={StaticResource BoolToVis}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Üst satır: Wi-Fi, Bluetooth, Rahatsız Etme. Döşemeler sürüklenerek yeniden sıralanır (sıra ControlCenterLayout'a
         yazılır); konumları kod arkasında yayla kayar. -->
    <Grid Grid.Row="0" x:Name="TilesHost" Height="62" Background="Transparent"
          SizeChanged="TilesHost_SizeChanged"
          PreviewMouseLeftButtonDown="TilesHost_PreviewMouseLeftButtonDown"
          PreviewMouseMove="TilesHost_PreviewMouseMove"
          PreviewMouseLeftButtonUp="TilesHost_PreviewMouseLeftButtonUp"
          LostMouseCapture="TilesHost_LostMouseCapture">

      <!-- Wi-Fi: sol bölüm açar/kapatır; sağdaki ok, Wi-Fi listesini çentik içinde açar -->
      <Grid x:Name="TileWifi" Tag="wifi" HorizontalAlignment="Left" VerticalAlignment="Top" Height="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource TileMainStyle}"
                CommandParameter="{x:Static radio:RadioKind.WiFi}"
                Command="{Binding ActivateRadioCommand}"
                ToolTip="{Binding WiFi.ToolTip}"
                Content="{Binding WiFi}"
                ContentTemplate="{StaticResource RadioTileTemplate}" />
        <Button Grid.Column="1" Style="{StaticResource TileChevronStyle}"
                Tag="{Binding WiFi.IsOn}"
                CommandParameter="{x:Static radio:RadioKind.WiFi}"
                Command="{Binding OpenPageCommand}"
                ToolTip="{x:Static res:Strings.ControlOpenWifiList}"
                AutomationProperties.Name="{x:Static res:Strings.ControlOpenWifiList}" />
      </Grid>

      <!-- Bluetooth: sol bölüm açar/kapatır; sağdaki ok, Bluetooth cihaz listesini çentik içinde açar -->
      <Grid x:Name="TileBluetooth" Tag="bluetooth" HorizontalAlignment="Left" VerticalAlignment="Top" Height="62">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource TileMainStyle}"
                CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                Command="{Binding ActivateRadioCommand}"
                ToolTip="{Binding Bluetooth.ToolTip}"
                Content="{Binding Bluetooth}"
                ContentTemplate="{StaticResource RadioTileTemplate}" />
        <Button Grid.Column="1" Style="{StaticResource TileChevronStyle}"
                Tag="{Binding Bluetooth.IsOn}"
                CommandParameter="{x:Static radio:RadioKind.Bluetooth}"
                Command="{Binding OpenPageCommand}"
                ToolTip="{x:Static res:Strings.ControlOpenBluetoothList}"
                AutomationProperties.Name="{x:Static res:Strings.ControlOpenBluetoothList}" />
      </Grid>

      <!-- Rahatsız Etme: kodla açma/kapama yok; basınca Windows ayarı açılır. Alt satır durumu gösterir (sekme açılınca okunur). -->
      <Button x:Name="TileDoNotDisturb" Tag="donotdisturb" HorizontalAlignment="Left" VerticalAlignment="Top"
              Style="{StaticResource TileButtonStyle}" Height="62"
              Command="{Binding OpenDoNotDisturbSettingsCommand}"
              ToolTip="{x:Static res:Strings.OpenInSettings}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="26" Height="26" CornerRadius="9" VerticalAlignment="Center" Background="#20FFFFFF">
            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource KoyNotchText}"
                  Data="M 12 3 A 9 9 0 1 0 21 12 A 7 7 0 0 1 12 3 Z"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
            <TextBlock Text="{x:Static res:Strings.DoNotDisturb}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DoNotDisturbStatus}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>
    </Grid>

    <!-- Ses ve parlaklık -->
    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="18" Background="{DynamicResource KoyNotchControlCard}" Padding="14,12">
      <StackPanel VerticalAlignment="Center">
        <!-- Ses: etikete tıklamak sessize alır / açar -->
        <Grid Height="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"
                  FocusVisualStyle="{x:Null}" ToolTip="{Binding [ControlVolume], Source={x:Static res:Loc.Instance}}" AutomationProperties.Name="{Binding [ControlVolume], Source={x:Static res:Loc.Instance}}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                  <Grid Width="14" Height="14" Margin="0,0,8,0">
                    <Path Stretch="Uniform" Fill="{DynamicResource KoyNotchControlSoft}"
                          Data="M 3,6 L 6,6 L 11,2 L 11,16 L 6,12 L 3,12 Z M 13,5 A 5,5 0 0 1 13,13 M 15,3 A 8,8 0 0 1 15,15">
                      <Path.Style>
                        <Style TargetType="Path">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <Path Stretch="Uniform" Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.2"
                          Data="M 3,6 L 6,6 L 11,2 L 11,16 L 6,12 L 3,12 Z M 14,7 L 18,11 M 18,7 L 14,11">
                      <Path.Style>
                        <Style TargetType="Path">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </Grid>
                  <TextBlock Text="{Binding [ControlVolume], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyNotchControlSoft}" VerticalAlignment="Center" />
                </StackPanel>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ModernSliderStyle}"
                  Foreground="{DynamicResource KoyNotchText}"
                  Minimum="0" Maximum="100"
                  Value="{Binding VolumePercent, Mode=OneWay}"
                  ValueChanged="VolumeSlider_ValueChanged"
                  Margin="6,0" />
          <TextBlock Grid.Column="2" Text="{Binding VolumePercent, Converter={x:Static res:PercentTextConverter.Instance}}"
                     FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Parlaklık: kaynak belirlendikten sonra görünür; yol yoksa kaydırıcı devre dışı ve nedeni yazılı -->
        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsBrightnessResolved, Converter={StaticResource BoolToVis}}">
        <Grid Height="30" IsEnabled="{Binding IsBrightnessSupported}">
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <res:KoyIcon Data="{DynamicResource IconSun}" Size="14" Foreground="{DynamicResource KoyNotchBrightness}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding [ControlBrightness], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyNotchControlSoft}" VerticalAlignment="Center" />
          </StackPanel>
          <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource ModernSliderStyle}"
                  Foreground="{DynamicResource KoyNotchBrightness}"
                  Minimum="0" Maximum="100"
                  Value="{Binding Brightness, Mode=OneWay}"
                  ValueChanged="BrightnessSlider_ValueChanged"
                  Margin="6,0" />
          <TextBlock Grid.Column="2" Text="{Binding Brightness, Converter={x:Static res:PercentTextConverter.Instance}}"
                     FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Text="{Binding [BrightnessUnavailable], Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" Margin="0,2,0,0" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBrightnessSupported}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>
    </Grid>

    <!-- Bağlı cihazlar (tasarımdaki sağ sütun): ad + pil. Yalnız Bluetooth radyosu varsa görünür. -->
    <Border Grid.Column="1" Width="156" Margin="8,0,0,0" CornerRadius="18" Background="{DynamicResource KoyNotchCard}" Padding="12"
            Visibility="{Binding ShowConnectedCard, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static res:Strings.BluetoothConnectedDevices}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" />
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding BluetoothDevices.Connected}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:BluetoothDeviceRowViewModel}">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontSize="12" Foreground="{DynamicResource KoyNotchControlBattery}" Margin="8,0,0,0"
                             Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource KoyNotchDim}"
                   Text="{Binding ConnectedEmptyText}"
                   Visibility="{Binding ShowConnectedEmpty, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </Border>
   </Grid>

   <!-- Liste sayfaları: sekme çubuğu kalır, bu alan değişir -->
   <local:WifiListPage Visibility="{Binding IsWifiPage, Converter={StaticResource BoolToVis}}" />
   <local:BluetoothListPage Visibility="{Binding IsBluetoothPage, Converter={StaticResource BoolToVis}}" />
  </Grid>
</UserControl>
