<Window x:Class="Koy.App.Features.Settings.KoyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Settings"
        xmlns:pages="clr-namespace:Koy.App.Features.Settings.Pages"
        xmlns:res="clr-namespace:Koy.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:KoyWindowViewModel}"
        Title="Koy"
        Width="880"
        Height="680"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="{DynamicResource KoyFont}"
        Foreground="{DynamicResource KoyTextPrimary}"
        TextOptions.TextFormattingMode="Display">

    <!-- Ana pencere kabuğu: 880 px, köşe yarıçapı ve yüzeyler token'dan gelir -->
    <Border Background="{DynamicResource KoyBgWindow}"
            BorderBrush="{DynamicResource KoyBorderHairline}"
            BorderThickness="1"
            CornerRadius="{DynamicResource KoyRadiusWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Border Grid.Row="0"
                    Background="{DynamicResource KoyBgShell}"
                    BorderBrush="{DynamicResource KoyBorderShell}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,6,0"
                    CornerRadius="{DynamicResource KoyRadiusWindowTop}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Text="Koy" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleButtonStyle}" Tag="{StaticResource IconMinus}" Click="Minimize_Click"
                                ToolTip="{Binding [WindowMinimize], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [WindowMinimize], Source={x:Static res:Loc.Instance}}" />
                        <Button Style="{StaticResource TitleButtonStyle}" Tag="{StaticResource IconX}" Click="Close_Click"
                                ToolTip="{Binding [WindowHideTip], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [WindowHide], Source={x:Static res:Loc.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Kenar çubuğu -->
                <Border Grid.Column="0"
                        Background="{DynamicResource KoyBgShell}"
                        Padding="10,12"
                        BorderBrush="{DynamicResource KoyBorderShell}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="{DynamicResource KoyRadiusWindowBottomLeft}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconSettings}" Click="NavGenel_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                                         Content="{Binding [NavGeneral], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconPanelTop}" Click="NavCentik_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                                         Content="{Binding [NavNotch], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconPanelBottom}" Click="NavDock_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=2}"
                                         Content="{Binding [NavDock], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconMonitor}" Click="NavEkranlar_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=3}"
                                         Content="{Binding [NavDisplays], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconPalette}" Click="NavGorunum_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=4}"
                                         Content="{Binding [NavAppearance], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconKeyboard}" Click="NavKisayollar_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=5}"
                                         Content="{Binding [NavShortcuts], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconMic}" Click="NavDikte_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=6}"
                                         Content="{Binding [NavDictation], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconActivity}" Click="NavPerformans_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=7}"
                                         Content="{Binding [NavPerformance], Source={x:Static res:Loc.Instance}}" />
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconInfo}" Click="NavHakkinda_Click"
                                         IsChecked="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=8}"
                                         Content="{Binding [NavAbout], Source={x:Static res:Loc.Instance}}" />
                        </StackPanel>

                        <!-- Alt eylemler: Güncelleme bildirimi ve Koy'dan çık -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <Button Height="34" Margin="0,0,0,8"
                                    Command="{Binding OpenUpdateOverlayCommand}"
                                    AutomationProperties.Name="{Binding AvailableVersionText}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvailableUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <res:KoyIcon Data="{StaticResource IconDownload}" Size="16" StrokeWidth="2" Foreground="{DynamicResource KoyOnAccent}" />
                                    <TextBlock Text="{Binding AvailableVersionText}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource KoyOnAccent}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerButtonStyle}" Height="34"
                                    Command="{Binding ExitAppCommand}"
                                    AutomationProperties.Name="{Binding [ExitKoy], Source={x:Static res:Loc.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <res:KoyIcon Data="{StaticResource IconPower}" Size="16" StrokeWidth="2" />
                                    <TextBlock Text="{Binding [ExitKoy], Source={x:Static res:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sağ içerik alanı -->
                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Column="1"
                              Padding="28,24,24,24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="PagesHost">
                        <pages:GenelPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=0}" />
                        <pages:CentikPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=1}" />
                        <pages:DockPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=2}" />
                        <pages:EkranlarPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=3}" />
                        <pages:GorunumPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=4}" />
                        <pages:KisayollarPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=5}" />
                        <pages:DiktePage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=6}" />
                        <pages:PerformansPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=7}" />
                        <pages:HakkindaPage Visibility="{Binding SelectedPageIndex, Converter={x:Static local:PageIndexToVisibilityConverter.Instance}, ConverterParameter=8}" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Kaldırma onayı: pencerenin üstünde, Koy tarzında kart -->
            <Grid x:Name="UninstallOverlay" Grid.RowSpan="2" Focusable="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUninstallConfirming}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource KoyScrim}" CornerRadius="{DynamicResource KoyRadiusWindow}" />
                <Border x:Name="UninstallCard" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource KoyBgRow}" BorderBrush="{DynamicResource KoyBorderStrong}" BorderThickness="1"
                        CornerRadius="{DynamicResource KoyRadiusRow}" Padding="24"
                        AutomationProperties.Name="{Binding [UninstallDialogTitle], Source={x:Static res:Loc.Instance}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <res:KoyIcon Data="{StaticResource IconTriangleAlert}" Size="20" StrokeWidth="2" Foreground="{DynamicResource KoyDangerText}" />
                            <TextBlock Text="{Binding [UninstallDialogTitle], Source={x:Static res:Loc.Instance}}" FontSize="{DynamicResource KoyFontPageTitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource KoyTextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding [UninstallDialogIntro], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,14,0,6" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <res:KoyIcon Data="{StaticResource IconCheck}" Size="14" StrokeWidth="2.5" Foreground="{DynamicResource KoyStatusOk}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Text="{Binding [UninstallItemApp], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" FontWeight="Normal" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <res:KoyIcon Data="{StaticResource IconCheck}" Size="14" StrokeWidth="2.5" Foreground="{DynamicResource KoyStatusOk}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Text="{Binding [UninstallItemTaskbar], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" FontWeight="Normal" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Ayarlarımı sakla -->
                        <Border Background="{DynamicResource KoyBgWindow}" BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1"
                                CornerRadius="{DynamicResource KoyRadiusRow}" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Kutu şablonu içerik göstermez; metin yanında, tıklanınca kutuyu çevirir -->
                                <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="KeepSettingsLabel_Click">
                                    <CheckBox IsChecked="{Binding KeepSettingsOnUninstall, Mode=TwoWay}" Style="{StaticResource ModernCheckBoxStyle}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              AutomationProperties.Name="{Binding [UninstallKeepSettings], Source={x:Static res:Loc.Instance}}" />
                                    <StackPanel Margin="30,0,0,0">
                                        <TextBlock Text="{Binding [UninstallKeepSettings], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [UninstallKeepSettingsDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding [UninstallDeleteWarn], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyDangerText}"
                                           FontSize="{DynamicResource KoyFontCaption}" TextWrapping="Wrap" Margin="30,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KeepSettingsOnUninstall}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding UninstallError}" Foreground="{DynamicResource KoyDangerText}" FontSize="{DynamicResource KoyFontCaption}"
                                   TextWrapping="Wrap" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UninstallError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="UninstallCancelButton" Content="{Binding [Cancel], Source={x:Static res:Loc.Instance}}" Command="{Binding CancelUninstallCommand}"
                                    Style="{StaticResource SettingButtonStyle}" IsCancel="True" Margin="0,0,8,0" />
                            <Button Content="{Binding [UninstallConfirm], Source={x:Static res:Loc.Instance}}" Command="{Binding ConfirmUninstallCommand}"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Güncelleme onayı: pencerenin üstünde, Koy tarzında kart -->
            <Grid x:Name="UpdateOverlay" Grid.RowSpan="2" Focusable="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdateOverlayOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource KoyScrim}" CornerRadius="{DynamicResource KoyRadiusWindow}" />
                <Border x:Name="UpdateCard" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource KoyBgRow}" BorderBrush="{DynamicResource KoyBorderStrong}" BorderThickness="1"
                        CornerRadius="{DynamicResource KoyRadiusRow}" Padding="24"
                        AutomationProperties.Name="{Binding UpdateModalTitleText}">
                    <StackPanel>
                        <!-- Başlık -->
                        <StackPanel Orientation="Horizontal">
                            <res:KoyIcon Data="{StaticResource IconDownload}" Size="20" StrokeWidth="2" Foreground="{DynamicResource KoyAccent}" />
                            <TextBlock Text="{Binding UpdateModalTitleText}" FontSize="{DynamicResource KoyFontPageTitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource KoyTextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Açıklama -->
                        <TextBlock Text="{Binding UpdateModalIntroText}" Style="{StaticResource SettingDescStyle}" Margin="0,14,0,10" TextWrapping="Wrap" />

                        <!-- Öne çıkanlar -->
                        <Border Background="{DynamicResource KoyBgWindow}" BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1"
                                CornerRadius="{DynamicResource KoyRadiusRow}" Padding="14,12" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateHighlights.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding [UpdateModalHighlights], Source={x:Static res:Loc.Instance}}"
                                           Style="{StaticResource SettingTitleStyle}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding UpdateHighlights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <res:KoyIcon Grid.Column="0" Data="{StaticResource IconCheck}" Size="14" StrokeWidth="2.5" Foreground="{DynamicResource KoyStatusOk}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource SettingTitleStyle}" FontWeight="Normal" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- İndirme İlerlemesi -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding DownloadProgressText}" Style="{StaticResource SettingTitleStyle}" Margin="0,0,0,8" />
                            <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="6"
                                         Foreground="{DynamicResource KoyAccent}" Background="{DynamicResource KoyBgControl}" BorderThickness="0" />
                        </StackPanel>

                        <!-- Düğmeler -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{Binding [UpdateLater], Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding CloseUpdateOverlayCommand}"
                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                    Style="{StaticResource SettingButtonStyle}" IsCancel="True" Margin="0,0,8,0" />
                            <Button Content="{Binding [UpdateNow], Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding StartUpdateCommand}"
                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Neler Geldi ("What's New") katmanı -->
            <Grid x:Name="WhatsNewOverlay" Grid.RowSpan="2" Focusable="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWhatsNewOverlayOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource KoyScrim}" CornerRadius="{DynamicResource KoyRadiusWindow}" />
                <Border x:Name="WhatsNewCard" Width="500" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource KoyBgRow}" BorderBrush="{DynamicResource KoyBorderStrong}" BorderThickness="1"
                        CornerRadius="{DynamicResource KoyRadiusRow}" Padding="24"
                        AutomationProperties.Name="{Binding WhatsNewTitleText}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <res:KoyIcon Data="{StaticResource IconInfo}" Size="20" StrokeWidth="2" Foreground="{DynamicResource KoyAccent}" />
                            <TextBlock Text="{Binding WhatsNewTitleText}" FontSize="{DynamicResource KoyFontPageTitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource KoyTextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Giriş -->
                        <TextBlock Grid.Row="1" Text="{Binding [WhatsNewIntro], Source={x:Static res:Loc.Instance}}"
                                   Style="{StaticResource SettingDescStyle}" Margin="0,12,0,12" />

                        <!-- Notlar listesi (kaydırılabilir) -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Öne çıkanlar -->
                                <Border Background="{DynamicResource KoyBgWindow}" BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1"
                                        CornerRadius="{DynamicResource KoyRadiusRow}" Padding="14,12" Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WhatsNewHighlights.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [UpdateModalHighlights], Source={x:Static res:Loc.Instance}}"
                                                   Style="{StaticResource SettingTitleStyle}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding WhatsNewHighlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <res:KoyIcon Grid.Column="0" Data="{StaticResource IconCheck}" Size="14" StrokeWidth="2.5" Foreground="{DynamicResource KoyStatusOk}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource SettingTitleStyle}" FontWeight="Normal" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Alt kategoriler -->
                                <ItemsControl ItemsSource="{Binding WhatsNewSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource KoyBgWindow}" BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource KoyRadiusRow}" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingTitleStyle}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" Margin="0,2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bitti butonu -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding [WhatsNewDone], Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding CloseWhatsNewOverlayCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="90" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
