<UserControl x:Class="Koy.App.Features.Settings.Pages.PerformansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:weather="clr-namespace:Koy.Core.Weather;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <UserControl.Resources>
        <!-- Bellek çubuğu: bütçe içinde vurgu, %80'den sonra uyarı, aşımda tehlike rengi -->
        <Style x:Key="MemoryBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource KoyAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource KoyBorderStrong}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MemoryLevel}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource KoyStatusWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MemoryLevel}" Value="2">
                    <Setter Property="Foreground" Value="{DynamicResource KoyDangerText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavPerformance], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [PerformanceSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,16" />

        <!-- Bellek Durumu -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [MemoryUsageTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [BudgetDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="220">
                    <TextBlock Text="{Binding MemoryUsageText}" HorizontalAlignment="Right" Foreground="{DynamicResource KoyTextSecondary}" FontSize="13" Margin="0,0,0,6" />
                    <ProgressBar Value="{Binding MemoryPct}" Maximum="100" Height="6" Style="{StaticResource MemoryBarStyle}"
                                 AutomationProperties.Name="{Binding [MemoryUsageTitle], Source={x:Static res:Loc.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- PİL -->
        <TextBlock Text="{Binding [BatteryHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [BatteryReduceMotion], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [BatteryReduceMotion], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding BatterySaverReduceMotion}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- VERİ -->
        <TextBlock Text="{Binding [DataHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [WeatherRefreshTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [WeatherRefreshTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="180" SelectedValuePath="Tag"
                          SelectedValue="{Binding WeatherRefreshInterval}" Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [Interval30m], Source={x:Static res:Loc.Instance}}" Tag="{x:Static weather:WeatherRefreshInterval.Every30Minutes}" />
                    <ComboBoxItem Content="{Binding [Interval1h], Source={x:Static res:Loc.Instance}}" Tag="{x:Static weather:WeatherRefreshInterval.Hourly}" />
                    <ComboBoxItem Content="{Binding [IntervalStartupOnly], Source={x:Static res:Loc.Instance}}" Tag="{x:Static weather:WeatherRefreshInterval.OnStartup}" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <res:KoyIcon Data="{StaticResource IconInfo}" Size="16" Foreground="{DynamicResource KoyFgInfo}" Margin="0,1,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [IdleNotice], Source={x:Static res:Loc.Instance}}"
                           Grid.Column="1" Foreground="{DynamicResource KoyFgInfo}" FontSize="12.5" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
