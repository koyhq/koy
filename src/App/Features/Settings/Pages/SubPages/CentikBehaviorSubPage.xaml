<UserControl x:Class="Koy.App.Features.Settings.Pages.SubPages.CentikBehaviorSubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <!-- GÖRÜNÜRLÜK -->
        <TextBlock Text="{Binding [NotchHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [VisibilityTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [VisibilityDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [VisFixed], Source={x:Static res:Loc.Instance}}" GroupName="NotchVis"
                                     IsChecked="{Binding NotchVisibility, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Fixed}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [VisSmart], Source={x:Static res:Loc.Instance}}" GroupName="NotchVis"
                                     IsChecked="{Binding NotchVisibility, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Smart}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [VisPeek], Source={x:Static res:Loc.Instance}}" GroupName="NotchVis"
                                     IsChecked="{Binding NotchVisibility, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Peek}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchStyleTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [NotchStylePinned], Source={x:Static res:Loc.Instance}}" GroupName="NotchStyle"
                                     IsChecked="{Binding NotchStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Pinned}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NotchStyleFloating], Source={x:Static res:Loc.Instance}}" GroupName="NotchStyle"
                                     IsChecked="{Binding NotchStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Floating}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HideInFullscreenTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [HideInFullscreenTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchHideInFullscreen}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- DAVRANIŞ -->
        <TextBlock Text="{Binding [OpenBehaviorTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [OpenBehaviorRowTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [OpenOnHover], Source={x:Static res:Loc.Instance}}" GroupName="OpenBeh"
                                     IsChecked="{Binding NotchOpenBehavior, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Hover}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [OpenOnClick], Source={x:Static res:Loc.Instance}}" GroupName="OpenBeh"
                                     IsChecked="{Binding NotchOpenBehavior, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Click}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [OpenOnDragOver], Source={x:Static res:Loc.Instance}}" GroupName="OpenBeh"
                                     IsChecked="{Binding NotchOpenBehavior, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=DragOver}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BOŞTAYKEN -->
        <TextBlock Text="{Binding [IdleDisplayTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [IdleDisplayRowTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [IdleClockBattery], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ClockAndBattery}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IdleClockOnly], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ClockOnly}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IdleRingClockDay], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     ToolTip="{Binding [IdleRingClockDayDesc], Source={x:Static res:Loc.Instance}}"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=RingClockDay}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IdleNone], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Nothing}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- GÖSTERGELER -->
        <TextBlock Text="{Binding [IndicatorsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [VolumeOsdTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [VolumeOsdTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ShowVolumeOsd}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [BrightnessOsdTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [BrightnessOsdTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ShowBrightnessOsd}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PrivacyIndicatorTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [PrivacyIndicatorTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ShowPrivacyIndicator}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotificationsTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [NotificationsDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                    <TextBlock Text="{Binding [NotificationsNeedPermission], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}"
                               Foreground="{DynamicResource KoyAccent}"
                               Visibility="{Binding NotificationsPermissionMissing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [NotificationsTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchShowNotifications}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- İNCE AYAR (gecikmeler ve bildirim ayrıntısı) -->
        <TextBlock Text="{Binding [NavAdvanced], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}" MinHeight="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchOpenDelayTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="100" Height="32" HorizontalAlignment="Right" Style="{StaticResource SettingComboBoxStyle}"
                          AutomationProperties.Name="{Binding [NotchOpenDelayTitle], Source={x:Static res:Loc.Instance}}"
                          ItemsSource="{Binding NotchDelayOptions}" SelectedItem="{Binding NotchOpenDelayMs}" ItemStringFormat="{}{0} ms" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" MinHeight="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchCloseDelayTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="100" Height="32" HorizontalAlignment="Right" Style="{StaticResource SettingComboBoxStyle}"
                          AutomationProperties.Name="{Binding [NotchCloseDelayTitle], Source={x:Static res:Loc.Instance}}"
                          ItemsSource="{Binding NotchDelayOptions}" SelectedItem="{Binding NotchCloseDelayMs}" ItemStringFormat="{}{0} ms" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" MinHeight="44" IsEnabled="{Binding NotchShowNotifications}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotificationsHideBodyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [NotificationsHideBodyTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchNotificationsHideBody}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
