<UserControl x:Class="Koy.App.Features.Settings.Pages.SubPages.CentikPanelsSubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <!-- PANELLER -->
        <TextBlock Text="{Binding [PanelsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelFocusTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelFocusTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelFocus}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelShelfTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelShelfTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelShelf}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelControlCenterTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelControlCenterTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelControlCenter}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelCalendarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelCalendarTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelCalendar}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PanelClipboardTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [PanelClipboardDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [PanelClipboardTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelClipboard}" IsEnabled="{Binding ClipboardHistoryEnabled}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [ClipboardHistoryTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [ClipboardHistoryDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [ClipboardHistoryTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ClipboardHistoryEnabled}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelSystemTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelSystemTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelSystem}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- HAVA DURUMU: konum yoksa çentikte hava durumu hiç gösterilmez -->
        <TextBlock Text="{Binding [WeatherHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [WeatherUseLocationTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [WeatherUseLocationDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [WeatherUseLocationTitle], Source={x:Static res:Loc.Instance}}"
                          IsChecked="{Binding Weather.UseLocation}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Left" MaxWidth="440">
                    <TextBlock Text="{Binding [WeatherCityTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [WeatherCityDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SettingTextBoxStyle}" Text="{Binding Weather.Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding [WeatherSearchHint], Source={x:Static res:Loc.Instance}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding Weather.SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingButtonStyle}" Command="{Binding Weather.SearchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <res:KoyIcon Data="{StaticResource IconSearch}" Size="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [WeatherSearchButton], Source={x:Static res:Loc.Instance}}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding [WeatherSearching], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0"
                           Visibility="{Binding Weather.IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding [WeatherNoResults], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0"
                           Visibility="{Binding Weather.NoResults, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Weather.Results}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SettingButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                    Command="{Binding DataContext.Weather.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <res:KoyIcon Data="{StaticResource IconMapPin}" Size="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Weather.StatusText}" Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SettingButtonStyle}" Command="{Binding Weather.OpenLocationSettingsCommand}"
                            Visibility="{Binding Weather.ShowLocationSettingsLink, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [WeatherOpenLocationSettings], Source={x:Static res:Loc.Instance}}" />
                            <res:KoyIcon Data="{StaticResource IconExternalLink}" Size="14" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingButtonStyle}" Command="{Binding Weather.ClearLocationCommand}"
                        Visibility="{Binding Weather.HasLocation, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [WeatherClear], Source={x:Static res:Loc.Instance}}" />
                </Button>
            </Grid>
        </Border>

        <!-- TAKVİM HESAPLARI -->
        <TextBlock Text="{Binding [CalAccountsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [CalPrivacyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [CalPrivacyDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [CalGoogleTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding CalendarAccounts.GoogleStatusText}" Style="{StaticResource SettingDescStyle}" />
                    <TextBox Style="{StaticResource SettingTextBoxStyle}" Margin="0,8,0,0"
                             Visibility="{Binding CalendarAccounts.ShowGoogleClientFields, Converter={StaticResource BoolToVis}}"
                             Text="{Binding CalendarAccounts.GoogleClientId, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding [CalClientIdHint], Source={x:Static res:Loc.Instance}}"
                             AutomationProperties.Name="{Binding [CalGoogleClientId], Source={x:Static res:Loc.Instance}}" />
                    <TextBox Style="{StaticResource SettingTextBoxStyle}" Margin="0,6,0,0"
                             Visibility="{Binding CalendarAccounts.ShowGoogleClientFields, Converter={StaticResource BoolToVis}}"
                             Text="{Binding CalendarAccounts.GoogleClientSecret, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding [CalClientSecretHint], Source={x:Static res:Loc.Instance}}"
                             AutomationProperties.Name="{Binding [CalGoogleClientSecret], Source={x:Static res:Loc.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Command="{Binding CalendarAccounts.ConnectGoogleCommand}"
                            Content="{Binding [CalConnectButton], Source={x:Static res:Loc.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalendarAccounts.IsGoogleConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource SettingButtonStyle}" Command="{Binding CalendarAccounts.DisconnectGoogleCommand}"
                            Content="{Binding [CalDisconnectButton], Source={x:Static res:Loc.Instance}}"
                            Visibility="{Binding CalendarAccounts.IsGoogleConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [CalOutlookTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding CalendarAccounts.OutlookStatusText}" Style="{StaticResource SettingDescStyle}" />
                    <TextBox Style="{StaticResource SettingTextBoxStyle}" Margin="0,8,0,0"
                             Visibility="{Binding CalendarAccounts.IsOutlookAvailable, Converter={StaticResource BoolToVis}}"
                             Text="{Binding CalendarAccounts.OutlookClientId, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding [CalClientIdHint], Source={x:Static res:Loc.Instance}}"
                             AutomationProperties.Name="{Binding [CalOutlookClientId], Source={x:Static res:Loc.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            Visibility="{Binding CalendarAccounts.IsOutlookAvailable, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding CalendarAccounts.ConnectOutlookCommand}"
                            Content="{Binding [CalConnectButton], Source={x:Static res:Loc.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalendarAccounts.IsOutlookConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource SettingButtonStyle}" Command="{Binding CalendarAccounts.DisconnectOutlookCommand}"
                            Content="{Binding [CalDisconnectButton], Source={x:Static res:Loc.Instance}}"
                            Visibility="{Binding CalendarAccounts.IsOutlookConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CalendarAccounts.StatusMessage}" Style="{StaticResource SettingDescStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Style="{StaticResource SettingButtonStyle}" Command="{Binding CalendarAccounts.SyncNowCommand}"
                        Content="{Binding [CalSyncNowButton], Source={x:Static res:Loc.Instance}}" />
            </Grid>
        </Border>

        <!-- POMODORO -->
        <TextBlock Text="{Binding [PomodoroHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PomodoroWorkTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [PomodoroWorkTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding PomodoroWorkOptions}" SelectedItem="{Binding PomodoroWorkMinutes}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PomodoroShortBreakTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [PomodoroShortBreakTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding PomodoroShortBreakOptions}" SelectedItem="{Binding PomodoroShortBreakMinutes}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PomodoroLongBreakTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [PomodoroLongBreakTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding PomodoroLongBreakOptions}" SelectedItem="{Binding PomodoroLongBreakMinutes}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <!-- İNCE AYAR: sekme çubuğu biçimi, sekme sırası ve ana sayfa kartları -->
        <TextBlock Text="{Binding [NavAdvanced], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}" MinHeight="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchTabBarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [NotchTabBarDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [NotchTabBarIcon], Source={x:Static res:Loc.Instance}}" GroupName="TabBar"
                                     IsChecked="{Binding NotchTabBarStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=IconOnly}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NotchTabBarHidden], Source={x:Static res:Loc.Instance}}" GroupName="TabBar"
                                     IsChecked="{Binding NotchTabBarStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Hidden}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Text="{Binding [NotchTabOrderTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <ItemsControl ItemsSource="{Binding NotchTabOrder}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingRowStyle}" MinHeight="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="↑" Width="32" Margin="0,0,6,0" Style="{StaticResource SettingButtonStyle}"
                                    Command="{Binding DataContext.MoveTabUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Panel}"
                                    AutomationProperties.Name="{Binding [NotchTabMoveUp], Source={x:Static res:Loc.Instance}}" />
                            <Button Grid.Column="2" Content="↓" Width="32" Style="{StaticResource SettingButtonStyle}"
                                    Command="{Binding DataContext.MoveTabDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Panel}"
                                    AutomationProperties.Name="{Binding [NotchTabMoveDown], Source={x:Static res:Loc.Instance}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding [HomeCardSectionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <ItemsControl ItemsSource="{Binding HomeCardOrder}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingRowStyle}" MinHeight="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"
                                      AutomationProperties.Name="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
