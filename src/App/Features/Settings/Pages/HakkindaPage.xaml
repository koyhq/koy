<UserControl x:Class="Koy.App.Features.Settings.Pages.HakkindaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavAbout], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [AboutSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,16" />

        <!-- Kimlik kartı: sürüm ve lisans gerçek değerlerden -->
        <Border Style="{StaticResource SettingRowStyle}" Padding="16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="{DynamicResource KoyRadiusRow}" Background="{DynamicResource KoyBgWindow}"
                        BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1" Margin="0,0,16,0">
                    <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Koy" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource KoyTextPrimary}" />
                    <TextBlock Text="{Binding AboutStatusText}" FontSize="12.5" Foreground="{DynamicResource KoyTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- SORUN GİDERME -->
        <TextBlock Text="{Binding [TroubleshootingHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DiagnosticInfoTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{StaticResource IconCopy}" Size="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [CopyDiagnosticsAction], Source={x:Static res:Loc.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [RestoreTaskbarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [RestoreTaskbarDesc2], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RestoreTaskbarCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{StaticResource IconRotateCcw}" Size="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [RestoreButton], Source={x:Static res:Loc.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Ayarları sıfırla: iki adımlı onay -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="400">
                    <TextBlock Text="{Binding [ResetSettingsTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [ResetSettingsDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResetConfirming}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="{Binding [ResetButton], Source={x:Static res:Loc.Instance}}" Command="{Binding RequestResetCommand}" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResetConfirming}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="{Binding [Cancel], Source={x:Static res:Loc.Instance}}" Command="{Binding CancelResetCommand}" Style="{StaticResource SettingButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding [ResetConfirmButton], Source={x:Static res:Loc.Instance}}" Command="{Binding ResetSettingsCommand}" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- BAĞLANTILAR -->
        <TextBlock Text="{Binding [LinksHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <TextBlock Text="{Binding [SourceCodeTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <Button Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [OpenGitHubAction], Source={x:Static res:Loc.Instance}}" />
                        <res:KoyIcon Data="{StaticResource IconExternalLink}" Size="14" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [AboutSiteTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [AboutSiteDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenWebsiteCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [OpenWebsiteAction], Source={x:Static res:Loc.Instance}}" />
                        <res:KoyIcon Data="{StaticResource IconExternalLink}" Size="14" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Veri atfı: Open-Meteo CC BY 4.0 koşulu -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [AboutWeatherTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [AboutWeatherLicense], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenOpenMeteoCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [AboutWeatherLink], Source={x:Static res:Loc.Instance}}" />
                        <res:KoyIcon Data="{StaticResource IconExternalLink}" Size="14" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Veri atfı: cihaz konumunun yer adı OpenStreetMap Nominatim'den (ODbL koşulu) -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [AboutPlaceTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [AboutPlaceLicense], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding OpenOpenStreetMapCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [AboutPlaceLink], Source={x:Static res:Loc.Instance}}" />
                        <res:KoyIcon Data="{StaticResource IconExternalLink}" Size="14" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <!-- KALDIRMA: yalnız kurulu sürümde etkin -->
        <Border Style="{StaticResource SettingRowStyle}" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [UninstallTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding UninstallRowDescription}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RequestUninstallCommand}" HorizontalAlignment="Right" Style="{StaticResource DangerButtonStyle}"
                        AutomationProperties.Name="{Binding [UninstallAction], Source={x:Static res:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <res:KoyIcon Data="{StaticResource IconPower}" Size="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [UninstallAction], Source={x:Static res:Loc.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
