<UserControl x:Class="Koy.App.Features.Settings.Pages.GenelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <!-- Başlık -->
        <TextBlock Text="{Binding [General], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [GeneralSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <!-- BAŞLANGIÇ -->
        <TextBlock Text="{Binding [StartupHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [RunAtStartupTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [RunAtStartupTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding RunAtStartup}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HideWindowsTaskbarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [HideWindowsTaskbarDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [HideWindowsTaskbarTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding HideWindowsTaskbar}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- DİL -->
        <TextBlock Text="{Binding [LanguageHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [InterfaceLanguageTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [InterfaceLanguageTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="180" SelectedValuePath="Tag"
                          SelectedValue="{Binding Language}" Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="Türkçe (TR)" Tag="tr" />
                    <ComboBoxItem Content="English (EN)" Tag="en" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- BİRİMLER (issue #77). Rüzgâr hızı bugün hiçbir yerde gösterilmediği için satırı yok. -->
        <TextBlock Text="{Binding [UnitsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [UnitTemperatureTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [UnitCelsius], Source={x:Static res:Loc.Instance}}" GroupName="TemperatureUnit"
                                     IsChecked="{Binding TemperatureUnit, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Celsius}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [UnitFahrenheit], Source={x:Static res:Loc.Instance}}" GroupName="TemperatureUnit"
                                     IsChecked="{Binding TemperatureUnit, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Fahrenheit}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [UnitNetworkSpeedTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [UnitNetworkSpeedDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [UnitBytes], Source={x:Static res:Loc.Instance}}" GroupName="NetworkSpeedUnit"
                                     IsChecked="{Binding NetworkSpeedUnit, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Bytes}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [UnitBits], Source={x:Static res:Loc.Instance}}" GroupName="NetworkSpeedUnit"
                                     IsChecked="{Binding NetworkSpeedUnit, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Bits}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- GÜNCELLEMELER -->
        <TextBlock Text="{Binding [UpdatesHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [AutoCheckUpdatesTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [AutoCheckUpdatesTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding AutoCheckUpdates}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [ChannelTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [ChannelStable], Source={x:Static res:Loc.Instance}}" GroupName="UpdateChan"
                                     IsChecked="{Binding UpdateChannel, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Stable}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ChannelPreview], Source={x:Static res:Loc.Instance}}" GroupName="UpdateChan"
                                     IsChecked="{Binding UpdateChannel, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Preview}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LastCheckTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding CheckButtonText}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Right" Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>

        <!-- PROFİLLER: geçerli ayarlardan kaydet, uygula, içe/dışa aktar -->
        <TextBlock Text="{Binding [ProfilesHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [ProfilesSaveTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [ProfilesSaveDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" MaxLength="60"
                         Text="{Binding Profiles.NewName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding [ProfilesNameHint], Source={x:Static res:Loc.Instance}}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding Profiles.SaveCurrentCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ItemsControl ItemsSource="{Binding Profiles.Sections}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Label}" />
                                <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource KoyTextPrimary}" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{Binding [ProfilesSaveButton], Source={x:Static res:Loc.Instance}}" Command="{Binding Profiles.SaveCurrentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding [ProfilesExportCurrentButton], Source={x:Static res:Loc.Instance}}" Command="{Binding Profiles.ExportCurrentCommand}"
                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding [ProfilesImportButton], Source={x:Static res:Loc.Instance}}" Command="{Binding Profiles.ImportCommand}"
                            Style="{StaticResource SettingButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding Profiles.StatusText}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Profiles.HasStatus}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Profiles.StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource KoyDangerText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- İçe aktarma önizlemesi: onaylanmadan hiçbir şey kaydedilmez ya da uygulanmaz -->
        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SettingRowStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Profiles.HasPending}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding [ProfilesImportPreviewTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding Profiles.PendingName}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextPrimary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Profiles.PendingSectionsText}" Style="{StaticResource SettingDescStyle}" />
                <TextBlock Text="{Binding Profiles.PendingChangesText}" Style="{StaticResource SettingDescStyle}" />
                <TextBlock Text="{Binding [ProfilesImportMachineNote], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{Binding [ProfilesImportSave], Source={x:Static res:Loc.Instance}}" Command="{Binding Profiles.ConfirmImportSaveCommand}"
                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding [ProfilesImportApply], Source={x:Static res:Loc.Instance}}" Command="{Binding Profiles.ConfirmImportApplyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding [Cancel], Source={x:Static res:Loc.Instance}}" Command="{Binding Profiles.CancelImportCommand}"
                            Style="{StaticResource SettingButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Kayıtlı profiller -->
        <TextBlock Text="{Binding [ProfilesEmpty], Source={x:Static res:Loc.Instance}}" Margin="2,2,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Profiles.HasItems}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Profiles.Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingRowStyle}">
                        <StackPanel>
                            <!-- Normal görünüm -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDeleteConfirming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SettingTitleStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SectionsText}" Style="{StaticResource SettingDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding [ProfilesApply], Source={x:Static res:Loc.Instance}}" Command="{Binding ApplyCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="{Binding [ProfilesRename], Source={x:Static res:Loc.Instance}}" Command="{Binding BeginRenameCommand}"
                                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="{Binding [ProfilesDuplicate], Source={x:Static res:Loc.Instance}}" Command="{Binding DuplicateCommand}"
                                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="{Binding [ProfilesExport], Source={x:Static res:Loc.Instance}}" Command="{Binding ExportCommand}"
                                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="{Binding [ProfilesDelete], Source={x:Static res:Loc.Instance}}" Command="{Binding RequestDeleteCommand}"
                                            Style="{StaticResource SettingButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <!-- Yeniden adlandırma -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBox Style="{StaticResource SettingTextBoxStyle}" MaxLength="60" Margin="0,0,8,0"
                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{Binding [ProfilesNameHint], Source={x:Static res:Loc.Instance}}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding CommitRenameCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{Binding [Cancel], Source={x:Static res:Loc.Instance}}" Command="{Binding CancelRenameCommand}"
                                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="{Binding [ProfilesRenameConfirm], Source={x:Static res:Loc.Instance}}" Command="{Binding CommitRenameCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <!-- Silme onayı (iki adım) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleteConfirming}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{Binding [Cancel], Source={x:Static res:Loc.Instance}}" Command="{Binding CancelDeleteCommand}"
                                            Style="{StaticResource SettingButtonStyle}" Margin="0,0,6,0" />
                                    <Button Content="{Binding [ProfilesDeleteConfirm], Source={x:Static res:Loc.Instance}}" Command="{Binding ConfirmDeleteCommand}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- KURALLAR: ön plandaki uygulamaya göre profil (varsayılan kapalı) -->
        <TextBlock Text="{Binding [RulesHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [RulesAddTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [RulesAddDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" MaxLength="120"
                         Text="{Binding Rules.ProcessText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding [RulesProcessHint], Source={x:Static res:Loc.Instance}}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding Rules.AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Rules.RunningApps}" SelectedItem="{Binding Rules.PickedApp}"
                              Style="{StaticResource SettingComboBoxStyle}"
                              AutomationProperties.Name="{Binding [RulesPickRunning], Source={x:Static res:Loc.Instance}}" />
                    <Button Grid.Column="1" Content="{Binding [RulesRefreshRunning], Source={x:Static res:Loc.Instance}}"
                            Command="{Binding Rules.RefreshRunningAppsCommand}" Style="{StaticResource SettingButtonStyle}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding [RulesProfileLabel], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Rules.ProfileOptions}" SelectedItem="{Binding Rules.SelectedProfile}"
                          DisplayMemberPath="Name" Style="{StaticResource SettingComboBoxStyle}"
                          AutomationProperties.Name="{Binding [RulesProfileLabel], Source={x:Static res:Loc.Instance}}" />
                <Button Content="{Binding [RulesAddButton], Source={x:Static res:Loc.Instance}}" Command="{Binding Rules.AddCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Rules.StatusText}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rules.HasStatus}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rules.StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource KoyFgDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding [RulesEmpty], Source={x:Static res:Loc.Instance}}" Margin="2,2,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rules.HasItems}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Rules.Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SettingTitleStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProfileText}" Style="{StaticResource SettingDescStyle}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      AutomationProperties.Name="{Binding Title}" />
                            <Button Grid.Column="2" Content="{Binding [ProfilesDelete], Source={x:Static res:Loc.Instance}}" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource SettingButtonStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <res:KoyIcon Data="{StaticResource IconInfo}" Size="16" Foreground="{DynamicResource KoyFgInfo}" Margin="0,1,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [WindowCloseNotice], Source={x:Static res:Loc.Instance}}"
                           Grid.Column="1" Foreground="{DynamicResource KoyFgInfo}" FontSize="12.5" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
