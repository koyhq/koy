<UserControl x:Class="Koy.App.Features.Settings.Pages.GenelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:sub="clr-namespace:Koy.App.Features.Settings.Pages.SubPages"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <!-- Başlık -->
        <TextBlock Text="{Binding [General], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [GeneralSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <!-- Alt sekme çubuğu; "Yalnız değişenler" açıkken tüm alt sekmeler bir arada görünür. -->
        <Border Name="SubTabBar" HorizontalAlignment="Left" Margin="0,4,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SegmentContainerStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{Binding [SubTabGeneralSystem], Source={x:Static res:Loc.Instance}}" GroupName="GenelSubTabs"
                             IsChecked="{Binding GeneralSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabGeneralProfiles], Source={x:Static res:Loc.Instance}}" GroupName="GenelSubTabs"
                             IsChecked="{Binding GeneralSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabGeneralRules], Source={x:Static res:Loc.Instance}}" GroupName="GenelSubTabs"
                             IsChecked="{Binding GeneralSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=2}"
                             Style="{StaticResource SegRadioStyle}" />
            </StackPanel>
        </Border>

        <sub:GenelSystemSubPage x:Name="SubTab0">
            <sub:GenelSystemSubPage.Style>
                <Style TargetType="sub:GenelSystemSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GeneralSubTabIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:GenelSystemSubPage.Style>
        </sub:GenelSystemSubPage>

        <sub:GenelProfilesSubPage x:Name="SubTab1">
            <sub:GenelProfilesSubPage.Style>
                <Style TargetType="sub:GenelProfilesSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GeneralSubTabIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:GenelProfilesSubPage.Style>
        </sub:GenelProfilesSubPage>

        <sub:GenelRulesSubPage x:Name="SubTab2">
            <sub:GenelRulesSubPage.Style>
                <Style TargetType="sub:GenelRulesSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GeneralSubTabIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:GenelRulesSubPage.Style>
        </sub:GenelRulesSubPage>
    </StackPanel>
</UserControl>
