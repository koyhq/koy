<UserControl x:Class="Koy.App.Features.Settings.Pages.GorunumPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:sub="clr-namespace:Koy.App.Features.Settings.Pages.SubPages"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavAppearance], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [AppearanceSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" />

        <!-- Alt sekme çubuğu; "Yalnız değişenler" açıkken tüm alt sekmeler bir arada görünür. -->
        <Border Name="SubTabBar" HorizontalAlignment="Left" Margin="0,4,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SegmentContainerStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{Binding [SubTabAppearanceTheme], Source={x:Static res:Loc.Instance}}" GroupName="GorunumSubTabs"
                             IsChecked="{Binding AppearanceSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabAppearanceScaleMotion], Source={x:Static res:Loc.Instance}}" GroupName="GorunumSubTabs"
                             IsChecked="{Binding AppearanceSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                             Style="{StaticResource SegRadioStyle}" />
            </StackPanel>
        </Border>

        <sub:GorunumThemeSubPage x:Name="SubTab0">
            <sub:GorunumThemeSubPage.Style>
                <Style TargetType="sub:GorunumThemeSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppearanceSubTabIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:GorunumThemeSubPage.Style>
        </sub:GorunumThemeSubPage>

        <sub:GorunumScaleMotionSubPage x:Name="SubTab1">
            <sub:GorunumScaleMotionSubPage.Style>
                <Style TargetType="sub:GorunumScaleMotionSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppearanceSubTabIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:GorunumScaleMotionSubPage.Style>
        </sub:GorunumScaleMotionSubPage>
    </StackPanel>
</UserControl>
