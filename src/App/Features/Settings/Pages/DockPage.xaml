<UserControl x:Class="Koy.App.Features.Settings.Pages.DockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:sub="clr-namespace:Koy.App.Features.Settings.Pages.SubPages"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavDock], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [DockSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <!-- DOCK (ana anahtar her alt sekmede üstte kalır) -->
        <TextBlock Text="{Binding [DockGeneralHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockEnabledTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DockEnabledTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- Alt sekme çubuğu; "Yalnız değişenler" açıkken tüm alt sekmeler bir arada görünür. -->
        <Border Name="SubTabBar" HorizontalAlignment="Left" Margin="0,4,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SegmentContainerStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{Binding [SubTabDockBehavior], Source={x:Static res:Loc.Instance}}" GroupName="DockSubTabs"
                             IsChecked="{Binding DockSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabDockAppearance], Source={x:Static res:Loc.Instance}}" GroupName="DockSubTabs"
                             IsChecked="{Binding DockSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabDockSections], Source={x:Static res:Loc.Instance}}" GroupName="DockSubTabs"
                             IsChecked="{Binding DockSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=2}"
                             Style="{StaticResource SegRadioStyle}" />
            </StackPanel>
        </Border>

        <sub:DockBehaviorSubPage x:Name="SubTab0">
            <sub:DockBehaviorSubPage.Style>
                <Style TargetType="sub:DockBehaviorSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DockSubTabIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:DockBehaviorSubPage.Style>
        </sub:DockBehaviorSubPage>

        <sub:DockAppearanceSubPage x:Name="SubTab1">
            <sub:DockAppearanceSubPage.Style>
                <Style TargetType="sub:DockAppearanceSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DockSubTabIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:DockAppearanceSubPage.Style>
        </sub:DockAppearanceSubPage>

        <sub:DockSectionsSubPage x:Name="SubTab2">
            <sub:DockSectionsSubPage.Style>
                <Style TargetType="sub:DockSectionsSubPage">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DockSubTabIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:DockSectionsSubPage.Style>
        </sub:DockSectionsSubPage>
    </StackPanel>
</UserControl>
