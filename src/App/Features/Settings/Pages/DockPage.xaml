<UserControl x:Class="Koy.App.Features.Settings.Pages.DockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavDock], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [DockSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <!-- DOCK -->
        <TextBlock Text="{Binding [DockGeneralHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockEnabledTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DockEnabledTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockStyleTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [StyleCapsule], Source={x:Static res:Loc.Instance}}" GroupName="DockStyle"
                                     IsChecked="{Binding DockStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=FloatingCapsule}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [StyleFullWidth], Source={x:Static res:Loc.Instance}}" GroupName="DockStyle"
                                     IsChecked="{Binding DockStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=FullWidth}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Ekran kenarı: Alt, Üst, Sol, Sağ -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockEdgeTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [DockEdgeBottom], Source={x:Static res:Loc.Instance}}" GroupName="DockEdge"
                                     IsChecked="{Binding DockEdge, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Bottom}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [DockEdgeTop], Source={x:Static res:Loc.Instance}}" GroupName="DockEdge"
                                     IsChecked="{Binding DockEdge, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Top}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [DockEdgeLeft], Source={x:Static res:Loc.Instance}}" GroupName="DockEdge"
                                     IsChecked="{Binding DockEdge, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Left}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [DockEdgeRight], Source={x:Static res:Loc.Instance}}" GroupName="DockEdge"
                                     IsChecked="{Binding DockEdge, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Right}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Dock uzunluğu: %10..%100 -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockLengthTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="140" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding DockLengthPercent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DockLengthPercent, StringFormat='{}{0}%'}"
                               Foreground="{DynamicResource KoyNotchTextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kenardan uzaklık: 0..96 px -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockEdgeOffsetTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="140" Minimum="0" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True"
                            Value="{Binding DockEdgeOffsetDip}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DockEdgeOffsetDip, StringFormat='{}{0:0} px'}"
                               Foreground="{DynamicResource KoyNotchTextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- İç dolgu: 0..24 px -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockInnerPaddingTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="140" Minimum="0" Maximum="24" TickFrequency="2" IsSnapToTickEnabled="True"
                            Value="{Binding DockInnerPaddingDip}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DockInnerPaddingDip, StringFormat='{}{0:0} px'}"
                               Foreground="{DynamicResource KoyNotchTextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Yalnız tam genişlikte: kapsül içeriği kadar geniştir, hizalanacak boşluğu yoktur. -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Border.Visibility>
                <Binding Path="DockStyle" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="FullWidth" />
            </Border.Visibility>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockIconAlignmentTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [DockIconAlignLeft], Source={x:Static res:Loc.Instance}}" GroupName="DockIconAlignment"
                                     IsChecked="{Binding DockIconAlignment, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Left}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [DockIconAlignCenter], Source={x:Static res:Loc.Instance}}" GroupName="DockIconAlignment"
                                     IsChecked="{Binding DockIconAlignment, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Center}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [DockIconAlignRight], Source={x:Static res:Loc.Instance}}" GroupName="DockIconAlignment"
                                     IsChecked="{Binding DockIconAlignment, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Right}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- PENCERE YAKLAŞINCA -->
        <TextBlock Text="{Binding [DockProximityTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
            <Grid>
                <!-- Satır başlığı yok: hemen üstündeki bölüm başlığı aynı metin, beş segment de tam genişliği ister. -->
                <!-- Tam genişlikte yalnız Windows görev çubuğunun iki hâli: hep göster (yer ayırır) ve otomatik gizle.
                     Aşağı yapış ve Çekil kapsüle özgüdür (DockProximityMapping). -->
                <Border Style="{StaticResource SegmentContainerStyle}" HorizontalAlignment="Left">
                    <Border.Visibility>
                        <Binding Path="DockStyle" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="FullWidth" />
                    </Border.Visibility>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [ProxFullAlwaysShow], Source={x:Static res:Loc.Instance}}" GroupName="DockProximityFull"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ReserveSpace}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ProxFullAutoHide], Source={x:Static res:Loc.Instance}}" GroupName="DockProximityFull"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=AlwaysHidden}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SegmentContainerStyle}" HorizontalAlignment="Left">
                    <Border.Visibility>
                        <Binding Path="DockStyle" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="FloatingCapsule" />
                    </Border.Visibility>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [ProxReserve], Source={x:Static res:Loc.Instance}}" GroupName="DockProximity"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ReserveSpace}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ProxDockDown], Source={x:Static res:Loc.Instance}}" GroupName="DockProximity"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=DockDown}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ProxDodge], Source={x:Static res:Loc.Instance}}" GroupName="DockProximity"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Dodge}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ProxAlwaysHidden], Source={x:Static res:Loc.Instance}}" GroupName="DockProximity"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=AlwaysHidden}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [ProxAlwaysFloating], Source={x:Static res:Loc.Instance}}" GroupName="DockProximity"
                                     IsChecked="{Binding DockProximity, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=AlwaysFloating}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid>
                <Grid.Visibility>
                    <Binding Path="DockStyle" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="FullWidth" />
                </Grid.Visibility>
                <TextBlock Text="{Binding [ProxFullAlwaysShowDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="ReserveSpace" />
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Text="{Binding [ProxFullAutoHideDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="AlwaysHidden" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
            <Grid>
                <Grid.Visibility>
                    <Binding Path="DockStyle" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="FloatingCapsule" />
                </Grid.Visibility>
                <TextBlock Text="{Binding [ProxReserveDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="ReserveSpace" />
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Text="{Binding [ProxDockDownDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="DockDown" />
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Text="{Binding [ProxDodgeDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="Dodge" />
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Text="{Binding [ProxAlwaysHiddenDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="AlwaysHidden" />
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Text="{Binding [ProxAlwaysFloatingDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="DockProximity" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="AlwaysFloating" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HideInFullscreenTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [HideInFullscreenTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockHideInFullscreen}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockEdgeRevealTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DockEdgeRevealDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DockEdgeRevealTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockEdgeReveal}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- SİMGELER -->
        <TextBlock Text="{Binding [DockSizeHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockIconSizeTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [SizeSmall], Source={x:Static res:Loc.Instance}}" GroupName="IconSize"
                                     IsChecked="{Binding DockIconSize, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=24}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [SizeMedium], Source={x:Static res:Loc.Instance}}" GroupName="IconSize"
                                     IsChecked="{Binding DockIconSize, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=28}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [SizeLarge], Source={x:Static res:Loc.Instance}}" GroupName="IconSize"
                                     IsChecked="{Binding DockIconSize, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=34}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Simge aralığı: 0..16 px -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockIconSpacingTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="140" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding DockIconSpacingDip}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DockIconSpacingDip, StringFormat='{}{0:0} px'}"
                               Foreground="{DynamicResource KoyNotchTextSecondary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HoverMagnifyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [HoverMagnifyTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockHoverMagnify}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [IndicatorStyleTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [IndicatorDot], Source={x:Static res:Loc.Instance}}" GroupName="IndStyle"
                                     IsChecked="{Binding DockIndicatorStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Dot}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IndicatorLine], Source={x:Static res:Loc.Instance}}" GroupName="IndStyle"
                                     IsChecked="{Binding DockIndicatorStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Line}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BÖLÜMLER -->
        <TextBlock Text="{Binding [SectionsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [StartButtonTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [StartButtonTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockShowStartButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- Başlat simgesi: düğme gizliyken seçenek sunulmaz. Özel görsel satırı yalnız "Özel" seçiliyken. -->
        <Border Style="{StaticResource SettingRowStyle}">
            <Border.Visibility>
                <Binding Path="DockShowStartButton" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="True" />
            </Border.Visibility>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [DockStartIconTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding [DockStartIconKoy], Source={x:Static res:Loc.Instance}}" GroupName="DockStartIcon"
                                         IsChecked="{Binding DockStartIcon, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Koy}"
                                         Style="{StaticResource SegRadioStyle}" />
                            <RadioButton Content="{Binding [DockStartIconWindows], Source={x:Static res:Loc.Instance}}" GroupName="DockStartIcon"
                                         IsChecked="{Binding DockStartIcon, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Windows}"
                                         Style="{StaticResource SegRadioStyle}" />
                            <RadioButton Content="{Binding [DockStartIconCustom], Source={x:Static res:Loc.Instance}}" GroupName="DockStartIcon"
                                         IsChecked="{Binding DockStartIcon, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Custom}"
                                         Command="{Binding PickStartIconCommand}"
                                         Style="{StaticResource SegRadioStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.Visibility>
                        <Binding Path="DockStartIcon" Converter="{x:Static local:ComparisonToVisibilityConverter.Instance}" ConverterParameter="Custom" />
                    </Grid.Visibility>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StartIconFileName}" Style="{StaticResource SettingDescStyle}"
                               VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="{Binding [DockStartIconChoose], Source={x:Static res:Loc.Instance}}"
                            Command="{Binding PickStartIconCommand}" Style="{StaticResource SettingButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [FoldersSectionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [FoldersSectionTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockShowFolders}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockShowRecentsTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DockShowRecentsDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DockShowRecentsTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockShowRecents}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockShowTrayTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DockShowTrayDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding DockShowTray}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DockSmallTrayTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DockSmallTrayDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DockSmallTrayTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockSmallTray}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- GÖREV ÇUBUĞU KURTARMA -->
        <TextBlock Text="{Binding [TaskbarRecoveryHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [RestoreTaskbarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [RestoreTaskbarDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding [RestoreTaskbarTitle], Source={x:Static res:Loc.Instance}}"
                        Command="{Binding RestoreTaskbarCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
