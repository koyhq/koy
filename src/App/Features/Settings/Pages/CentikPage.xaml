<UserControl x:Class="Koy.App.Features.Settings.Pages.CentikPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavNotch], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [NotchSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <!-- GÖRÜNÜRLÜK -->
        <TextBlock Text="{Binding [NotchHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchEnabledTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [NotchEnabledTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [VisibilityTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [VisibilityDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [VisFixed], Source={x:Static res:Loc.Instance}}" GroupName="NotchVis"
                                     IsChecked="{Binding NotchVisibility, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Fixed}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [VisSmart], Source={x:Static res:Loc.Instance}}" GroupName="NotchVis"
                                     IsChecked="{Binding NotchVisibility, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Smart}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [VisPeek], Source={x:Static res:Loc.Instance}}" GroupName="NotchVis"
                                     IsChecked="{Binding NotchVisibility, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Peek}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [HideInFullscreenTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [HideInFullscreenTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchHideInFullscreen}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchStyleTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [NotchStyleDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [NotchStylePinned], Source={x:Static res:Loc.Instance}}" GroupName="NotchStyle"
                                     IsChecked="{Binding NotchStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Pinned}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NotchStyleFloating], Source={x:Static res:Loc.Instance}}" GroupName="NotchStyle"
                                     IsChecked="{Binding NotchStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Floating}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BOŞTAYKEN -->
        <TextBlock Text="{Binding [IdleDisplayTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [IdleDisplayRowTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [IdleClockBattery], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ClockAndBattery}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IdleClockOnly], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ClockOnly}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IdleRingClockDay], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     ToolTip="{Binding [IdleRingClockDayDesc], Source={x:Static res:Loc.Instance}}"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=RingClockDay}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [IdleNone], Source={x:Static res:Loc.Instance}}" GroupName="IdleMode"
                                     IsChecked="{Binding IdleDisplayMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Nothing}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [MusicWaveformTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [MusicWaveformTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding MusicShowWaveform}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [MusicCardStyleTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [MusicCardStyleDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [MusicCardStyleNeutral], Source={x:Static res:Loc.Instance}}" GroupName="MusicCardStyle"
                                     IsChecked="{Binding MusicCardStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Neutral}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [MusicCardStyleTinted], Source={x:Static res:Loc.Instance}}" GroupName="MusicCardStyle"
                                     IsChecked="{Binding MusicCardStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Tinted}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [MusicCardStyleArtwork], Source={x:Static res:Loc.Instance}}" GroupName="MusicCardStyle"
                                     IsChecked="{Binding MusicCardStyle, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Artwork}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LyricsSettingTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [LyricsSettingDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [LyricsSettingTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding MusicLyricsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- GÖRSELLER (canlı arka plan, issue #67). Varsayılan: Kapalı. Yalnız açık çentikte oynar; hareketi azalt ve pil tasarrufunda ilk kare. -->
        <TextBlock Text="{Binding [LiveBgHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LiveBgTargetTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [LiveBgTargetDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [LiveBgTargetNone], Source={x:Static res:Loc.Instance}}" GroupName="LiveBackgroundTarget"
                                     IsChecked="{Binding LiveBackgroundTarget, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=None}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [LiveBgTargetNotch], Source={x:Static res:Loc.Instance}}" GroupName="LiveBackgroundTarget"
                                     IsChecked="{Binding LiveBackgroundTarget, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Notch}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [LiveBgTargetMusicCard], Source={x:Static res:Loc.Instance}}" GroupName="LiveBackgroundTarget"
                                     IsChecked="{Binding LiveBackgroundTarget, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=MusicCard}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [LiveBgTargetBoth], Source={x:Static res:Loc.Instance}}" GroupName="LiveBackgroundTarget"
                                     IsChecked="{Binding LiveBackgroundTarget, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Both}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding IsLiveBackgroundEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LiveBgSourceTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [LiveBgSourceDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [LiveBgSourceAmbient], Source={x:Static res:Loc.Instance}}" GroupName="LiveBackgroundSource"
                                     IsChecked="{Binding LiveBackgroundSource, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=BuiltInAmbient}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [LiveBgSourceFile], Source={x:Static res:Loc.Instance}}" GroupName="LiveBackgroundSource"
                                     IsChecked="{Binding LiveBackgroundSource, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=LocalFile}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding IsLiveBackgroundEnabled}"
                Visibility="{Binding IsLiveBackgroundAmbientSource, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LiveBgPresetTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [LiveBgPresetDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [LiveBgPresetTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="140" Height="32"
                          ItemsSource="{Binding LiveBackgroundPresetOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding LiveBackgroundPreset}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding IsLiveBackgroundEnabled}"
                Visibility="{Binding IsLiveBackgroundFileSource, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LiveBgFileTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding LiveBackgroundFileName}" Style="{StaticResource SettingDescStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LiveBackgroundFileMessage}"
                               Foreground="{DynamicResource KoyDangerText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescStyle}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding [LiveBgFileChoose], Source={x:Static res:Loc.Instance}}"
                        Command="{Binding PickLiveBackgroundFileCommand}" Style="{StaticResource SettingButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding IsLiveBackgroundEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [LiveBgScrimTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [LiveBgScrimDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [LiveBgScrimTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding LiveBackgroundScrimOptions}" SelectedItem="{Binding LiveBackgroundScrimPercent}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <!-- GÖSTERGELER -->
        <TextBlock Text="{Binding [IndicatorsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [VolumeOsdTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [VolumeOsdDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [VolumeOsdTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ShowVolumeOsd}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [BrightnessOsdTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [BrightnessOsdTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ShowBrightnessOsd}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PrivacyIndicatorTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [PrivacyIndicatorDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [PrivacyIndicatorTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ShowPrivacyIndicator}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotificationsTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [NotificationsDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                    <TextBlock Text="{Binding [NotificationsNeedPermission], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}"
                               Foreground="{DynamicResource KoyAccent}"
                               Visibility="{Binding NotificationsPermissionMissing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [NotificationsTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchShowNotifications}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}" IsEnabled="{Binding NotchShowNotifications}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotificationsHideBodyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [NotificationsHideBodyDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [NotificationsHideBodyTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchNotificationsHideBody}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- PANELLER -->
        <TextBlock Text="{Binding [PanelsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelFocusTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelFocusTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelFocus}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelShelfTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelShelfTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelShelf}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelControlCenterTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelControlCenterTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelControlCenter}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelCalendarTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelCalendarTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelCalendar}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PanelClipboardTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [PanelClipboardDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [PanelClipboardTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelClipboard}" IsEnabled="{Binding ClipboardHistoryEnabled}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [ClipboardHistoryTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [ClipboardHistoryDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [ClipboardHistoryTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ClipboardHistoryEnabled}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PanelSystemTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox AutomationProperties.Name="{Binding [PanelSystemTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding PanelSystem}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <!-- DAVRANIŞ -->
        <TextBlock Text="{Binding [OpenBehaviorTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [OpenBehaviorRowTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [OpenOnHover], Source={x:Static res:Loc.Instance}}" GroupName="OpenBeh"
                                     IsChecked="{Binding NotchOpenBehavior, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Hover}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [OpenOnClick], Source={x:Static res:Loc.Instance}}" GroupName="OpenBeh"
                                     IsChecked="{Binding NotchOpenBehavior, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Click}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- HAVA DURUMU: konum yoksa çentikte hava durumu hiç gösterilmez -->
        <TextBlock Text="{Binding [WeatherHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [WeatherUseLocationTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [WeatherUseLocationDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [WeatherUseLocationTitle], Source={x:Static res:Loc.Instance}}"
                          IsChecked="{Binding Weather.UseLocation}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Left" MaxWidth="440">
                    <TextBlock Text="{Binding [WeatherCityTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [WeatherCityDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SettingTextBoxStyle}" Text="{Binding Weather.Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding [WeatherSearchHint], Source={x:Static res:Loc.Instance}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding Weather.SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingButtonStyle}" Command="{Binding Weather.SearchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <res:KoyIcon Data="{StaticResource IconSearch}" Size="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [WeatherSearchButton], Source={x:Static res:Loc.Instance}}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding [WeatherSearching], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0"
                           Visibility="{Binding Weather.IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding [WeatherNoResults], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0"
                           Visibility="{Binding Weather.NoResults, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Weather.Results}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SettingButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                    Command="{Binding DataContext.Weather.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <res:KoyIcon Data="{StaticResource IconMapPin}" Size="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Weather.StatusText}" Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SettingButtonStyle}" Command="{Binding Weather.OpenLocationSettingsCommand}"
                            Visibility="{Binding Weather.ShowLocationSettingsLink, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [WeatherOpenLocationSettings], Source={x:Static res:Loc.Instance}}" />
                            <res:KoyIcon Data="{StaticResource IconExternalLink}" Size="14" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingButtonStyle}" Command="{Binding Weather.ClearLocationCommand}"
                        Visibility="{Binding Weather.HasLocation, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [WeatherClear], Source={x:Static res:Loc.Instance}}" />
                </Button>
            </Grid>
        </Border>

        <!-- POMODORO -->
        <TextBlock Text="{Binding [PomodoroHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PomodoroWorkTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [PomodoroWorkTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding PomodoroWorkOptions}" SelectedItem="{Binding PomodoroWorkMinutes}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PomodoroShortBreakTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [PomodoroShortBreakTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding PomodoroShortBreakOptions}" SelectedItem="{Binding PomodoroShortBreakMinutes}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [PomodoroLongBreakTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{Binding [PomodoroLongBreakTitle], Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Width="100" Height="32"
                          ItemsSource="{Binding PomodoroLongBreakOptions}" SelectedItem="{Binding PomodoroLongBreakMinutes}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>
        <!-- ARAMA -->
        <TextBlock Text="{Binding [SearchSettingsHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [SearchRetainTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [SearchRetainDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [SearchRetainTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding SearchRetainPrior}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [SearchHistoryTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [SearchHistoryOff], Source={x:Static res:Loc.Instance}}" GroupName="SearchHistoryMode"
                                     IsChecked="{Binding SearchHistoryMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Disabled}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [SearchHistorySuggest], Source={x:Static res:Loc.Instance}}" GroupName="SearchHistoryMode"
                                     IsChecked="{Binding SearchHistoryMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=Suggestion}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [SearchHistoryComplete], Source={x:Static res:Loc.Instance}}" GroupName="SearchHistoryMode"
                                     IsChecked="{Binding SearchHistoryMode, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=ImmediateCompletion}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding [SearchClearHistoryTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding [SearchClearHistoryButton], Source={x:Static res:Loc.Instance}}" Command="{Binding ClearSearchHistoryCommand}" Style="{StaticResource SettingButtonStyle}" />
            </Grid>
        </Border>

        <TextBlock Text="{Binding [SearchSourcesHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <ItemsControl ItemsSource="{Binding SearchSources}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsEnabled}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
