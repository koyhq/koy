<UserControl x:Class="Koy.App.Features.Settings.Pages.CentikPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:sub="clr-namespace:Koy.App.Features.Settings.Pages.SubPages"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavNotch], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [NotchSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NotchEnabledTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [NotchEnabledTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>

        <Border Name="SubTabBar" HorizontalAlignment="Left" Margin="0,8,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SegmentContainerStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{Binding [SubTabNotchBehavior], Source={x:Static res:Loc.Instance}}" GroupName="CentikSubTab"
                             IsChecked="{Binding NotchSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabNotchVisuals], Source={x:Static res:Loc.Instance}}" GroupName="CentikSubTab"
                             IsChecked="{Binding NotchSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabNotchPanels], Source={x:Static res:Loc.Instance}}" GroupName="CentikSubTab"
                             IsChecked="{Binding NotchSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=2}"
                             Style="{StaticResource SegRadioStyle}" />
                <RadioButton Content="{Binding [SubTabNotchSearch], Source={x:Static res:Loc.Instance}}" GroupName="CentikSubTab"
                             IsChecked="{Binding NotchSubTabIndex, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=3}"
                             Style="{StaticResource SegRadioStyle}" />
            </StackPanel>
        </Border>

        <sub:CentikBehaviorSubPage x:Name="SubTab0">
            <sub:CentikBehaviorSubPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotchSubTabIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:CentikBehaviorSubPage.Style>
        </sub:CentikBehaviorSubPage>

        <sub:CentikVisualsSubPage x:Name="SubTab1">
            <sub:CentikVisualsSubPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotchSubTabIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:CentikVisualsSubPage.Style>
        </sub:CentikVisualsSubPage>

        <sub:CentikPanelsSubPage x:Name="SubTab2">
            <sub:CentikPanelsSubPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotchSubTabIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:CentikPanelsSubPage.Style>
        </sub:CentikPanelsSubPage>

        <sub:CentikSearchSubPage x:Name="SubTab3">
            <sub:CentikSearchSubPage.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotchSubTabIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowChangedOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </sub:CentikSearchSubPage.Style>
        </sub:CentikSearchSubPage>
    </StackPanel>
</UserControl>
