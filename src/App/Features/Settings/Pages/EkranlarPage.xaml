<UserControl x:Class="Koy.App.Features.Settings.Pages.EkranlarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Çentik ve dock şeması gerçek çentik/dock görünümünü anlatır: bu iki küçük şekil temadan bağımsız. -->
        <SolidColorBrush x:Key="MiniNotchBrush" Color="#0A0A0B" />

        <!-- Kart düğmesi: yalnız tıklanabilir yüzey, görünümü içindeki kartta. -->
        <Style x:Key="MonitorCardButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,16,24" DataContext="{Binding Displays}" d:DataContext="{d:DesignInstance local:DisplaysViewModel}">

        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding [NavDisplays], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding [DisplaysSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,16" />
            </StackPanel>
            <Button Style="{StaticResource SettingButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding IdentifyCommand}">
                <StackPanel Orientation="Horizontal">
                    <res:KoyIcon Data="{StaticResource IconMonitor}" Size="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [DisplaysIdentify], Source={x:Static res:Loc.Instance}}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Monitör şeması: gerçek yerleşim, ölçekli. Karta tıklayınca o ekranın ayarları aşağıda açılır. -->
        <Border Background="{DynamicResource KoyBgShell}" BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1" CornerRadius="{DynamicResource KoyRadiusRow}" Height="180" Margin="0,0,0,12">
            <ItemsControl x:Name="SchemaItems"
                          ItemsSource="{Binding Cards}"
                          Width="{Binding SchemaWidth}"
                          Height="{Binding SchemaHeight}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MonitorCardViewModel}">
                        <Button Style="{StaticResource MonitorCardButtonStyle}"
                                Command="{Binding DataContext.SelectCardCommand, ElementName=SchemaItems}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Monitor.Name}">
                            <Border x:Name="card" Width="{Binding Width}" Height="{Binding Height}"
                                    BorderThickness="2" CornerRadius="{DynamicResource KoyRadiusRow}"
                                    Background="{DynamicResource KoyBgControl}" BorderBrush="{DynamicResource KoyBorderStrong}">
                                <Grid>
                                    <!-- Seçim: vurgu katmanı yumuşakça belirir (hız ayarına uyar) -->
                                    <Border x:Name="selected" Opacity="0" Margin="-2" CornerRadius="{DynamicResource KoyRadiusRow}" BorderThickness="2"
                                            Background="{DynamicResource KoyAccentSubtle}" BorderBrush="{DynamicResource KoyAccent}" />
                                    <!-- Mini çentik: bu ekranda çentik açıksa -->
                                    <Border Width="40" Height="7" Background="{StaticResource MiniNotchBrush}" CornerRadius="0,0,5,5"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Visibility="{Binding ShowsNotch, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource KoyTextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Mini dock: bu ekranda dock açıksa -->
                                    <Border Width="64" Height="8" Background="{DynamicResource KoyBorderControl}" CornerRadius="4"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                            Visibility="{Binding ShowsDock, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="selected" Property="res:Motion.FadeTo" Value="1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Seçili ekran -->
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="2,24,0,8">
                <TextBlock Text="{Binding SelectedHeader}" FontSize="{DynamicResource KoyFontSection}" FontWeight="SemiBold" Foreground="{DynamicResource KoyTextMuted}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource KoyAccentSubtle}" CornerRadius="{DynamicResource KoyRadiusSmall}" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SelectedIsPrimary, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [DisplayPrimaryBadge], Source={x:Static res:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource KoyAccentText}" />
                </Border>
            </StackPanel>

            <Border Style="{StaticResource SettingRowStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedName}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding SelectedDetails}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [ScreenNotchTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [ScreenNotchTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding NotchOn}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [ScreenDockTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [ScreenDockTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DockOn}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- YENİ EKRANLAR -->
        <TextBlock Text="{Binding [NewDisplaysHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [NewDisplayActionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [NewDisplayBoth], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode"
                                     IsChecked="{Binding NewScreenBoth, Mode=TwoWay}" Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NewDisplayNotchOnly], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode"
                                     IsChecked="{Binding NewScreenNotchOnly, Mode=TwoWay}" Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [NewDisplayNone], Source={x:Static res:Loc.Instance}}" GroupName="NewScreenMode"
                                     IsChecked="{Binding NewScreenNone, Mode=TwoWay}" Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <res:KoyIcon Data="{StaticResource IconInfo}" Size="16" Foreground="{DynamicResource KoyFgInfo}" Margin="0,1,10,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding [MultiMonitorNotice], Source={x:Static res:Loc.Instance}}"
                           Foreground="{DynamicResource KoyFgInfo}" FontSize="12.5" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
