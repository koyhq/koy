<UserControl x:Class="Koy.App.Features.Settings.Pages.KisayollarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Settings"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:KoyWindowViewModel}">

    <StackPanel Margin="0,0,16,24">
        <TextBlock Text="{Binding [NavShortcuts], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding [ShortcutsSubtitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,8" />

        <!-- KLAVYE -->
        <TextBlock Text="{Binding [KeyboardHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <ItemsControl ItemsSource="{Binding Shortcuts.Rows}" Focusable="False">
            <ItemsControl.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
            </ItemsControl.Resources>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource KoyDangerText}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap" MaxWidth="360"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SettingButtonStyle}" MinWidth="190"
                                        AutomationProperties.Name="{Binding Title}"
                                        Click="OnCaptureClick"
                                        PreviewKeyDown="OnCapturePreviewKeyDown"
                                        LostKeyboardFocus="OnCaptureLostFocus">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding KeyTokens}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasShortcut}" Value="True" />
                                                                <Condition Binding="{Binding IsCapturing}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding [ShortcutPressKeys], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyAccentText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding [ShortcutNone], Source={x:Static res:Loc.Instance}}" Foreground="{DynamicResource KoyTextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasShortcut}" Value="False" />
                                                                <Condition Binding="{Binding IsCapturing}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                                <Button Content="{Binding [ShortcutReset], Source={x:Static res:Loc.Instance}}"
                                        Command="{Binding ResetToDefaultCommand}"
                                        Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingButtonStyle}">
                                            <Style.Triggers>
                                                <!-- Zaten varsayılandaysa sıfırlanacak bir şey yok: düğme görünmez. -->
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Bilgi Kutusu -->
        <Border Style="{StaticResource InfoNoticeStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <res:KoyIcon Data="{StaticResource IconInfo}" Size="16" Foreground="{DynamicResource KoyFgInfo}" Margin="0,1,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding [ShortcutsNotice], Source={x:Static res:Loc.Instance}}"
                           Grid.Column="1" Foreground="{DynamicResource KoyFgInfo}" FontSize="12.5" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- FARE -->
        <TextBlock Text="{Binding [MouseHeader], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [WheelActionTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [WheelSwitchPanel], Source={x:Static res:Loc.Instance}}" GroupName="WheelAction"
                                     IsChecked="{Binding WheelAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [WheelVolume], Source={x:Static res:Loc.Instance}}" GroupName="WheelAction"
                                     IsChecked="{Binding WheelAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [MiddleClickTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding [MidClickNewWindow], Source={x:Static res:Loc.Instance}}" GroupName="MidClickAction"
                                     IsChecked="{Binding MiddleClickAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=0}"
                                     Style="{StaticResource SegRadioStyle}" />
                        <RadioButton Content="{Binding [MidClickClose], Source={x:Static res:Loc.Instance}}" GroupName="MidClickAction"
                                     IsChecked="{Binding MiddleClickAction, Converter={x:Static local:ComparisonToBoolConverter.Instance}, ConverterParameter=1}"
                                     Style="{StaticResource SegRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
