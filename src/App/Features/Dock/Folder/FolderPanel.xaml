<UserControl x:Class="Koy.App.Features.Dock.Folder.FolderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="clr-namespace:Koy.App.Features.Dock"
             xmlns:res="clr-namespace:Koy.App.Resources">
    <Grid>
        <Popup x:Name="FolderPopup"
               PlacementTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None">
            <Border x:Name="PopupBody"
                    RenderTransformOrigin="0.5,1"
                    Background="{DynamicResource KoyMenuBg}"
                    BorderBrush="{DynamicResource KoyMenuBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="12"
                    MinWidth="200"
                    MaxWidth="320"
                    SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PopupScale"/>
                        <TranslateTransform x:Name="PopupShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="4"
                                      Opacity="0.45"
                                      Direction="270"
                                      Color="{StaticResource KoyShadowColor}"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Başlık Bölümü: Başlık metni (tıklayınca düzenleme modu), Adını değiştir ve Klasörü dağıt düğmeleri -->
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Başlık Görüntüleme Modu -->
                        <TextBlock x:Name="TitleTextBlock"
                                   Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource KoyMenuText}"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip="{Binding RenameTooltip}"
                                   MouseLeftButtonDown="OnTitleClick"/>

                        <!-- Başlık Düzenleme Modu (Inline Edit) -->
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#FFFFFF"
                                 Background="#2AFFFFFF"
                                 BorderBrush="{DynamicResource KoyAccent}"
                                 BorderThickness="1"
                                 Padding="4,2"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 KeyDown="OnTitleKeyDown"
                                 LostFocus="OnTitleLostFocus"/>

                        <!-- Başlık Eylem Düğmeleri -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Adını değiştir düğmesi -->
                            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Click="OnRenameButtonClick"
                                    ToolTip="{Binding RenameTooltip}"
                                    Width="24" Height="24"
                                    Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                                            <Path Data="M 3,14 L 3,17 L 6,17 L 15,8 L 12,5 Z M 16,7 L 13,4 L 14.5,2.5 C 14.8,2.2 15.2,2.2 15.5,2.5 L 17.5,4.5 C 17.8,4.8 17.8,5.2 17.5,5.5 Z"
                                                  Fill="{DynamicResource KoyMenuTextMuted}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource KoyMenuHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Klasörü dağıt düğmesi -->
                            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Command="{Binding DissolveCommand}"
                                    ToolTip="{Binding DissolveTooltip}"
                                    Width="24" Height="24"
                                    Margin="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                                            <Path Data="M 3,3 L 8,3 L 8,5 L 5,5 L 5,8 L 3,8 Z M 16,3 L 21,3 L 21,8 L 19,8 L 19,5 L 16,5 Z M 3,16 L 5,16 L 5,19 L 8,19 L 8,21 L 3,21 Z M 19,16 L 21,16 L 21,21 L 16,21 L 16,19 L 19,19 Z"
                                                  Fill="{DynamicResource KoyMenuTextMuted}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource KoyMenuHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource KoyMenuBorder}" Margin="0,0,0,8"/>

                    <!-- 4 Sütunlu Uygulama Izgarası -->
                    <ItemsControl x:Name="AppsItemsControl"
                                  ItemsSource="{Binding Items}"
                                  PreviewMouseLeftButtonDown="OnAppItemLeftDown"
                                  PreviewMouseMove="OnAppItemMouseMove"
                                  PreviewMouseLeftButtonUp="OnAppItemLeftUp">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="AppItemBox"
                                        Width="52" Height="56"
                                        Margin="2"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        ToolTip="{Binding Title}"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource KoyMenuHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Simge -->
                                            <Grid Width="28" Height="28" HorizontalAlignment="Center">
                                                <Image Source="{Binding Icon}"
                                                       Width="28" Height="28"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <!-- Simge yoksa yedek -->
                                                <Border Width="28" Height="28"
                                                        Background="#33FFFFFF"
                                                        CornerRadius="6"
                                                        Visibility="{Binding Icon, Converter={x:Static dock:DockConverters.NullToVisibleConverter}}">
                                                    <Path HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#CCCCCC"
                                                          Data="M 2,2 H 14 V 14 H 2 Z"/>
                                                </Border>
                                            </Grid>

                                            <!-- Uygulama Adı Metni (tek satır kırpılmış) -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource KoyMenuTextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="48"
                                                       TextAlignment="Center"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Çalışma Noktası -->
                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,-2"
                                                Width="4" Height="4"
                                                CornerRadius="2"
                                                Background="{DynamicResource KoyAccent}"
                                                Visibility="{Binding IsRunning, Converter={x:Static dock:DockConverters.BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
