<Window x:Class="Koy.App.Features.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Koy.App.Resources"
        xmlns:local="clr-namespace:Koy.App.Features.Dock"
        xmlns:preview="clr-namespace:Koy.App.Features.Dock.Preview"
        xmlns:coreDock="clr-namespace:Koy.Core.Dock;assembly=Koy.Core"
        Title="Koy Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <!-- Dock Gövdesi (Animasyon ile aşağı kayar ve saydamlaşır) -->
        <Grid RenderTransformOrigin="0.5, 1"
              IsHitTestVisible="{Binding IsVisible}">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="{Binding TranslationX}" Y="{Binding TranslationY}"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Opacity>
                <Binding Path="Opacity"/>
            </Grid.Opacity>

            <!-- 1. Yüzen Kapsül Modu (Varsayılan Seelen Modeli) -->
            <local:DockCapsule Visibility="{Binding IsFullWidthMode, Converter={x:Static local:DockConverters.InverseBoolToVisibilityConverter}}"/>

            <!-- 2. Tam Genişlik Modu (48 px, Windows görev çubuğu tarzı: Başlat, uygulamalar, sağ bölüm) -->
            <local:DockFullWidth Visibility="{Binding IsFullWidthMode, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- 3. Çekil (Dodge) Modu İnce Tutamak: kenara duyarlı 120×4 px / 4×120 px, 2 px yarıçap, rgba(24,24,27,0.35) -->
        <Border Width="{Binding DodgeHandleWidth}"
                Height="{Binding DodgeHandleHeight}"
                CornerRadius="2"
                Background="#5918181B"
                HorizontalAlignment="{Binding DodgeHandleHorizontalAlignment}"
                VerticalAlignment="{Binding DodgeHandleVerticalAlignment}"
                Margin="{Binding DodgeHandleMargin}"
                Cursor="Hand"
                ToolTip="{Binding [DockShowTooltip], Source={x:Static res:Loc.Instance}}"
                Visibility="{Binding IsHandleVisible, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"
                MouseEnter="OnDodgeHandleMouseEnter"
                MouseLeave="OnDodgeHandleMouseLeave"/>

        <!-- 4. Canlı DWM Pencere Küçük Resim Önizlemesi -->
        <Popup x:Name="ThumbnailPreviewPopup"
               IsOpen="{Binding IsPreviewPopupOpen}"
               PlacementTarget="{Binding PreviewPlacementTarget}"
               Placement="{Binding PreviewPlacement}"
               VerticalOffset="{Binding PreviewVerticalOffset}"
               HorizontalOffset="{Binding PreviewHorizontalOffset}"
               AllowsTransparency="True"
               StaysOpen="True"
               MouseEnter="OnPopupMouseEnter"
               MouseLeave="OnPopupMouseLeave">
            <Border Background="#F51C1C1E"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="8"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="4"
                                      Opacity="0.45"
                                      Direction="270"
                                      Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <!-- Tekil Pencere Önizlemesi: 248 px genişlik, 132 px canlı küçük resim -->
                    <StackPanel Width="232"
                                Visibility="{Binding PreviewItem.IsMultiWindow, Converter={x:Static local:DockConverters.InverseBoolToVisibilityConverter}}">
                        <!-- Başlık ve Kapatma Butonu -->
                        <Grid Margin="4,0,4,6">
                            <TextBlock Text="{Binding PreviewItem.SingleWindow.Title}"
                                       FontSize="12"
                                       Foreground="#D4D4D8"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       MaxWidth="200"/>
                            <Button HorizontalAlignment="Right"
                                    Width="22"
                                    Height="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding PreviewItem.CloseSpecificWindowCommand}"
                                    CommandParameter="{Binding PreviewItem.SingleWindow.Handle}"
                                    ToolTip="{x:Static res:Strings.Close}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5">
                                            <Path Stroke="#D4D4D8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 3,3 L 11,11 M 11,3 L 3,11"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Canlı DWM Küçük Resim Alanı -->
                        <Border Height="132"
                                Background="#1E1E1E"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseDown="OnSingleThumbnailMouseDown"
                                MouseLeftButtonUp="OnSingleThumbnailClick">
                            <preview:WindowThumbnailPresenter WindowHandle="{Binding PreviewItem.SingleWindow.Handle}"/>
                        </Border>
                    </StackPanel>

                    <!-- Gruplanmış Pencereler Önizlemesi: Yan yana pencereler, 70 px canlı küçük resimler -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding PreviewItem.IsMultiWindow, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding PreviewItem.Windows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type coreDock:DockWindowEntry}">
                                    <Border Width="140"
                                            Margin="4,0"
                                            Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       Foreground="#D4D4D8"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="2,0,2,4"/>
                                            <Border Height="70"
                                                    Background="#1E1E1E"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Cursor="Hand"
                                                    MouseDown="OnGroupedThumbnailMouseDown"
                                                    MouseLeftButtonUp="OnGroupedThumbnailClick">
                                                <preview:WindowThumbnailPresenter WindowHandle="{Binding Handle}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
