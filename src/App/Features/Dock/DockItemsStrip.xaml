<UserControl x:Class="Koy.App.Features.Dock.DockItemsStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:local="clr-namespace:Koy.App.Features.Dock"
             xmlns:folder="clr-namespace:Koy.App.Features.Dock.Folder">

    <!-- Uygulama ve klasör şeridi: kapsül ve tam genişlik dock aynı şablonları kullanır (çalışma göstergeleri, rozet, dikkat) -->
    <ItemsControl x:Name="DockItemsList"
              ItemsSource="{Binding Items}"
              MaxWidth="{Binding ItemsMaxWidth}"
              ClipToBounds="{Binding IsStripClipped}">
        <ItemsControl.Resources>
            <!-- Uygulama Kapsayıcısı Şablonu -->
            <DataTemplate DataType="{x:Type local:DockItemViewModel}">
                <!-- Uygulama Kapsayıcısı: Dinamik ItemSize (varsayılan 38 px), 10 px köşe yuvarlama -->
                <Border x:Name="ItemContainer"
                        Width="{Binding ItemSize}"
                        Height="{Binding ItemSize}"
                        Margin="1,0"
                        CornerRadius="10"
                        Cursor="Hand"
                        ToolTip="{Binding Title}"
                        ToolTipService.IsEnabled="{Binding HasOpenWindows, Converter={x:Static local:DockConverters.InverseBoolConverter}}"
                        MouseLeftButtonDown="OnItemLeftDown"
                        MouseMove="OnItemMouseMove"
                        LostMouseCapture="OnItemLostCapture"
                        MouseLeftButtonUp="OnItemLeftClick"
                        MouseRightButtonUp="OnItemRightClick"
                        MouseDown="OnItemMouseDown"
                        MouseEnter="OnItemMouseEnter"
                        MouseLeave="OnItemMouseLeave"
                        ContextMenuOpening="OnItemContextMenuOpening">
                    <!-- Durum Arka Planı (Aktifse hafif aydınlık, dikkat bekliyorsa turuncu, hedef parıltısı mavi) -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTargetGlow}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource KoyAccentSubtle}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                </DataTrigger>
                                <!-- Gösterge stili "Arka plan": çalışan uygulamanın zemini vurgu rengiyle boyanır (nokta/çizgi çizilmez) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Presentation.IsHighlight}" Value="True"/>
                                        <Condition Binding="{Binding IsRunning}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource KoyAccentSubtle}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Presentation.IsHighlight}" Value="True"/>
                                        <Condition Binding="{Binding IsRunning}" Value="True"/>
                                        <Condition Binding="{Binding Presentation.HasIndicatorBrush}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{Binding Presentation.HighlightBrush}"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                    <Setter Property="Background" Value="#2EF97316"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.RenderTransform>
                        <TranslateTransform X="{Binding OffsetX}"/>
                    </Border.RenderTransform>

                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.LaunchNewInstance}"
                                      Command="{Binding MiddleClickCommand}"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.DockItemChangeIcon}"
                                      Command="{Binding ChangeIconCommand}"/>
                            <MenuItem Header="{x:Static res:Strings.DockItemResetIcon}"
                                      Command="{Binding ResetIconCommand}"
                                      IsEnabled="{Binding HasIconOverride}"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.Close}"
                                      Command="{Binding CloseCommand}"/>
                            <MenuItem Header="{x:Static res:Strings.EndTask}"
                                      Command="{Binding TerminateCommand}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <!-- Simge: Dinamik IconSize (varsayılan 28 px, büyütme ölçeği ile) -->
                        <Grid Width="{Binding IconSize}"
                              Height="{Binding IconSize}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5, 0.5">
                            <!-- İki ayrı çarpan: hover büyütmesi (Scale) ve basma (PressScale). Biri öbürünün yay hedefini ezmez. -->
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                                    <ScaleTransform ScaleX="{Binding PressScale}" ScaleY="{Binding PressScale}"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Image Source="{Binding Icon}"
                                   Opacity="{Binding PressOpacity}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Width="{Binding IconSize}"
                                   Height="{Binding IconSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <!-- Simge Yoksa Yedek Şablon -->
                            <Border Width="{Binding IconSize}"
                                    Height="{Binding IconSize}"
                                    Background="#33FFFFFF"
                                    CornerRadius="6"
                                    Visibility="{Binding Icon, Converter={x:Static local:DockConverters.NullToVisibleConverter}}">
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="#CCCCCC"
                                      Data="M 2,2 H 14 V 14 H 2 Z"/>
                            </Border>
                        </Grid>

                        <!-- Okunmamış Bildirim Rozeti: köşe, renk ve biçim (sayı / yalnız nokta) ayardan; 11px beyaz kalın yazı -->
                        <Border HorizontalAlignment="{Binding Presentation.BadgeHorizontal}"
                                VerticalAlignment="{Binding Presentation.BadgeVertical}"
                                Margin="{Binding Presentation.BadgeMargin}"
                                Visibility="{Binding ShowBadge, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="MinHeight" Value="18"/>
                                    <Setter Property="MinWidth" Value="18"/>
                                    <Setter Property="CornerRadius" Value="9"/>
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="Background" Value="{DynamicResource KoyAccent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Presentation.HasBadgeBrush}" Value="True">
                                            <Setter Property="Background" Value="{Binding Presentation.BadgeBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Presentation.BadgeDotOnly}" Value="True">
                                            <Setter Property="MinHeight" Value="10"/>
                                            <Setter Property="MinWidth" Value="10"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding BadgeText}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Çoklu Pencere Göstergesi: 3 küçük nokta vurgu rengi (Birden fazla pencere varsa) -->
                        <!-- Gösterge stili "Arka plan" iken nokta/çizgi hiç çizilmez (DrawsMark) -->
                        <Grid Visibility="{Binding Presentation.DrawsMark, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <!-- Pencere başına nokta kipinde sayı (en çok 3) Core'dan gelir (IndicatorCount). -->
                        <ItemsControl ItemsSource="{Binding IndicatorDots}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,2"
                                      IsHitTestVisible="False"
                                      Visibility="{Binding HasMultiDots, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="4" Height="3" CornerRadius="1.5" Margin="1,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource KoyAccent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Presentation.HasIndicatorBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Background" Value="{Binding DataContext.Presentation.IndicatorBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tekil Pencere / Çalışan Göstergesi (Tek pencere veya odak) -->
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Varsayılan: Çalışmıyorsa gizli -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- Çalışıyor ama inaktif: 6×3 px nokta #A1A1AA -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                <Condition Binding="{Binding IsAttention}" Value="False"/>
                                                <Condition Binding="{Binding HasMultiDots}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Width" Value="6"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="CornerRadius" Value="1.5"/>
                                            <Setter Property="Background" Value="#A1A1AA"/>
                                        </MultiDataTrigger>
                                        <!-- Gösterge stili "Çizgi": çalışan uygulama da 16×3 px çizgi alır -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                <Condition Binding="{Binding IsAttention}" Value="False"/>
                                                <Condition Binding="{Binding HasMultiDots}" Value="False"/>
                                                <Condition Binding="{Binding Presentation.UseLine}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Width" Value="16"/>
                                        </MultiDataTrigger>
                                        <!-- Aktif: 16×3 px çizgi vurgu rengi -->
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Width" Value="16"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="CornerRadius" Value="1.5"/>
                                            <Setter Property="Background" Value="{DynamicResource KoyAccent}"/>
                                        </DataTrigger>
                                        <!-- Gösterge rengi nötr/özel ise çalışan ve aktif göstergeler bu renkle boyanır (dikkat turuncusu kalır) -->
                                        <DataTrigger Binding="{Binding Presentation.HasIndicatorBrush}" Value="True">
                                            <Setter Property="Background" Value="{Binding Presentation.IndicatorBrush}"/>
                                        </DataTrigger>
                                        <!-- Dikkat İstiyor: 16×3 px çizgi #F97316 -->
                                        <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Width" Value="16"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="CornerRadius" Value="1.5"/>
                                            <Setter Property="Background" Value="#F97316"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Klasör Kapsayıcısı Şablonu -->
            <DataTemplate DataType="{x:Type local:DockFolderViewModel}">
                <Grid>
                    <Border x:Name="FolderContainer"
                            RenderTransformOrigin="0.5,0.5"
                            Width="{Binding ItemSize}"
                            Height="{Binding ItemSize}"
                            Margin="1,0"
                            CornerRadius="10"
                            Cursor="Hand"
                            ToolTip="{Binding Title}"
                            MouseLeftButtonDown="OnItemLeftDown"
                            MouseMove="OnItemMouseMove"
                            LostMouseCapture="OnItemLostCapture"
                            MouseLeftButtonUp="OnFolderLeftClick"
                            MouseRightButtonUp="OnFolderRightClick"
                            MouseDown="OnItemMouseDown"
                            MouseEnter="OnItemMouseEnter"
                            MouseLeave="OnItemMouseLeave"
                            ContextMenuOpening="OnItemContextMenuOpening">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="BorderBrush" Value="#2E2E33"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetGlow}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource KoyAccentSubtle}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2AFFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- Orijin ortada (ItemSize küçülünce de doğru): hover ve basma ayrı çarpan -->
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                                <ScaleTransform ScaleX="{Binding PressScale}" ScaleY="{Binding PressScale}"/>
                                <TranslateTransform X="{Binding OffsetX}"/>
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Grid Opacity="{Binding PressOpacity}">
                            <!-- 2x2 Mini Simge Izgarası -->
                            <ItemsControl ItemsSource="{Binding PreviewIcons}"
                                          Width="{Binding IconSize}"
                                          Height="{Binding IconSize}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}"
                                               Width="11" Height="11"
                                               Margin="1"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Stretch="Uniform"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Klasör Çalışan Göstergesi (içindeki herhangi bir uygulama çalışıyorsa) -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,2"
                                    Width="6" Height="3"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource KoyAccent}"
                                    Visibility="{Binding IsRunning, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- FolderPanel Kayan Cam Panel -->
                    <folder:FolderPanel PlacementTarget="{Binding ElementName=FolderContainer}"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.Resources>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
