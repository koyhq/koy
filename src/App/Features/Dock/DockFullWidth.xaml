<UserControl x:Class="Koy.App.Features.Dock.DockFullWidth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:local="clr-namespace:Koy.App.Features.Dock"
             xmlns:tray="clr-namespace:Koy.App.Features.Dock.Tray"
             xmlns:recents="clr-namespace:Koy.App.Features.Dock.Recents"
             xmlns:folder="clr-namespace:Koy.App.Features.Dock.Folder">

    <UserControl.Resources>
        <!-- Ortada yan sütunlar/satırlar eşit: ikonlar ekranın tam ortasında kalır. Sola/sağa/üste/alta hizada serbest bırakılır. -->
        <Style x:Key="DockSideColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="SharedSizeGroup" Value="DockSide"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StripAlignment}" Value="Left">
                    <Setter Property="SharedSizeGroup" Value="{x:Null}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StripAlignment}" Value="Right">
                    <Setter Property="SharedSizeGroup" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DockSideRowStyle" TargetType="RowDefinition">
            <Setter Property="SharedSizeGroup" Value="DockSideRow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerticalStripAlignment}" Value="Top">
                    <Setter Property="SharedSizeGroup" Value="{x:Null}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerticalStripAlignment}" Value="Bottom">
                    <Setter Property="SharedSizeGroup" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Windows tarzı tam genişlik: kalınlık DockPositionResolver.FullWidthHeightDip (48), kenardan uzaklık ve uzunluk ayarına uyar,
         yüzey malzeme ayarına uyar (Katı / Buzlu / Cam; DockViewModel.FullWidthSurface). Kenarlık yüzeyin üstüne çizilir:
         aksi halde BorderThickness altında yüzey boyanmadığından şeffaf pencerede üstte 1 px boşluk çizgisi görünürdü. -->
    <Border Background="{Binding FullWidthSurface}"
            Width="{Binding CapsuleWidth}"
            Height="{Binding CapsuleHeight}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid>
            <Grid Margin="{Binding FullWidthPadding}">
            <!-- 1. Yatay Düzen (Alt ve Üst Kenar) -->
            <Grid Grid.IsSharedSizeScope="True"
                  Visibility="{Binding IsVertical, Converter={x:Static local:DockConverters.InverseBoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" Style="{StaticResource DockSideColumnStyle}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" Style="{StaticResource DockSideColumnStyle}"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Bölüm (Windows düzeninde): pencere öğeleri, ortada hizada en solda (Windows 11 hava durumu) -->
                <local:DockWeatherWidget Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                         Visibility="{Binding Taskbar.ShowWidgetsLeading, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>

                <!-- Sol Bölüm (eski düzen): Windows Başlat Düğmesi + Çalan Müzik Hapı -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowLegacyLeftSection, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                    <!-- Windows Başlat Düğmesi -->
                    <Button Style="{StaticResource DockFlatButtonStyle}"
                            Command="{Binding StartMenuCommand}"
                            ToolTip="{x:Static res:Strings.StartMenu}"
                            MouseRightButtonUp="OnStartRightClick"
                            Width="36"
                            Height="34"
                            Margin="0,0,6,0"
                            Visibility="{Binding ShowStartButton, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <Image Source="{Binding StartIcon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <!-- Çalan Müzik Hapı (Yalnız medya etkinken görünür) -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Background="{DynamicResource KoyDockPill}"
                            CornerRadius="8"
                            Padding="6,4"
                            MouseLeftButtonUp="OnNowPlayingClick"
                            ToolTip="{Binding [DockNowPlayingTooltip], Source={x:Static res:Loc.Instance}}"
                            Visibility="{Binding ShowNowPlayingPill, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Albüm Kapağı -->
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="5"
                                    Background="{DynamicResource KoyDockCover}"
                                    Margin="0,0,8,0">
                                <Image Source="{Binding NowPlayingCover}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Width="24"
                                       Height="24"
                                       Visibility="{Binding NowPlayingCover, Converter={x:Static local:DockConverters.NotNullToVisibleConverter}}"/>
                            </Border>
                            <!-- Şarkı Adı ve Sanatçı -->
                            <StackPanel VerticalAlignment="Center" MaxWidth="170">
                                <TextBlock Text="{Binding NowPlayingTitle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource KoyDockText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NowPlayingArtist}"
                                           FontSize="10"
                                           Foreground="{DynamicResource KoyDockTextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Orta Bölüm: uygulamalar, kapsülle aynı şerit ve göstergeler -->
                <!-- Windows düzeninde bu grup (Başlat, Ara, Görev görünümü, uygulamalar, sol hizada pencere öğeleri) birlikte hizalanır:
                     Orta'da ekranın ortasında (yan sütunlar eşit), Sol'da sola yaslı. Eski düzende yalnız uygulama şeridi kalır. -->
                <Grid Grid.Column="1" SizeChanged="OnCenterSizeChanged">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding CenterGroupAlignment}" VerticalAlignment="Center">
                        <!-- Başlat: Windows Başlat menüsü (Win tuşu), Windows 11 logosu; sağ tık Win+X menüsü. Koy menüsü sağ tık menüsünde. -->
                        <Button Style="{StaticResource DockPillButtonStyle}" Width="40" Padding="0"
                                Command="{Binding StartMenuCommand}"
                                ToolTip="{x:Static res:Strings.StartMenu}"
                                AutomationProperties.Name="{x:Static res:Strings.StartMenu}"
                                MouseRightButtonUp="OnStartRightClick"
                                Visibility="{Binding Taskbar.ShowStart, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <Image Source="{Binding StartIcon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <!-- Ara: Windows arama (Win+S). Windows 11 "Arama" ayarı: Arama kutusu (büyüteç ve "Ara"), Arama simgesi ve etiketi,
                             Yalnız arama simgesi; Gizle'de hiçbiri görünmez. -->
                        <Button Style="{StaticResource DockPillButtonStyle}" Width="128" Padding="4,0"
                                Command="{Binding OpenSearchCommand}"
                                ToolTip="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}"
                                Visibility="{Binding Taskbar.ShowSearchBox, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <Border CornerRadius="16" Height="32" Width="116" Background="{DynamicResource KoyDockPill}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource KoyDockGlyph}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}" FontSize="12.5" Margin="8,0,0,0"
                                               Foreground="{DynamicResource KoyDockClockText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource DockPillButtonStyle}" Width="80" Padding="0"
                                Command="{Binding OpenSearchCommand}"
                                ToolTip="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}"
                                Visibility="{Binding Taskbar.ShowSearchLabel, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource KoyDockGlyph}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}" FontSize="12.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource KoyDockClockText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DockPillButtonStyle}" Width="40" Padding="0"
                                Command="{Binding OpenSearchCommand}"
                                ToolTip="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [DockSearchBox], Source={x:Static res:Loc.Instance}}"
                                Visibility="{Binding Taskbar.ShowSearchIconOnly, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource KoyDockGlyph}"/>
                        </Button>

                        <!-- Görev görünümü: Win+Tab -->
                        <Button Style="{StaticResource DockPillButtonStyle}" Width="40" Padding="0"
                                Command="{Binding OpenTaskViewCommand}"
                                ToolTip="{Binding [DockTaskView], Source={x:Static res:Loc.Instance}}"
                                AutomationProperties.Name="{Binding [DockTaskView], Source={x:Static res:Loc.Instance}}"
                                Visibility="{Binding Taskbar.ShowTaskView, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource KoyDockGlyph}"/>
                        </Button>

                        <local:DockItemsStrip HorizontalAlignment="{Binding StripAlignment}" VerticalAlignment="Center"/>

                        <!-- Sol hizada pencere öğeleri uygulamaların sağına geçer (yalnız simge ve sıcaklık) -->
                        <local:DockWeatherWidget IsCompact="True" VerticalAlignment="Center" Margin="4,0,0,0"
                                                 Visibility="{Binding Taskbar.ShowWidgetsAfterItems, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Sağ Bölüm: Windows 11 sistem alanı (taşma oku, tepsi simgeleri, Wi-Fi + ses + pil, saat, zil, masaüstünü göster).
                     Windows'ta olmayan düğmeler (İndirilenler, Son kullanılanlar, Koy menüsü) tam genişlikte yoktur; Koy menüsüne
                     sağ tık menüsünden ulaşılır. Sistem alanı çizilmiyorsa (Status yok) eski düğmeler kalır. -->
                <local:DockSystemAreaControl Grid.Column="2"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Stretch"
                                      Visibility="{Binding ShowSystemArea, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowLegacyRightSection, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                    <Button Style="{StaticResource DockFlatButtonStyle}"
                            Command="{Binding OpenDownloadsCommand}"
                            ToolTip="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                            AutomationProperties.Name="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                            Width="36"
                            Height="34"
                            Margin="1,0"
                            Visibility="{Binding ShowFolders, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <!-- Klasör çizimi 3..25 x 6..23 aralığında: tuval merkezi buna göre -->
                        <Canvas Width="28" Height="29">
                            <Path Fill="#3B82F6" Data="M 3,8 C 3,6.8 3.8,6 5,6 H 10 L 12,8 H 23 C 24.1,8 25,8.8 25,10 V 21 C 25,22.1 24.1,23 23,23 H 5 C 3.8,23 3,22.1 3,21 Z"/>
                            <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,11 V 17 M 11,14 L 14,17 L 17,14"/>
                        </Canvas>
                    </Button>
                    <recents:RecentsButton/>
                    <tray:TrayButton/>
                    <Rectangle Width="1"
                               Height="24"
                               Fill="{DynamicResource KoyDockSeparator}"
                               Margin="4,0"
                               Visibility="{Binding ShowRightSection, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource DockFlatButtonStyle}"
                            Command="{Binding OpenKoyMenuCommand}"
                            ToolTip="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                            AutomationProperties.Name="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                            Width="36"
                            Height="34"
                            Margin="1,0">
                        <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <tray:TrayButton IsCompact="True"/>
                </StackPanel>
            </Grid>

            <!-- 2. Dikey Düzen (Sol ve Sağ Kenar) -->
            <Grid Grid.IsSharedSizeScope="True"
                  Visibility="{Binding IsVertical, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" Style="{StaticResource DockSideRowStyle}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto" Style="{StaticResource DockSideRowStyle}"/>
                </Grid.RowDefinitions>

                <!-- Üst Bölüm: Windows Başlat Düğmesi + Çalan Müzik Albüm Kapağı -->
                <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center">
                    <Button Style="{StaticResource DockFlatButtonStyle}"
                            Command="{Binding StartMenuCommand}"
                            ToolTip="{x:Static res:Strings.StartMenu}"
                            MouseRightButtonUp="OnStartRightClick"
                            Width="34"
                            Height="36"
                            Margin="0,0,0,6"
                            Visibility="{Binding ShowStartButton, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <Image Source="{Binding StartIcon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Cursor="Hand"
                            Background="{DynamicResource KoyDockPill}"
                            CornerRadius="6"
                            Padding="4"
                            Margin="0,2,0,0"
                            MouseLeftButtonUp="OnNowPlayingClick"
                            ToolTip="{Binding [DockNowPlayingTooltip], Source={x:Static res:Loc.Instance}}"
                            Visibility="{Binding HasNowPlaying, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <Border Width="24"
                                Height="24"
                                CornerRadius="4"
                                Background="{DynamicResource KoyDockCover}">
                            <Image Source="{Binding NowPlayingCover}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Width="24"
                                   Height="24"
                                   Visibility="{Binding NowPlayingCover, Converter={x:Static local:DockConverters.NotNullToVisibleConverter}}"/>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- Orta Bölüm: uygulamalar şeridi -->
                <Grid Grid.Row="1" SizeChanged="OnCenterSizeChanged">
                    <local:DockItemsStrip VerticalAlignment="{Binding VerticalStripAlignment}" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Alt Bölüm: İndirilenler, Son kullanılanlar, Tepsi, Ayırıcı, Menü -->
                <StackPanel Grid.Row="2"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <Button Style="{StaticResource DockFlatButtonStyle}"
                            Command="{Binding OpenDownloadsCommand}"
                            ToolTip="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                            AutomationProperties.Name="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                            Width="34"
                            Height="36"
                            Margin="0,1"
                            Visibility="{Binding ShowFolders, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                        <Canvas Width="28" Height="29">
                            <Path Fill="#3B82F6" Data="M 3,8 C 3,6.8 3.8,6 5,6 H 10 L 12,8 H 23 C 24.1,8 25,8.8 25,10 V 21 C 25,22.1 24.1,23 23,23 H 5 C 3.8,23 3,22.1 3,21 Z"/>
                            <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,11 V 17 M 11,14 L 14,17 L 17,14"/>
                        </Canvas>
                    </Button>
                    <recents:RecentsButton/>
                    <tray:TrayButton/>
                    <Rectangle Width="24"
                               Height="1"
                               Fill="{DynamicResource KoyDockSeparator}"
                               Margin="0,4"
                               Visibility="{Binding ShowRightSection, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource DockFlatButtonStyle}"
                            Command="{Binding OpenKoyMenuCommand}"
                            ToolTip="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                            AutomationProperties.Name="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                            Width="34"
                            Height="36"
                            Margin="0,1">
                        <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <tray:TrayButton IsCompact="True"/>
                </StackPanel>
            </Grid>
            </Grid>

            <Border BorderBrush="{Binding FullWidthBorderBrush}"
                    BorderThickness="{Binding FullWidthBorderThickness}"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True"/>
        </Grid>
    </Border>
</UserControl>
