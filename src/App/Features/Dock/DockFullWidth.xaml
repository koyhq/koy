<UserControl x:Class="Koy.App.Features.Dock.DockFullWidth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:local="clr-namespace:Koy.App.Features.Dock"
             xmlns:tray="clr-namespace:Koy.App.Features.Dock.Tray"
             xmlns:recents="clr-namespace:Koy.App.Features.Dock.Recents"
             xmlns:folder="clr-namespace:Koy.App.Features.Dock.Folder">

    <UserControl.Resources>
        <!-- Ortada yan sütunlar eşit: ikonlar ekranın tam ortasında kalır. Sola/sağa hizada serbest bırakılır,
             yoksa dar sütundaki boşluk ikonlarla Başlat ya da sağ düğmeler arasına girer. -->
        <Style x:Key="DockSideColumnStyle" TargetType="ColumnDefinition">
            <Setter Property="SharedSizeGroup" Value="DockSide"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StripAlignment}" Value="Left">
                    <Setter Property="SharedSizeGroup" Value="{x:Null}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StripAlignment}" Value="Right">
                    <Setter Property="SharedSizeGroup" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Windows tarzı tam genişlik: yükseklik DockPositionResolver.FullWidthHeightDip (48), ekran kenarına sıfır boşluk,
         köşe yuvarlaması yok, üstte ince parıltı çizgisi. Yüzey Material ayarına uyar (yarı saydam ya da opak; DockViewModel.FullWidthSurface). -->
    <Border Background="{Binding FullWidthSurface}"
            BorderBrush="#26FFFFFF"
            BorderThickness="0,1,0,0"
            Height="{Binding DockHeight}"
            Padding="12,0"
            SnapsToDevicePixels="True">
        <!-- Yan sütunlar içerik kadar; orta hizada birbirine eşit (DockSideColumnStyle). Orta bölüm yanlara taşmaz. -->
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" Style="{StaticResource DockSideColumnStyle}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" Style="{StaticResource DockSideColumnStyle}"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Bölüm: Windows Başlat Düğmesi + Çalan Müzik Hapı -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Windows Başlat Düğmesi -->
                <Button Style="{StaticResource DockFlatButtonStyle}"
                        Command="{Binding StartMenuCommand}"
                        ToolTip="{x:Static res:Strings.StartMenu}"
                        Width="36"
                        Height="34"
                        Margin="0,0,6,0"
                        Visibility="{Binding ShowStartButton, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                    <Image Source="{Binding StartIcon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <!-- Çalan Müzik Hapı (Yalnız medya etkinken görünür) -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Background="#14FFFFFF"
                        CornerRadius="8"
                        Padding="6,4"
                        MouseLeftButtonUp="OnNowPlayingClick"
                        ToolTip="{Binding [DockNowPlayingTooltip], Source={x:Static res:Loc.Instance}}"
                        Visibility="{Binding HasNowPlaying, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Albüm Kapağı -->
                        <Border Width="24"
                                Height="24"
                                CornerRadius="5"
                                Background="#27272A"
                                Margin="0,0,8,0">
                            <Image Source="{Binding NowPlayingCover}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Width="24"
                                   Height="24"
                                   Visibility="{Binding NowPlayingCover, Converter={x:Static local:DockConverters.NotNullToVisibleConverter}}"/>
                        </Border>
                        <!-- Şarkı Adı ve Sanatçı -->
                        <StackPanel VerticalAlignment="Center" MaxWidth="170">
                            <TextBlock Text="{Binding NowPlayingTitle}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F4F5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NowPlayingArtist}"
                                       FontSize="10"
                                       Foreground="#A1A1AA"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Orta Bölüm: uygulamalar, kapsülle aynı şerit ve göstergeler -->
            <Grid Grid.Column="1" SizeChanged="OnCenterSizeChanged">
                <local:DockItemsStrip HorizontalAlignment="{Binding StripAlignment}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Sağ Bölüm: İndirilenler, Son kullanılanlar, Tepsi | Koy menüsü, küçük tepsi (ayarlar kapsülle aynı) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource DockFlatButtonStyle}"
                        Command="{Binding OpenDownloadsCommand}"
                        ToolTip="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                        Width="36"
                        Height="34"
                        Margin="1,0"
                        Visibility="{Binding ShowFolders, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                    <!-- Klasör çizimi 3..25 x 6..23 aralığında: tuval merkezi buna göre -->
                    <Canvas Width="28" Height="29">
                        <Path Fill="#3B82F6" Data="M 3,8 C 3,6.8 3.8,6 5,6 H 10 L 12,8 H 23 C 24.1,8 25,8.8 25,10 V 21 C 25,22.1 24.1,23 23,23 H 5 C 3.8,23 3,22.1 3,21 Z"/>
                        <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,11 V 17 M 11,14 L 14,17 L 17,14"/>
                    </Canvas>
                </Button>
                <recents:RecentsButton/>
                <tray:TrayButton/>
                <Rectangle Width="1"
                           Height="24"
                           Fill="#29FFFFFF"
                           Margin="4,0"
                           Visibility="{Binding ShowRightSection, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>
                <Button Style="{StaticResource DockFlatButtonStyle}"
                        Command="{Binding OpenKoyMenuCommand}"
                        ToolTip="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                        Width="36"
                        Height="34"
                        Margin="1,0">
                    <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <tray:TrayButton IsCompact="True"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
