<UserControl x:Class="Koy.App.Features.Dock.DockWeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Koy.App.Features.Dock"
             xmlns:status="clr-namespace:Koy.App.Features.Status"
             Focusable="False">

    <!-- Windows 11 pencere öğeleri düğmesi (hava durumu). Ortada hizada en solda iki satır (sıcaklık, kısa açıklama); sol hizada
         uygulamaların sağında yalnız simge ve sıcaklık (IsCompact). Konum yoksa ya da veri gelmediyse yalnız simge. Veri
         DockWeatherViewModel'den (DockViewModel.Weather); tıklayınca Win+W. -->
    <Button Style="{StaticResource DockPillButtonStyle}" Padding="6,0" Height="40"
            Command="{Binding Weather.OpenWidgetsCommand}"
            ToolTip="{Binding Weather.Tooltip}"
            AutomationProperties.Name="{Binding Weather.Tooltip}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                <status:WeatherGlyph DataContext="{Binding Weather}"/>
            </Viewbox>
            <StackPanel x:Name="TextBlockPanel" Margin="8,0,2,0" VerticalAlignment="Center" MaxWidth="120"
                        Visibility="{Binding Weather.HasWeather, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Weather.TemperatureText}" FontSize="12" Foreground="{DynamicResource KoyDockClockText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DescriptionText" Text="{Binding Weather.Description}" FontSize="12" Foreground="{DynamicResource KoyDockClockText}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </Button>
</UserControl>
