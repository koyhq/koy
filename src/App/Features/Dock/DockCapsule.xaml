<UserControl x:Class="Koy.App.Features.Dock.DockCapsule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:local="clr-namespace:Koy.App.Features.Dock"
             xmlns:tray="clr-namespace:Koy.App.Features.Dock.Tray"
             xmlns:recents="clr-namespace:Koy.App.Features.Dock.Recents"
             xmlns:folder="clr-namespace:Koy.App.Features.Dock.Folder">

    <!-- Seelen UI Yüzen Kapsül Tabanı: 60 px yükseklik (aşağı yapışınca 46 px), 18 px köşe yuvarlama (yapışınca 14,14,0,0) -->
    <Border Background="{Binding CapsuleSurface}"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            CornerRadius="{Binding CapsuleCornerRadius}"
            Width="{Binding CapsuleWidth}"
            Height="{Binding CapsuleHeight}"
            Padding="{Binding InnerPadding}"
            Margin="{Binding DockMargin}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Direction="270"
                              Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="{Binding StripOrientation}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- 1. Windows Başlat Düğmesi -->
            <Button Style="{StaticResource DockFlatButtonStyle}"
                    Command="{Binding StartMenuCommand}"
                    ToolTip="{x:Static res:Strings.StartMenu}"
                    MouseRightButtonUp="OnStartRightClick"
                    Width="{Binding ItemSize}"
                    Height="{Binding ItemSize}"
                    Margin="{Binding SlotMargin}"
                    Visibility="{Binding ShowStartButton, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                <Image Source="{Binding StartIcon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>

            <!-- 2. Dock Uygulama Öğeleri Listesi (ortak şerit) -->
            <local:DockItemsStrip/>

            <!-- 3. Dikey/Yatay Ayırıcı 1 -->
            <Rectangle Width="{Binding SeparatorWidth}"
                       Height="{Binding SeparatorHeight}"
                       Fill="#29FFFFFF"
                       Margin="{Binding SeparatorMargin}"
                       Visibility="{Binding ShowRightSection, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}"/>

            <!-- 4. Klasörler Bölümü -->
            <StackPanel Orientation="{Binding StripOrientation}"
                        Visibility="{Binding ShowFolders, Converter={x:Static local:DockConverters.BoolToVisibilityConverter}}">
                <!-- İndirilenler Klasörü Düğmesi -->
                <Button Style="{StaticResource DockFlatButtonStyle}"
                        Command="{Binding OpenDownloadsCommand}"
                        ToolTip="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [DockDownloads], Source={x:Static res:Loc.Instance}}"
                        Width="{Binding ItemSize}"
                        Height="{Binding ItemSize}"
                        Margin="{Binding SlotMargin}">
                    <!-- Klasör çizimi 3..25 x 6..23 aralığında: tuval merkezi buna göre -->
                    <Canvas Width="28" Height="29">
                        <Path Fill="#3B82F6" Data="M 3,8 C 3,6.8 3.8,6 5,6 H 10 L 12,8 H 23 C 24.1,8 25,8.8 25,10 V 21 C 25,22.1 24.1,23 23,23 H 5 C 3.8,23 3,22.1 3,21 Z"/>
                        <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,11 V 17 M 11,14 L 14,17 L 17,14"/>
                    </Canvas>
                </Button>

            </StackPanel>

            <!-- 4b. Sistem Tepsisi: Windows görev çubuğu gizli olduğu için arka plan uygulamalarının simgeleri burada -->
            <recents:RecentsButton/>
            <tray:TrayButton/>

            <!-- 5. Dikey/Yatay Ayırıcı 2 -->
            <Rectangle Width="{Binding SeparatorWidth}"
                       Height="{Binding SeparatorHeight}"
                       Fill="#29FFFFFF"
                       Margin="{Binding SeparatorMargin}"/>

            <!-- 6. Koy Sistem Menüsü Düğmesi -->
            <Button Style="{StaticResource DockFlatButtonStyle}"
                    Command="{Binding OpenKoyMenuCommand}"
                    ToolTip="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                    AutomationProperties.Name="{Binding [DockKoyMenu], Source={x:Static res:Loc.Instance}}"
                    Width="{Binding ItemSize}"
                    Height="{Binding ItemSize}"
                    Margin="{Binding SlotMargin}">
                <!-- Koy Marka Logosu: Windows 11 Fluent Squircle + Çentik + K -->
                <Path Fill="{DynamicResource KoyAccent}" Data="{StaticResource KoyLogoGeometry}" Width="18" Height="18" Stretch="Uniform"/>
            </Button>

            <!-- 7. Küçük tepsi: Koy menüsü düğmesinin sağında dar ok -->
            <tray:TrayButton IsCompact="True"/>
        </StackPanel>
    </Border>
</UserControl>
