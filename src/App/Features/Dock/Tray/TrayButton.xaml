<UserControl x:Class="Koy.App.Features.Dock.Tray.TrayButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:dock="clr-namespace:Koy.App.Features.Dock"
             xmlns:tray="clr-namespace:Koy.App.Features.Dock.Tray"
             Visibility="{Binding ShowFullTray, Converter={x:Static dock:DockConverters.BoolToVisibilityConverter}}">

    <Grid>
        <!-- Tepsi düğmesi: yukarı ok. Pencere açıkken tıklanamaz; dışarı tıklama pencereyi kapatır ve aynı tıklama yeniden açmaz. -->
        <Button x:Name="TrayToggle"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Command="{Binding ToggleTrayCommand}"
                ToolTip="{Binding [SystemTray], Source={x:Static res:Loc.Instance}}"
                AutomationProperties.Name="{Binding [SystemTray], Source={x:Static res:Loc.Instance}}"
                Width="{Binding ItemSize}"
                Height="{Binding ItemSize}"
                Margin="1,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                IsHitTestVisible="{Binding IsOpen, ElementName=TrayPopup, Converter={x:Static dock:DockConverters.InverseBoolConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="Transparent"
                            CornerRadius="10">
                        <res:KoyIcon x:Name="chevron"
                                     Data="{DynamicResource IconChevronUp}"
                                     Size="16"
                                     StrokeWidth="2.2"
                                     Foreground="{DynamicResource KoyNotchTextSecondary}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Küçük tepsi: dar ok, simge de küçülür -->
                        <Trigger Property="Tag" Value="compact">
                            <Setter TargetName="chevron" Property="Size" Value="12"/>
                            <Setter TargetName="border" Property="CornerRadius" Value="6"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource KoyNotchHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource KoyNotchPressed}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsTrayPopupOpen}" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource KoyNotchActive}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Tepsi penceresi: uygulamaların gerçek simgeleri; sol ve sağ tık uygulamaya iletilir.
             IsOpen koddan yönetilir: gizli dock biçimindeki düğmenin penceresi açılmasın. -->
        <!-- StaysOpen=True: pencere odak kaybıyla (uygulamanın menüsü öne gelince) kapanmaz. Kapanışı kod yönetir:
             dış tıklama ya da menüden seçim (TrayPopupDismissPolicy), kısa Spring animasyonuyla. -->
        <Popup x:Name="TrayPopup"
               PlacementTarget="{Binding ElementName=TrayToggle}"
               Placement="Top"
               VerticalOffset="-6"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None">
            <Border x:Name="PopupBody"
                    RenderTransformOrigin="0.5,1"
                    Background="{DynamicResource KoyMenuBg}"
                    BorderBrush="{DynamicResource KoyMenuBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="8"
                    Margin="12"
                    SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PopupScale"/>
                        <TranslateTransform x:Name="PopupShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="4"
                                      Opacity="0.45"
                                      Direction="270"
                                      Color="{StaticResource KoyShadowColor}"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding [SystemTray], Source={x:Static res:Loc.Instance}}"
                               FontSize="11"
                               Foreground="{DynamicResource KoyMenuTextMuted}"
                               Margin="4,0,4,6"/>

                    <ItemsControl ItemsSource="{Binding TrayIcons}"
                                  MaxWidth="216">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tray:TrayIconViewModel}">
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        ToolTip="{Binding Tooltip}"
                                        AutomationProperties.Name="{Binding Tooltip}"
                                        MouseLeftButtonDown="OnIconLeftButtonDown"
                                        MouseLeftButtonUp="OnIconLeftButtonUp"
                                        MouseRightButtonUp="OnIconRightButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource KoyMenuHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- Uygulamalar tepsi simgesini sistemin küçük simge boyutunda verir (%100'de 16 px).
                                         Windows tepsisi gibi 16 DIP gösterilir: büyütülmez, piksel ızgarasına oturur, bulanıklaşmaz. -->
                                    <Image Source="{Binding Icon}"
                                           Width="16"
                                           Height="16"
                                           Stretch="Uniform"
                                           UseLayoutRounding="True"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding [TrayEmpty], Source={x:Static res:Loc.Instance}}"
                               FontSize="12"
                               Foreground="{DynamicResource KoyMenuTextMuted}"
                               Margin="4,2,4,2"
                               Visibility="{Binding HasTrayIcons, Converter={x:Static dock:DockConverters.InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
