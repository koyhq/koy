<UserControl x:Class="Koy.App.Features.Search.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Koy.App.Features.Search"
             xmlns:res="clr-namespace:Koy.App.Resources">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:SearchGlyphConverter x:Key="GlyphGeometry" />

    <Style x:Key="SearchToolButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SearchActionButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Padding="8,3" Background="{DynamicResource KoyNotchHover}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchAccentFocus}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Arama çubuğu -->
    <Border Grid.Row="0" CornerRadius="14" Background="{DynamicResource KoyNotchChip}" Padding="6,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource SearchToolButton}" Command="{Binding ToggleHelpCommand}"
                ToolTip="{Binding [SearchHelpTip], Source={x:Static res:Loc.Instance}}"
                AutomationProperties.Name="{Binding [SearchHelpTip], Source={x:Static res:Loc.Instance}}">
          <res:KoyIcon Data="{Binding Source={x:Static local:SearchPanel.HelpGlyph}, Converter={StaticResource GlyphGeometry}}" Size="16" Foreground="{DynamicResource KoyNotchTextSecondary}" />
        </Button>

        <Grid Grid.Column="1" Margin="6,0">
          <TextBlock Text="{Binding [SearchPlaceholder], Source={x:Static res:Loc.Instance}}" FontSize="15" Margin="2,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource KoyNotchMuted}" IsHitTestVisible="False"
                     Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding SuggestionText}" FontSize="15" Margin="2,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                     Foreground="{DynamicResource KoyNotchText}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="Box" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="15" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0"
                   Foreground="{DynamicResource KoyNotchText}" CaretBrush="{DynamicResource KoyNotchText}"
                   FocusVisualStyle="{x:Null}" MaxLength="256"
                   AutomationProperties.Name="{Binding [SearchPlaceholder], Source={x:Static res:Loc.Instance}}"
                   PreviewKeyDown="Box_PreviewKeyDown" TextChanged="Box_TextChanged" />
        </Grid>

        <Button Grid.Column="2" Style="{StaticResource SearchToolButton}" Command="{Binding ToggleHistoryCommand}"
                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}"
                ToolTip="{Binding [SearchHistoryTip], Source={x:Static res:Loc.Instance}}"
                AutomationProperties.Name="{Binding [SearchHistoryTip], Source={x:Static res:Loc.Instance}}">
          <res:KoyIcon Data="{DynamicResource IconChevronDown}" Size="16" Foreground="{DynamicResource KoyNotchTextSecondary}" />
        </Button>
        <Button Grid.Column="3" Style="{StaticResource SearchToolButton}" Command="{Binding OpenSettingsCommand}"
                ToolTip="{Binding [SearchConfigureTip], Source={x:Static res:Loc.Instance}}"
                AutomationProperties.Name="{Binding [SearchConfigureTip], Source={x:Static res:Loc.Instance}}">
          <res:KoyIcon Data="{DynamicResource IconSettings}" Size="16" Foreground="{DynamicResource KoyNotchTextSecondary}" />
        </Button>
        <Button Grid.Column="4" Style="{StaticResource SearchToolButton}" Command="{Binding TogglePinCommand}"
                ToolTip="{Binding [SearchPinTip], Source={x:Static res:Loc.Instance}}"
                AutomationProperties.Name="{Binding [SearchPinTip], Source={x:Static res:Loc.Instance}}">
          <res:KoyIcon Data="{DynamicResource IconPin}" Size="16">
            <res:KoyIcon.Style>
              <Style TargetType="res:KoyIcon">
                <Setter Property="Foreground" Value="{DynamicResource KoyNotchTextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource KoyNotchAccentFocus}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </res:KoyIcon.Style>
          </res:KoyIcon>
        </Button>
      </Grid>
    </Border>

    <!-- Boş durum -->
    <TextBlock Grid.Row="1" Text="{Binding [SearchEmptyHint], Source={x:Static res:Loc.Instance}}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{DynamicResource KoyNotchMuted}" Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}" />
    <TextBlock Grid.Row="1" Text="{Binding [SearchSearching], Source={x:Static res:Loc.Instance}}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{DynamicResource KoyNotchMuted}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />

    <!-- Sonuçlar: en çok 15 satır; sığmayanlara kaydırılır -->
    <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl x:Name="ResultList" ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:SearchRowViewModel}">
            <StackPanel>
              <TextBlock Text="{Binding Header}" FontSize="10.5" FontWeight="SemiBold" Margin="8,6,0,3" Foreground="{DynamicResource KoyNotchMuted}"
                         Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}" />
              <Border x:Name="Row" CornerRadius="12" Padding="8,4" MinHeight="38" Background="Transparent" Cursor="Hand"
                      PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown"
                      MouseMove="Row_MouseMove"
                      MouseLeftButtonUp="Row_MouseLeftButtonUp">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <res:KoyIcon Data="{Binding Glyph, Converter={StaticResource GlyphGeometry}}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource KoyNotchTextSecondary}" />
                    <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                  </Grid>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource KoyNotchText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource KoyNotchMuted}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="64"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>

                  <ItemsControl Grid.Column="2" ItemsSource="{Binding Actions}" Focusable="False" VerticalAlignment="Center"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:SearchActionViewModel}">
                        <Button Style="{StaticResource SearchActionButton}" Click="RowAction_Click">
                          <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource KoyNotchText}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </StackPanel>
            <DataTemplate.Triggers>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource KoyNotchHover}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource KoyNotchChip}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
