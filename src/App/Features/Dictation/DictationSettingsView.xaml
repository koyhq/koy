<UserControl x:Class="Koy.App.Features.Dictation.DictationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Koy.App.Resources"
             xmlns:vm="clr-namespace:Koy.App.Features.Dictation">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>


    <StackPanel>
        <TextBlock Text="{Binding [DictSecGeneral], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictEnabledTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictEnabledDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictEnabledTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding Enabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictBaseUrlTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictBaseUrlDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictBaseUrlTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictApiKeyTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictApiKeyDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <PasswordBox x:Name="KeyBox" Margin="0,8,0,0" Height="32" AutomationProperties.Name="{Binding [DictApiKeyTitle], Source={x:Static res:Loc.Instance}}" PasswordChanged="KeyBox_PasswordChanged" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictModelTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictModelDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictModelTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding TranscribeModel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictBackupModelTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictBackupModelDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictBackupModelTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding BackupModel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictLanguageTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictLanguageDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictLanguageTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding [DictSecCleanup], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictCleanupTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictCleanupDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictCleanupTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding CleanupEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictCleanupModelTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictCleanupModelDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictCleanupModelTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding CleanupModel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictCleanupUrlTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictCleanupUrlDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictCleanupUrlTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding CleanupBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictCleanupPromptTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictCleanupPromptDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictCleanupPromptTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding CleanupPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding [DictSecTyping], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictAutoPasteTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictAutoPasteDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictAutoPasteTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding AutoPaste}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictRestoreTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictRestoreDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictRestoreTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding RestoreClipboard}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictCuesTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictCuesDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictCuesTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding AudioCues}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictMaxSecondsTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictMaxSecondsDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictMaxSecondsTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding MaxSeconds, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictHistoryLimitTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictHistoryLimitDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                <TextBox Margin="0,8,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictHistoryLimitTitle], Source={x:Static res:Loc.Instance}}" Text="{Binding HistoryLimit, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding [DictSecSilence], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictSkipSilentTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictSkipSilentDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictSkipSilentTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding SkipSilent}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictHallucinationTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictHallucinationDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictHallucinationTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding FilterHallucinations}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <TextBlock Text="{Binding [DictSecProfiles], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictProfileByAppTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictProfileByAppDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictProfileByAppTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding ProfileByApp}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictTranslationTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictTranslationDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictTranslationTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding TranslationEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictProfileOverrideTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictProfileOverrideDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="180" Height="32" HorizontalAlignment="Right" AutomationProperties.Name="{Binding [DictProfileOverrideTitle], Source={x:Static res:Loc.Instance}}"
                          ItemsSource="{Binding ProfileChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ProfileOverride}"
                          Style="{StaticResource SettingComboBoxStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictDefaultProfile], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <TextBlock Text="{Binding [DictProfileTranslate], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfileTranslate], Source={x:Static res:Loc.Instance}}" Text="{Binding DefaultProfile.TranslateTo, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding [DictProfileFormality], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfileFormality], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding DefaultProfile.Formality}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptFormal], Source={x:Static res:Loc.Instance}}" Tag="formal" />
                    <ComboBoxItem Content="{Binding [DictOptCasual], Source={x:Static res:Loc.Instance}}" Tag="casual" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfileSentence], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfileSentence], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding DefaultProfile.SentenceLength}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptShort], Source={x:Static res:Loc.Instance}}" Tag="short" />
                    <ComboBoxItem Content="{Binding [DictOptLong], Source={x:Static res:Loc.Instance}}" Tag="long" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfilePunctuation], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfilePunctuation], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding DefaultProfile.Punctuation}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptMinimal], Source={x:Static res:Loc.Instance}}" Tag="minimal" />
                    <ComboBoxItem Content="{Binding [DictOptFull], Source={x:Static res:Loc.Instance}}" Tag="full" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfileBrevity], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfileBrevity], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding DefaultProfile.Brevity}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptBrief], Source={x:Static res:Loc.Instance}}" Tag="brief" />
                    <ComboBoxItem Content="{Binding [DictOptDetailed], Source={x:Static res:Loc.Instance}}" Tag="detailed" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfileCustom], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfileCustom], Source={x:Static res:Loc.Instance}}" Text="{Binding DefaultProfile.Custom, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictProfileSelect], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                <ComboBox Margin="0,8,0,0" Height="32" AutomationProperties.Name="{Binding [DictProfileSelect], Source={x:Static res:Loc.Instance}}" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProfile}" Style="{StaticResource SettingComboBoxStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{Binding [DictProfileAdd], Source={x:Static res:Loc.Instance}}" Command="{Binding AddProfileCommand}" Style="{StaticResource SettingButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding [DictProfileRemove], Source={x:Static res:Loc.Instance}}" Command="{Binding RemoveProfileCommand}" Style="{StaticResource SettingButtonStyle}"
                            IsEnabled="{Binding HasProfile}" />
                </StackPanel>
                <StackPanel DataContext="{Binding SelectedProfile}">
                <TextBlock Text="{Binding [DictProfileName], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfileName], Source={x:Static res:Loc.Instance}}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding [DictProfilePrograms], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfilePrograms], Source={x:Static res:Loc.Instance}}" Text="{Binding Programs, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding [DictProfileSites], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfileSites], Source={x:Static res:Loc.Instance}}" Text="{Binding Sites, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding [DictProfileTranslate], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfileTranslate], Source={x:Static res:Loc.Instance}}" Text="{Binding TranslateTo, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding [DictProfileFormality], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfileFormality], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding Formality}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptFormal], Source={x:Static res:Loc.Instance}}" Tag="formal" />
                    <ComboBoxItem Content="{Binding [DictOptCasual], Source={x:Static res:Loc.Instance}}" Tag="casual" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfileSentence], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfileSentence], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding SentenceLength}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptShort], Source={x:Static res:Loc.Instance}}" Tag="short" />
                    <ComboBoxItem Content="{Binding [DictOptLong], Source={x:Static res:Loc.Instance}}" Tag="long" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfilePunctuation], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfilePunctuation], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding Punctuation}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptMinimal], Source={x:Static res:Loc.Instance}}" Tag="minimal" />
                    <ComboBoxItem Content="{Binding [DictOptFull], Source={x:Static res:Loc.Instance}}" Tag="full" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfileBrevity], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <ComboBox Margin="0,4,0,0" Height="32" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="{Binding [DictProfileBrevity], Source={x:Static res:Loc.Instance}}" SelectedValuePath="Tag" SelectedValue="{Binding Brevity}"
                          Style="{StaticResource SettingComboBoxStyle}">
                    <ComboBoxItem Content="{Binding [DictOptAny], Source={x:Static res:Loc.Instance}}" Tag="" />
                    <ComboBoxItem Content="{Binding [DictOptBrief], Source={x:Static res:Loc.Instance}}" Tag="brief" />
                    <ComboBoxItem Content="{Binding [DictOptDetailed], Source={x:Static res:Loc.Instance}}" Tag="detailed" />
                </ComboBox>
                <TextBlock Text="{Binding [DictProfileCustom], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,10,0,0" />
                <TextBox Margin="0,4,0,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictProfileCustom], Source={x:Static res:Loc.Instance}}" Text="{Binding Custom, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding [DictSecDictionary], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding [DictLearningTitle], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingTitleStyle}" />
                    <TextBlock Text="{Binding [DictLearningDesc], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" />
                </StackPanel>
                <CheckBox Grid.Column="1" AutomationProperties.Name="{Binding [DictLearningTitle], Source={x:Static res:Loc.Instance}}" IsChecked="{Binding DictionaryLearning}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Style="{StaticResource ToggleSwitchStyle}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictTermPlaceholder], Source={x:Static res:Loc.Instance}}"
                             ToolTip="{Binding [DictTermPlaceholder], Source={x:Static res:Loc.Instance}}" Text="{Binding NewTerm, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SettingTextBoxStyle}" AutomationProperties.Name="{Binding [DictHeardPlaceholder], Source={x:Static res:Loc.Instance}}"
                             ToolTip="{Binding [DictHeardPlaceholder], Source={x:Static res:Loc.Instance}}" Text="{Binding NewHeard, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="{Binding [DictAdd], Source={x:Static res:Loc.Instance}}" Command="{Binding AddTermCommand}" Style="{StaticResource SettingButtonStyle}" />
                </Grid>
                <TextBlock Text="{Binding [DictNoTerms], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="0,8,0,0"
                           Visibility="{Binding HasNoTerms, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Terms}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Term}" Style="{StaticResource SettingDescStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text=" ← " Style="{StaticResource SettingDescStyle}" Visibility="{Binding HasHeard, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Heard}" Style="{StaticResource SettingDescStyle}" />
                                    <TextBlock Text="{Binding [DictAutoTag], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Margin="8,0,0,0"
                                               Visibility="{Binding Auto, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding [DictRemove], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingButtonStyle}"
                                        Command="{Binding DataContext.RemoveTermCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{Binding [DictForgetLearned], Source={x:Static res:Loc.Instance}}" Command="{Binding ForgetLearnedCommand}" Style="{StaticResource SettingButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding [DictSecHistory], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingRowStyle}">
            <StackPanel>
                <TextBlock Text="{Binding [DictNoHistory], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingDescStyle}" Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource SettingDescStyle}" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource SettingDescStyle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource SettingDescStyle}" TextWrapping="Wrap"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{Binding [DictCopy], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{Binding [DictRetry], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingButtonStyle}" Margin="0,0,8,0" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RetryHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{Binding [DictDelete], Source={x:Static res:Loc.Instance}}" Style="{StaticResource SettingButtonStyle}"
                                            Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{Binding [DictClearHistory], Source={x:Static res:Loc.Instance}}" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
