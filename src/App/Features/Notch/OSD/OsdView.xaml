<UserControl x:Class="Koy.App.Features.Notch.OSD.OsdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Notch.OSD"
             xmlns:power="clr-namespace:Koy.Core.Power;assembly=Koy.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:OsdIndicatorViewModel}"
             Width="260" Height="40">

  <Grid Margin="16,0,16,0" VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Sol: İkon (Ses için hoparlör #F4F4F5, Parlaklık için güneş #FACC15, Pil için yeşil/kırmızı/gri) -->
    <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
      <!-- Ses İkonu (Hoparlör) -->
      <Path x:Name="VolumeIcon" Width="18" Height="18" Stretch="Uniform"
            Stroke="#F4F4F5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="M 4,9 L 4,15 L 8,15 L 13,19 L 13,5 L 8,9 Z M 16,9 A 4,4 0 0 1 16,15 M 18.5,6.5 A 8,8 0 0 1 18.5,17.5">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Type}" Value="{x:Static local:OsdType.Volume}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Type}" Value="{x:Static local:OsdType.Volume}" />
                  <Condition Binding="{Binding IsMuted}" Value="True" />
                </MultiDataTrigger.Conditions>
                <!-- Sessiz ikonu: hoparlör + X -->
                <Setter Property="Data" Value="M 4,9 L 4,15 L 8,15 L 13,19 L 13,5 L 8,9 Z M 16,10 L 20,14 M 20,10 L 16,14" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <!-- Parlaklık İkonu (Güneş) -->
      <Path x:Name="BrightnessIcon" Width="18" Height="18" Stretch="Uniform"
            Stroke="#FACC15" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 12,8 A 4,4 0 1 1 11.99,8 Z M 12,2 L 12,4 M 12,20 L 12,22 M 2,12 L 4,12 M 20,12 L 22,12 M 4.9,4.9 L 6.3,6.3 M 17.7,17.7 L 19.1,19.1 M 4.9,19.1 L 6.3,17.7 M 17.7,6.3 L 19.1,4.9">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Type}" Value="{x:Static local:OsdType.Brightness}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <!-- Pil İkonu -->
      <Path x:Name="BatteryIcon" Width="18" Height="18" Stretch="Uniform"
            StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="{StaticResource IconBattery}">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="#10B981" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Type}" Value="{x:Static local:OsdType.Battery}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.LowBattery}">
                <Setter Property="Stroke" Value="#EF4444" />
                <Setter Property="Data" Value="{StaticResource IconBattery}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.PluggedIn}">
                <Setter Property="Stroke" Value="#10B981" />
                <Setter Property="Data" Value="{StaticResource IconBatteryCharging}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.FullyCharged}">
                <Setter Property="Stroke" Value="#10B981" />
                <Setter Property="Data" Value="{StaticResource IconBatteryCharging}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.Unplugged}">
                <Setter Property="Stroke" Value="#F4F4F5" />
                <Setter Property="Data" Value="{StaticResource IconBattery}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>
    </Grid>

    <!-- Orta Alan: Volume/Brightness için seviye çubuğu; Battery için durum metni ve seviye çubuğu -->
    <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
      <!-- Ses ve Parlaklık Seviye Çubuğu -->
      <Border Height="6" CornerRadius="3" Background="#3F3F46" ClipToBounds="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Type}" Value="{x:Static local:OsdType.Battery}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FillStarWidth}" />
            <ColumnDefinition Width="{Binding RemainingStarWidth}" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="3">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#F4F4F5" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static local:OsdType.Brightness}">
                    <Setter Property="Background" Value="#FACC15" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
        </Grid>
      </Border>

      <!-- Pil Alanı: Durum metni ve ince seviye çubuğu -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Type}" Value="{x:Static local:OsdType.Battery}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding BatteryStatusText}"
                   FontSize="11"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,2">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#E4E4E7" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.LowBattery}">
                  <Setter Property="Foreground" Value="#EF4444" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Border Grid.Row="1" Height="3" CornerRadius="1.5" Background="#3F3F46" ClipToBounds="True">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding FillStarWidth}" />
              <ColumnDefinition Width="{Binding RemainingStarWidth}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="1.5">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#10B981" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.LowBattery}">
                      <Setter Property="Background" Value="#EF4444" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BatteryKind}" Value="{x:Static power:BatteryAlertKind.Unplugged}">
                      <Setter Property="Background" Value="#A1A1AA" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Sağ: Yüzde Metni (12px, font-weight 600, sağa dayalı, #F4F4F5) -->
    <TextBlock Grid.Column="2"
               Text="{Binding PercentText}"
               FontSize="12"
               FontWeight="SemiBold"
               MinWidth="26"
               TextAlignment="Right"
               Foreground="#F4F4F5"
               VerticalAlignment="Center" />
  </Grid>
</UserControl>
