<UserControl x:Class="Koy.App.Features.Notch.OSD.NotchCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Koy.App.Features.Notch.OSD"
             xmlns:res="clr-namespace:Koy.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:OsdIndicatorViewModel}"
             Width="380" Height="72">

  <!-- Çentik kartı (güncelleme, bildirim): sol daire içinde simge, orta iki satır, sağda hap düğme ve ×.
       Düğmeler Border + MouseLeftButtonUp: çentik odak almaz (WS_EX_NOACTIVATE) ve tıklama çentiği açmaz. -->
  <Grid Margin="18,0,14,0" VerticalAlignment="Center" MouseLeftButtonDown="Card_MouseLeftButtonDown">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#27272A" VerticalAlignment="Center">
      <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
            Stroke="{DynamicResource KoyAccent}" StrokeThickness="2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Data="{StaticResource IconDownload}" />
    </Border>

    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Card.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Card.Subtitle}" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="ActionButton" Height="28" MinWidth="64" CornerRadius="14" Cursor="Hand"
              Background="{DynamicResource KoyAccent}"
              MouseLeftButtonUp="Action_MouseLeftButtonUp">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Card.HasPrimaryAction}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding Card.PrimaryActionLabel}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource KoyOnAccent}" Margin="14,0"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border x:Name="DismissButton" Width="26" Height="26" CornerRadius="13" Margin="8,0,0,0" Cursor="Hand"
              Background="Transparent"
              AutomationProperties.Name="{Binding [UpdateCardDismiss], Source={x:Static res:Loc.Instance}}"
              MouseLeftButtonUp="Dismiss_MouseLeftButtonUp">
        <Path Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
              Stroke="#A1A1AA" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M 0,0 L 10,10 M 10,0 L 0,10" />
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
