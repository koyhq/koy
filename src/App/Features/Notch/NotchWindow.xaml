<Window x:Class="Koy.App.Features.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koy.App.Features.Notch"
        xmlns:osd="clr-namespace:Koy.App.Features.Notch.OSD"
        xmlns:home="clr-namespace:Koy.App.Features.Home"
        xmlns:focus="clr-namespace:Koy.App.Features.Focus"
        xmlns:cc="clr-namespace:Koy.App.Features.ControlCenter"
        xmlns:status="clr-namespace:Koy.App.Features.Status"
        xmlns:shelf="clr-namespace:Koy.App.Features.Shelf"
        xmlns:calendar="clr-namespace:Koy.App.Features.Calendar"
        xmlns:clip="clr-namespace:Koy.App.Features.ClipboardPanel"
        xmlns:sysinfo="clr-namespace:Koy.App.Features.SystemInfo"
        xmlns:search="clr-namespace:Koy.App.Features.Search"
        xmlns:res="clr-namespace:Koy.App.Resources"
        xmlns:core="clr-namespace:Koy.Core.Notch;assembly=Koy.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:NotchViewModel}"
        Title="Koy"
        Width="640" Height="364"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowDrop="True"
        DragEnter="Notch_DragEnter"
        DragOver="Notch_DragOver"
        Drop="Notch_Drop">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- Durum satırındaki yuvarlak simge düğmeleri (Bildirim Merkezi, çentiği açık tut) -->
    <Style x:Key="NotchStatusButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="13" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource KoyNotchHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
    <!-- Sabit tuval üzerinde yay animasyonlu özel çentik şekli -->
    <local:NotchShape x:Name="Notch"
                      Width="236" Height="34"
                      CornerRadius="18" EarRadius="{Binding EarRadius}"
                      Background="{Binding SurfaceBrush}"
                      PreviewMouseLeftButtonDown="Notch_PreviewMouseLeftButtonDown"
                      MouseEnter="Notch_MouseEnter"
                      MouseLeave="Notch_MouseLeave"
                      MouseLeftButtonDown="Notch_MouseLeftButtonDown"
                      MouseWheel="Notch_MouseWheel"
                      AllowDrop="True"
                      DragEnter="Notch_DragEnter"
                      DragOver="Notch_DragOver"
                      Drop="Notch_Drop"
                      Cursor="Hand"
                      RenderTransformOrigin="0.5,0">
      <local:NotchShape.RenderTransform>
        <!-- Ölçek üst kenarın ortasından: dosya bırakılınca çentik üstten kopmadan esneyip sekiyor. -->
        <TransformGroup>
          <ScaleTransform x:Name="NotchScale" ScaleX="1" ScaleY="1" />
          <TranslateTransform x:Name="NotchTranslate" Y="0" />
        </TransformGroup>
      </local:NotchShape.RenderTransform>
      <local:NotchShape.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static res:Strings.Settings}" Command="{Binding OpenSettingsCommand}" />
        </ContextMenu>
      </local:NotchShape.ContextMenu>

      <Grid>
        <!-- 1. Collapsed Durumu (236x34 px, köşe yuvarlaklığı 0 0 18 18, arka plan #0A0A0B) -->
        <Grid x:Name="CollapsedView">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowCollapsedLayout}" Value="True" />
                    <Condition Binding="{Binding Osd.IsActive}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <!-- 1a. Boşta: Saat ve Pil (Solda 13px saat, sağda 22x11 pil göstergesi) -->
          <Grid x:Name="IdleStateView" VerticalAlignment="Center" Margin="22,0,22,0">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMusicPlaying}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Gizlilik noktaları: kamera (yeşil) ve mikrofon (turuncu) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="{Binding PrivacyToolTip}"
                        ToolTipService.InitialShowDelay="150"
                        Visibility="{Binding HasPrivacyActivity, Converter={StaticResource BoolToVis}}">
              <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="2,0"
                       Visibility="{Binding IsCameraActive, Converter={StaticResource BoolToVis}}" />
              <Ellipse Width="6" Height="6" Fill="#F97316" Margin="2,0"
                       Visibility="{Binding IsMicrophoneActive, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Orta-sağ: Wi-Fi ve Bluetooth durumu. Windows tepsisi gizli olduğu için bağlantıları gösteren yer burası;
                 tıklayınca çentik Kontrol sekmesinde açılır. Radyo yoksa (ör. Bluetooth'suz kasa) simgesi çıkmaz.
                 Çentik her zaman koyu yüzey olduğu için renkler KoyNotch* token'larından gelir. -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Foreground="{DynamicResource KoyNotchText}"
                    Command="{Binding OpenControlCenterCommand}"
                    Visibility="{Binding ShowIdleRadio, Converter={StaticResource BoolToVis}}">
              <!-- Halka modunda simgeler (yalnız Peek'te görünür) gün/saatin sağına geçer: "Sal 19:21 · 18 Kas [Wi-Fi][BT]". -->
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Grid.Column" Value="1" />
                  <Setter Property="Margin" Value="0,0,4,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIdleRing}" Value="True">
                      <Setter Property="Grid.Column" Value="3" />
                      <Setter Property="Margin" Value="6,0,-6,0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" Padding="2,0">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal">
                <!-- Wi-Fi -->
                <Grid Width="14" Height="14" Margin="0,0,6,0" ToolTipService.InitialShowDelay="300"
                      Visibility="{Binding ControlCenter.WiFi.IsPresent, Converter={StaticResource BoolToVis}}">
                  <Grid.ToolTip>
                    <TextBlock>
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Source="{x:Static res:Strings.WiFi}" />
                          <Binding Path="ControlCenter.WiFi.StatusText" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid.ToolTip>
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ControlCenter.WiFi.IsOn}" Value="False">
                          <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <res:KoyIcon Data="{DynamicResource IconWifi}" Size="14" StrokeWidth="2.4" />
                  <!-- Kapalıyken çapraz çizgi: yalnız soluklukla açık/kapalı ayırt edilmiyordu -->
                  <Line X1="1" Y1="13" X2="13" Y2="1" Stroke="{DynamicResource KoyNotchText}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                      <Style TargetType="Line">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ControlCenter.WiFi.IsOn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Line.Style>
                  </Line>
                </Grid>
                <!-- Bluetooth -->
                <Grid Width="14" Height="14" Margin="0,0,6,0" ToolTipService.InitialShowDelay="300"
                      Visibility="{Binding ControlCenter.Bluetooth.IsPresent, Converter={StaticResource BoolToVis}}">
                  <Grid.ToolTip>
                    <TextBlock>
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Source="{x:Static res:Strings.Bluetooth}" />
                          <Binding Path="ControlCenter.Bluetooth.StatusText" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid.ToolTip>
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Setter Property="Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ControlCenter.Bluetooth.IsOn}" Value="False">
                          <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <res:KoyIcon Data="{DynamicResource IconBluetooth}" Size="14" StrokeWidth="1.8" />
                  <!-- Kapalıyken çapraz çizgi: yalnız soluklukla açık/kapalı ayırt edilmiyordu -->
                  <Line X1="1" Y1="13" X2="13" Y2="1" Stroke="{DynamicResource KoyNotchText}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Style>
                      <Style TargetType="Line">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ControlCenter.Bluetooth.IsOn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Line.Style>
                  </Line>
                </Grid>
              </StackPanel>
            </Button>

            <!-- Sol: Saat (HH:mm, 13px, font-weight 600, foreground #F4F4F5) -->
            <TextBlock Grid.Column="0"
                       Visibility="{Binding ShowIdleClassicClock, Converter={StaticResource BoolToVis}}"
                       Text="{Binding ClockDisplay}"
                       Foreground="#F4F4F5"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <!-- Sağ: zamanlayıcı çalışırken kalan süre (pil, Wi-Fi ve Bluetooth yerine). Saniyede bir yalnız sayaç çalışırken değişir, animasyon yok. -->
            <TextBlock Text="{Binding IdleTimerText}"
                       Foreground="{DynamicResource KoyNotchAccentFocus}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Visibility="{Binding ShowIdleTimer, Converter={StaticResource BoolToVis}}">
              <!-- Halka modunda süre halkanın yerine (solda) yazılır; sağda gün ve saat kalır. -->
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Grid.Column" Value="2" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIdleRing}" Value="True">
                      <Setter Property="Grid.Column" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <!-- Halka modu, sol: 18 px pil halkası (kalınlık 2,5; iz beyaz %28, dolu kısım pil rengi, ≤%20 ve şarjda değilken
                 #FB7185) ve yanında yüzde. Halka yalnız pil yüzdesi değişince yeniden kurulur; zamanlayıcı ve animasyon yok. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowIdleRing, Converter={StaticResource BoolToVis}}">
              <Grid Width="18" Height="18">
                <Ellipse Width="17" Height="17" Stroke="#47FFFFFF" StrokeThickness="2.5" />
                <Path Data="{Binding BatteryRingGeometry}" Stroke="{Binding BatteryRingBrush}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Grid>
              <TextBlock Text="{Binding BatteryPercentText}" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold"
                         Margin="6,0,0,0" VerticalAlignment="Center" />
              <Path Data="M13 2L4 14h7l-1 8 9-12h-7z" Fill="{Binding BatteryRingBrush}" Width="11" Height="11" Stretch="Uniform"
                    Margin="4,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Halka modu, sağ: gün ve saat ("Sal 19:21"), Peek'te kısa tarih ("· 18 Kas"). Pil ve süre yoksa ortada. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsIdleRing, Converter={StaticResource BoolToVis}}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Grid.Column" Value="2" />
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowIdleRing}" Value="False" />
                        <Condition Binding="{Binding ShowIdleTimer}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Grid.Column" Value="0" />
                      <Setter Property="Grid.ColumnSpan" Value="4" />
                      <Setter Property="HorizontalAlignment" Value="Center" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{Binding IdleDayTime}" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="{Binding IdlePeekDate}" Foreground="#A1A1AA" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding ShowIdlePeekDate, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Sağ: Pil Göstergesi (22x11 px dış gövde #F4F4F5, seviye #4ADE80, terminal uç 2x5).
                 Masaüstü kasada pil yok; boş bir pil çizmek yanıltıcı olur (ShowIdleBattery HasBattery'yi de hesaba katar). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowIdleBattery, Converter={StaticResource BoolToVis}}">
              <Border Width="22" Height="11" BorderThickness="1.5" BorderBrush="#F4F4F5" CornerRadius="3" Padding="1" Background="Transparent">
                <Border HorizontalAlignment="Left" Width="{Binding BatteryFillWidth}" Height="6" Background="#4ADE80" CornerRadius="1" />
              </Border>
              <Border Width="2" Height="5" Background="#F4F4F5" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- 1b. Müzik Çalarken: Kapak ve 4 çubuklu dalga (30px yan marjinler kavisli kulaklardan ve alt köşelerden tam korur) -->
          <Grid x:Name="MusicStateView" VerticalAlignment="Center" Margin="30,0,30,0">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMusicPlaying}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol: 22x22 albüm kapağı (5px köşe yuvarlama) -->
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource KoyNotchMusicCover}" ClipToBounds="True">
              <Grid>
                <Path Width="11" Height="11" Stretch="Uniform" Fill="#60FFFFFF"
                      Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
                <Rectangle RadiusX="5" RadiusY="5" RenderOptions.BitmapScalingMode="HighQuality">
                  <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
                  </Rectangle.Fill>
                </Rectangle>
              </Grid>
            </Border>

            <!-- Orta: Şarkı adı -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Music.Title}"
                       Foreground="#F4F4F5"
                       FontSize="11"
                       FontWeight="Medium"
                       Margin="8,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />

            <!-- Gizlilik noktaları (müzik çalarken) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        ToolTip="{Binding PrivacyToolTip}"
                        ToolTipService.InitialShowDelay="150"
                        Visibility="{Binding HasPrivacyActivity, Converter={StaticResource BoolToVis}}">
              <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="2,0"
                       Visibility="{Binding IsCameraActive, Converter={StaticResource BoolToVis}}" />
              <Ellipse Width="6" Height="6" Fill="#F97316" Margin="2,0"
                       Visibility="{Binding IsMicrophoneActive, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Sağ: 4 çubuklu hareketsiz dalga (yükseklik 14px, çubuklar: 8, 14, 10, 5 px, genişlik 3px, boşluk 2px, dolgu #4ADE80, %0 CPU) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14"
                        Visibility="{Binding ShowMusicWaveform, Converter={StaticResource BoolToVis}}">
              <Border Width="3" Height="8" Background="#4ADE80" CornerRadius="1" VerticalAlignment="Bottom" />
              <Border Width="3" Height="14" Background="#4ADE80" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Bottom" />
              <Border Width="3" Height="10" Background="#4ADE80" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Bottom" />
              <Border Width="3" Height="5" Background="#4ADE80" CornerRadius="1" Margin="2,0,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- OSD Göstergesi (Ses & Parlaklık — 260x40 px, köşe yuvarlaklığı 20, 1.5 sn auto-dismiss) -->
        <Grid x:Name="OsdContainerView" VerticalAlignment="Center">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Osd.IsActive}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <osd:OsdView x:Name="OsdHost" DataContext="{Binding Osd}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <osd:OsdView.Style>
              <Style TargetType="osd:OsdView">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static osd:OsdType.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </osd:OsdView.Style>
          </osd:OsdView>
          <!-- Kart (güncelleme, bildirim): 380x72, HUD'dan ayrı yüzey -->
          <osd:NotchCardView x:Name="CardHost" DataContext="{Binding Osd}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <osd:NotchCardView.Style>
              <Style TargetType="osd:NotchCardView">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Type}" Value="{x:Static osd:OsdType.Card}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </osd:NotchCardView.Style>
          </osd:NotchCardView>
        </Grid>

        <!-- 2. Peek Durumu -->
        <Grid x:Name="PeekView" VerticalAlignment="Center" Margin="12,0,12,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowPeekLayout}" Value="True" />
                    <Condition Binding="{Binding Osd.IsActive}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Sol: 24x24 kapak -->
          <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#20FFFFFF" ClipToBounds="True">
            <Grid>
              <Path Width="12" Height="12" Stretch="Uniform" Fill="#60FFFFFF"
                    Data="M 12,3 L 6,5 L 6,11 A 2.5,2.5 0 1 1 3.5,8.5 L 5,8.5 L 5,4 L 12,2 Z" />
              <Rectangle RadiusX="5" RadiusY="5" RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                  <ImageBrush ImageSource="{Binding Music.Thumbnail}" Stretch="UniformToFill" />
                </Rectangle.Fill>
              </Rectangle>
            </Grid>
          </Border>

          <!-- Orta: Şarkı adı ve sanatçı -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
            <TextBlock Text="{Binding Music.Title}"
                       Foreground="{StaticResource NotchForeground}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Text="{Binding Music.Artist}"
                       Foreground="#99FFFFFF"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>

          <!-- Sağ: Oynatma göstergesi -->
          <Canvas Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.9">
            <Line X1="2" Y1="3" X2="2" Y2="11" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="6" Y1="1" X2="6" Y2="13" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="10" Y1="4" X2="10" Y2="10" Stroke="{StaticResource NotchForeground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Canvas>
        </Grid>

        <!-- 3. Açık çentik (H tasarımı): üstte durum satırı, ortada sabit yükseklikli sayfa, altta ikonlu sekmeler.
             Kenar payı 24 = kulak yarıçapı (12) + tasarımın iç boşluğu (12). Yükseklik: 10 + 26 + 12 + 236 + 12 + 44 + 12 = 352. -->
        <Grid x:Name="ExpandedView" Margin="24,10,24,12">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="{x:Static core:NotchState.Expanded}" />
                    <Condition Binding="{Binding Osd.IsActive}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <!-- Arama açıkken durum satırı, sayfa ve sekmeler yerine arama paneli görünür -->
                <DataTrigger Binding="{Binding IsSearchOpen}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="260" />
            <RowDefinition Height="44" />
          </Grid.RowDefinitions>

          <!-- Durum satırı: saat · gün tarih, hava sıcaklığı, pil, Bildirim Merkezi, açık tut -->
          <Grid Grid.Row="0" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Status.CurrentTime, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource KoyNotchText}" />
              <Run Text="{Binding Status.DayDate, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource KoyNotchMuted}" /><Run Text="{Binding Status.SecondClockSuffix, Mode=OneWay}" Foreground="{DynamicResource KoyNotchMuted}" />
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Gizlilik göstergesi (açık çentik durum satırı) -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip="{Binding PrivacyToolTip}"
                          ToolTipService.InitialShowDelay="150"
                          Visibility="{Binding HasPrivacyActivity, Converter={StaticResource BoolToVis}}">
                <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="2,0"
                         Visibility="{Binding IsCameraActive, Converter={StaticResource BoolToVis}}" />
                <Ellipse Width="6" Height="6" Fill="#F97316" Margin="2,0"
                         Visibility="{Binding IsMicrophoneActive, Converter={StaticResource BoolToVis}}" />
              </StackPanel>

              <!-- Hava: konum seçilmişse sıcaklık ve küçük yer adı (tıklayınca yenilenir); seçilmemişse konum seçtirir -->
              <Button Style="{StaticResource NotchPlainButtonStyle}" Margin="0,0,12,0" VerticalAlignment="Center"
                      Command="{Binding Status.RefreshWeatherCommand}"
                      ToolTip="{Binding Status.WindToolTip}"
                      Visibility="{Binding Status.HasWeatherLocation, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="15" Height="15" Margin="0,0,5,0" VerticalAlignment="Center">
                    <status:WeatherGlyph DataContext="{Binding Status}" />
                  </Viewbox>
                  <TextBlock Text="{Binding Status.TemperatureShort}" FontSize="12" Foreground="{DynamicResource KoyNotchText}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Status.PlaceName}" FontSize="10" Foreground="{DynamicResource KoyNotchMuted}" Margin="6,2,0,0"
                             MaxWidth="96" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource NotchPlainButtonStyle}" Margin="0,0,12,0" VerticalAlignment="Center"
                      Command="{Binding Home.ChooseWeatherLocationCommand}"
                      Visibility="{Binding Home.ShowNoLocation, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding [WeatherPickLocation], Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource KoyNotchMuted}" />
              </Button>

              <!-- Pil: yalnız pil varsa -->
              <TextBlock Text="{Binding BatteryPercent, Converter={x:Static res:PercentTextConverter.Instance}}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource KoyNotchOk}" VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />

              <Button Style="{StaticResource NotchStatusButtonStyle}" Command="{Binding Home.OpenNotificationCenterCommand}"
                      ToolTip="{Binding [NotchNotifications], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [NotchNotifications], Source={x:Static res:Loc.Instance}}">
                <res:KoyIcon Data="{DynamicResource IconBell}" Size="15" Foreground="{DynamicResource KoyNotchTextSecondary}" />
              </Button>
              <Button Style="{StaticResource NotchStatusButtonStyle}" Command="{Binding TogglePinnedCommand}"
                      ToolTip="{Binding [NotchPin], Source={x:Static res:Loc.Instance}}"
                      AutomationProperties.Name="{Binding [NotchPin], Source={x:Static res:Loc.Instance}}">
                <res:KoyIcon Data="{DynamicResource IconPin}" Size="15">
                  <res:KoyIcon.Style>
                    <Style TargetType="res:KoyIcon">
                      <Setter Property="Foreground" Value="{DynamicResource KoyNotchTextSecondary}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource KoyNotchAccentFocus}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </res:KoyIcon.Style>
                </res:KoyIcon>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Sayfa: sekme değişiminde yatay kayma ve solma yalnız burada (durum satırı ve sekmeler yerinde kalır) -->
          <ContentControl x:Name="BodyHost" Grid.Row="1" Margin="0,12,0,12" Foreground="{DynamicResource KoyNotchText}" Content="{Binding CurrentPanelContent}" ClipToBounds="False">
            <ContentControl.RenderTransform>
              <TranslateTransform x:Name="PanelTranslate" X="0" />
            </ContentControl.RenderTransform>
            <ContentControl.Resources>
              <DataTemplate DataType="{x:Type home:HomeViewModel}">
                <home:HomePanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type focus:FocusViewModel}">
                <focus:FocusPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type calendar:CalendarViewModel}">
                <calendar:CalendarPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type clip:ClipboardViewModel}">
                <clip:ClipboardPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type sysinfo:SystemStatsViewModel}">
                <sysinfo:SystemPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type shelf:ShelfViewModel}">
                <shelf:ShelfPanel />
              </DataTemplate>
              <DataTemplate DataType="{x:Type cc:ControlCenterViewModel}">
                <cc:ControlCenterPanel />
              </DataTemplate>
            </ContentControl.Resources>
          </ContentControl>

          <!-- Sekme çubuğu: sekmeler listeden üretilir (NotchTabs); seçili sekme kendi sayfa rengini alır -->
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Tabs}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:NotchTabViewModel}">
                <Button Margin="1,0" Height="42" Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Panel}"
                        AutomationProperties.Name="{Binding Label}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Pill" CornerRadius="14" Background="Transparent">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <res:KoyIcon x:Name="Glyph" Data="{Binding Icon}" Size="16" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource KoyNotchDim}" />
                          <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0"
                                     HorizontalAlignment="Center" Foreground="{DynamicResource KoyNotchMuted}" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource KoyNotchHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource KoyNotchChip}" />
                          <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource KoyNotchText}" />
                          <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Accent}" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <!-- 4. Arama: açık çentiğin bütün gövdesini kullanır -->
        <Grid Margin="24,10,24,12" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
          <search:SearchPanel x:Name="SearchHost" DataContext="{Binding Search}" />
        </Grid>
      </Grid>
    </local:NotchShape>
  </Grid>
</Window>
