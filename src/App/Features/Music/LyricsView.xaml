<UserControl x:Class="Koy.App.Features.Music.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Koy.App.Features.Music"
             Background="Transparent">
  <!-- Canvas: liste kendi tam yüksekliğini alır. Grid içinde kalsaydı yerleşim kırpması kaydırılan satırları keserdi.
       Üst ve alt kenar saydamlık maskesiyle silikleşir (#182); maske efekt değildir, Direct3D yüklemez. Maske kodda,
       piksel cinsinden kurulur (LyricsView.UpdateEdgeMask): göreli maske listenin tamamına yayılıyordu. -->
  <Canvas x:Name="Viewport" ClipToBounds="True">
    <ItemsControl x:Name="LinesHost" ItemsSource="{Binding Lines}" Focusable="False"
                  Width="{Binding ActualWidth, ElementName=Viewport}">
      <ItemsControl.RenderTransform>
        <TranslateTransform x:Name="ScrollTransform" />
      </ItemsControl.RenderTransform>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:LyricLineItem}">
          <!-- Satırın saydamlığı ve ölçeği etkin satırın çizgisine uzaklığından gelir (LyricsView.ApplyEmphasis). -->
          <Button Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch"
                  Command="{Binding DataContext.SeekToLineCommand, RelativeSource={RelativeSource AncestorType=local:LyricsView}}"
                  CommandParameter="{Binding}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="0,4">
                  <ContentPresenter />
                </Border>
              </ControlTemplate>
            </Button.Template>
            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:LyricsView}}"
                       FontFamily="{DynamicResource KoyNotchDisplayFont}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource KoyNotchText}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Canvas>
</UserControl>
