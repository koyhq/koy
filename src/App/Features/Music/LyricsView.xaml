<UserControl x:Class="Koy.App.Features.Music.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Koy.App.Features.Music"
             xmlns:res="clr-namespace:Koy.App.Resources"
             Background="Transparent">
  <Grid>
    <!-- Canvas: liste kendi tam yüksekliğini alır. Grid içinde kalsaydı yerleşim kırpması kaydırılan satırları keserdi. -->
    <Canvas x:Name="Viewport" ClipToBounds="True">
      <ItemsControl x:Name="LinesHost" ItemsSource="{Binding Lines}" Focusable="False"
                    Width="{Binding ActualWidth, ElementName=Viewport}">
        <ItemsControl.RenderTransform>
          <TranslateTransform x:Name="ScrollTransform" />
        </ItemsControl.RenderTransform>
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="Ready">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:LyricLineItem}">
            <Button Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.SeekToLineCommand, RelativeSource={RelativeSource AncestorType=local:LyricsView}}"
                    CommandParameter="{Binding}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" Padding="0,3">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource KoyNotchText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Opacity" Value="0.42" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>

    <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource KoyNotchMusicSub}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Loading">
              <Setter Property="Visibility" Value="Visible" />
              <Setter Property="Text" Value="{Binding [LyricsLoading], Source={x:Static res:Loc.Instance}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="NotFound">
              <Setter Property="Visibility" Value="Visible" />
              <Setter Property="Text" Value="{Binding [LyricsNotFound], Source={x:Static res:Loc.Instance}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
              <Setter Property="Visibility" Value="Visible" />
              <Setter Property="Text" Value="{Binding [LyricsFailed], Source={x:Static res:Loc.Instance}}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
