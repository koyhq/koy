<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Koyu tema renkleri. Açık tema (Theme.Light.xaml) ile AYNI anahtarları taşımak zorunda;
        tests/Core.Tests/ThemePaletteTests.cs bunu ve kontrast oranlarını denetler.
        Kullanım her yerde DynamicResource: tema değişince ThemeManager bu sözlüğü değiştirir.
        Vurgu tonları (KoyAccent*, KoyOnAccent, KoyFocusRing) seçilen vurgu rengine göre ThemeManager tarafından ezilir.
    -->

    <!-- Yüzeyler -->
    <SolidColorBrush x:Key="KoyBgWindow" Color="#18181B" />
    <SolidColorBrush x:Key="KoyBgShell" Color="#111113" />
    <SolidColorBrush x:Key="KoyBgRow" Color="#1F1F23" />
    <SolidColorBrush x:Key="KoyBgControl" Color="#27272A" />
    <!-- Segment kutusu (SegmentContainerStyle); saydam malzemede ThemeManager ezer. -->
    <SolidColorBrush x:Key="KoyBgSegment" Color="#27272A" />
    <SolidColorBrush x:Key="KoyBgHover" Color="#2E2E35" />
    <SolidColorBrush x:Key="KoyBgActive" Color="#3F3F46" />
    <SolidColorBrush x:Key="KoyBgNavHover" Color="#1B1B1E" />
    <SolidColorBrush x:Key="KoyBgNavActive" Color="#27272A" />

    <!-- Kenarlıklar -->
    <SolidColorBrush x:Key="KoyBorderHairline" Color="#2E2E33" />
    <SolidColorBrush x:Key="KoyBorderShell" Color="#232327" />
    <SolidColorBrush x:Key="KoyBorderStrong" Color="#3F3F46" />
    <SolidColorBrush x:Key="KoyBorderControl" Color="#71717A" />

    <!-- Yazı -->
    <SolidColorBrush x:Key="KoyTextPrimary" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyTextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="KoyTextMuted" Color="#8B8B95" />
    <SolidColorBrush x:Key="KoyTextDisabled" Color="#5A5A63" />

    <!-- Vurgu (varsayılan Koy mavisi) -->
    <SolidColorBrush x:Key="KoyAccent" Color="#3B82F6" />
    <SolidColorBrush x:Key="KoyAccentHover" Color="#5E98F8" />
    <SolidColorBrush x:Key="KoyAccentPressed" Color="#3068C2" />
    <SolidColorBrush x:Key="KoyOnAccent" Color="#0A0A0B" />
    <SolidColorBrush x:Key="KoyAccentText" Color="#5E98F8" />
    <SolidColorBrush x:Key="KoyFocusRing" Color="#3B82F6" />
    <SolidColorBrush x:Key="KoyAccentSubtle" Color="#263B82F6" />

    <!-- Bilgi ve durum -->
    <SolidColorBrush x:Key="KoyBgInfo" Color="#172033" />
    <SolidColorBrush x:Key="KoyFgInfo" Color="#BFDBFE" />
    <SolidColorBrush x:Key="KoyDangerText" Color="#FCA5A5" />
    <SolidColorBrush x:Key="KoyDangerBorder" Color="#522525" />
    <SolidColorBrush x:Key="KoyDangerBg" Color="#2A1517" />
    <SolidColorBrush x:Key="KoyScrim" Color="#B3000000" />
    <SolidColorBrush x:Key="KoyStatusOk" Color="#34D399" />
    <SolidColorBrush x:Key="KoyStatusWarn" Color="#E5A93C" />

    <!-- Anahtar (toggle) -->
    <SolidColorBrush x:Key="KoyToggleTrackOff" Color="#2A2B31" />
    <SolidColorBrush x:Key="KoyToggleKnobOff" Color="#D4D4D8" />
    <SolidColorBrush x:Key="KoyToggleKnobOn" Color="#FFFFFF" />

    <!-- Dock (temadan bağımsız koyu yüzey; Koyu ve Açık aynı değerleri taşır, tema paketi ezer) -->
    <SolidColorBrush x:Key="KoyDockSurface" Color="#121216" />
    <SolidColorBrush x:Key="KoyDockCapsuleSurface" Color="#18181B" />
    <SolidColorBrush x:Key="KoyDockBorder" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="KoyDockCapsuleBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="KoyDockSeparator" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="KoyDockDivider" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="KoyDockHover" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="KoyDockActive" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="KoyDockPill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="KoyDockCover" Color="#27272A" />
    <SolidColorBrush x:Key="KoyDockIndicator" Color="#A1A1AA" />
    <SolidColorBrush x:Key="KoyDockText" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyDockTextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="KoyDockGlyph" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="KoyDockClockText" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="KoyDockClockSubtext" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="KoyDockPreviewSurface" Color="#F51C1C1E" />
    <SolidColorBrush x:Key="KoyDockPreviewText" Color="#D4D4D8" />
</ResourceDictionary>
