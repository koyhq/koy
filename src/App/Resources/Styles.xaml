<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Koy.App.Resources">
    <!--
        Koy penceresi, kurulum sihirbazı ve sağ alt menü için ortak bileşen stilleri.
        Bütün renk, boyut ve köşe değerleri token'dan gelir (Theme.*.xaml, Tokens.xaml) ve DynamicResource ile okunur;
        sabit hex yalnız KoyLogoGeometry dışında yoktur. Hareket (hover, basma, anahtar yayı) Motion ekli özellikleriyle.
    -->

    <!-- Dock Başlat düğmesi: Windows 11 logosu (köşesiz dört kare, görev çubuğundaki gibi sol üstten sağ alta mavi geçiş).
         Tek DrawingImage paylaşılır; kapsül ve tam genişlik dock aynı kaynağı kullanır. -->
    <DrawingImage x:Key="WindowsLogoImage" po:Freeze="True"
                  xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="M 0,0 H 9.5 V 9.5 H 0 Z M 10.5,0 H 20 V 9.5 H 10.5 Z M 0,10.5 H 9.5 V 20 H 0 Z M 10.5,10.5 H 20 V 20 H 10.5 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF52D3FF" Offset="0"/>
                        <GradientStop Color="#FF0A64D6" Offset="1"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Dock Başlat düğmesinin varsayılan simgesi: Koy uygulama simgesi. assets/branding/koy-symbol-small.svg (16-32 px için
         kalınlaştırılmış çentik ve K) birebir vektör olarak çizilir; böylece 16-18 px'te (her DPI'da) keskin kalır, bitmap
         ölçeklemesi yok. Çizim kutusu karonun kendisi: kenarda boşluk bırakmaz. -->
    <DrawingImage x:Key="KoyStartIconImage" po:Freeze="True"
                  xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF2563EB"
                                 Geometry="M 80,24 H 176 C 208,24 232,48 232,80 V 176 C 232,208 208,232 176,232 H 80 C 48,232 24,208 24,176 V 80 C 24,48 48,24 80,24 Z"/>
                <GeometryDrawing Brush="#FF93C5FD"
                                 Geometry="M 78,24 C 86,42 98,56 114,56 H 142 C 158,56 170,42 178,24 H 78 Z"/>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="70,80,36,114" RadiusX="18" RadiusY="18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF"
                                 Geometry="M 106,137 L 150,85 C 156,78 168,77 175,83 C 182,89 183,100 176,107 L 138,143 L 176,181 C 183,188 182,199 175,205 C 168,211 156,210 150,203 L 106,149 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Koy Marka Logosu Vektör Geometrisi (Windows 11 Fluent Squircle + Çentik + K Monogramı) -->
    <Geometry x:Key="KoyLogoGeometry">M 80,32 H 176 C 202,32 224,54 224,80 V 176 C 224,202 202,224 176,224 H 80 C 54,224 32,202 32,176 V 80 C 32,54 54,32 80,32 Z M 88,32 C 94,44 104,54 116,54 H 140 C 152,54 162,44 168,32 H 88 Z M 76,96 C 76,88 83,82 91,82 C 99,82 106,88 106,96 V 176 C 106,184 99,190 91,190 C 83,190 76,184 76,176 Z M 106,136 L 148,88 C 154,82 164,81 170,87 C 176,93 176,102 170,107 L 134,143 L 170,179 C 176,184 176,193 170,199 C 164,205 154,204 148,198 L 106,148 Z</Geometry>

    <!-- Dock düz düğmesi (Başlat, İndirilenler, Koy menüsü): kapsül ve tam genişlik dock aynı stili kullanır.
         Dock temadan bağımsız koyu yüzeydir, bu yüzden üst katmanlar beyazın yüzdesidir. İçerik düğmeden gelir. -->
    <Style x:Key="DockFlatButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource KoyDockActive}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Klavye odağı: yalnız klavyeyle gezerken görünür, 2 px vurgu halkası -->
    <Style x:Key="KoyFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource KoyFocusRing}" StrokeThickness="2" RadiusX="7" RadiusY="7"
                               Margin="-3" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Metin stilleri -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource KoyFontPageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource KoyFontSubtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource KoyFontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextMuted}" />
        <Setter Property="Margin" Value="2,24,0,8" />
        <Style.Triggers>
            <Trigger Property="m:SettingsRowState.IsFilteredOut" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource KoyFontRowTitle}" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource KoyFontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Ayar satırı: 52 px, satır zemini + 1 px kenarlık, ince köşe -->
    <Style x:Key="SettingRowStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="{DynamicResource KoyRowMinHeight}" />
        <Setter Property="Background" Value="{DynamicResource KoyBgRow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource KoyRadiusRow}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Style.Triggers>
            <!-- Ayar araması ve "yalnız değişenler" (SettingsRowState, issue #69) -->
            <Trigger Property="m:SettingsRowState.IsHighlighted" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
            </Trigger>
            <Trigger Property="m:SettingsRowState.IsFilteredOut" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Segment kapsayıcısı (SegRadioStyle düğmelerini sarar) -->
    <Style x:Key="SegmentContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KoyBgSegment}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource KoyRadiusControl}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Anahtar (toggle): 40x22 iz, yaylı 16 px düğme. Kapalı izin kenarı 3:1 kontrastlı. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="root" Width="40" Height="22" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="track" CornerRadius="11"
                                Background="{DynamicResource KoyToggleTrackOff}"
                                BorderBrush="{DynamicResource KoyBorderControl}" BorderThickness="1" />
                        <Border x:Name="trackOn" CornerRadius="11" Opacity="0"
                                Background="{DynamicResource KoyAccent}" />
                        <Grid x:Name="knobHost" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse Fill="{DynamicResource KoyToggleKnobOff}" />
                            <Ellipse x:Name="knobOn" Fill="{DynamicResource KoyToggleKnobOn}" Opacity="0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="trackOn" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="knobOn" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="knobHost" Property="m:Motion.KnobOn" Value="True" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="m:Motion.ScaleTo" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onay kutusu -->
    <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="{DynamicResource KoyRadiusSmall}"
                                Background="{DynamicResource KoyBgControl}"
                                BorderBrush="{DynamicResource KoyBorderControl}" BorderThickness="1.5" />
                        <Border x:Name="boxOn" Width="20" Height="20" CornerRadius="{DynamicResource KoyRadiusSmall}"
                                Background="{DynamicResource KoyAccent}" Opacity="0" />
                        <m:KoyIcon x:Name="mark" Data="{DynamicResource IconCheck}" Size="14" StrokeWidth="2.5"
                                   Foreground="{DynamicResource KoyOnAccent}" Opacity="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="boxOn" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="mark" Property="m:Motion.FadeTo" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segment düğmesi (SegmentContainerStyle içinde) -->
    <Style x:Key="SegRadioStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource KoyFontControl}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="hover" CornerRadius="{DynamicResource KoyRadiusSmall}"
                                Background="{DynamicResource KoyBgHover}" Opacity="0" />
                        <Border x:Name="sel" CornerRadius="{DynamicResource KoyRadiusSmall}"
                                Background="{DynamicResource KoyBgActive}"
                                BorderBrush="{DynamicResource KoyBorderStrong}" BorderThickness="1" Opacity="0" />
                        <ContentPresenter Margin="12,5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="sel" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Renk seçimi: 24 px halka, seçili halka metin renginde, odakta odak halkası. AutomationProperties.Name sayfada verilir. -->
    <Style x:Key="ColorRadioStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="ringHover" Stroke="{DynamicResource KoyBorderControl}" StrokeThickness="2" Opacity="0" />
                        <Ellipse x:Name="ring" Stroke="{DynamicResource KoyTextPrimary}" StrokeThickness="2" Opacity="0" />
                        <Ellipse Width="18" Height="18" Fill="{TemplateBinding Background}" />
                        <m:KoyIcon x:Name="mark" Data="{DynamicResource IconCheck}" Size="12" StrokeWidth="3"
                                   Foreground="#FF0A0A0B" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ringHover" Property="m:Motion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="mark" Property="m:Motion.FadeTo" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standart düğme: 28 px, hover katmanı yumuşak belirir, basılınca %97'ye küçülür -->
    <Style x:Key="SettingButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource KoyControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource KoyBgControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource KoyFontControl}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <Border x:Name="hover" Background="{DynamicResource KoyBgHover}" Opacity="0"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="m:Motion.ScaleTo" Value="0.97" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Birincil düğme: vurgu zemini, üstünde kontrast garantili yazı -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource KoyAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource KoyOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <Border x:Name="hover" Background="{DynamicResource KoyAccentHover}" Opacity="0"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="m:Motion.ScaleTo" Value="0.97" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tehlikeli işlem düğmesi -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource KoyDangerText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KoyDangerBorder}" />
    </Style>

    <!-- Başlık çubuğu düğmesi: Tag = ikon geometrisi, Foreground ikon rengi -->
    <Style x:Key="TitleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="hover" Background="{DynamicResource KoyBgHover}" Opacity="0"
                                CornerRadius="{DynamicResource KoyRadiusControl}" Margin="2" />
                        <m:KoyIcon Data="{TemplateBinding Tag}" Size="14" StrokeWidth="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kenar çubuğu gezinme öğesi (RadioButton): Tag = ikon geometrisi, Content = ad -->
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="{DynamicResource KoyNavItemHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" Background="Transparent">
                        <Border x:Name="hover" Background="{DynamicResource KoyBgNavHover}" Opacity="0"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <Border x:Name="active" Background="{DynamicResource KoyBgNavActive}" Opacity="0"
                                BorderBrush="{DynamicResource KoyBorderHairline}" BorderThickness="1"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="1,0,0,0" Background="{DynamicResource KoyAccent}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,8,0">
                            <m:KoyIcon x:Name="icon" Data="{TemplateBinding Tag}" Size="16" StrokeWidth="1.9" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="active" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="bar" Property="m:Motion.FadeTo" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource KoyAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Klavye tuş rozeti -->
    <Style x:Key="KeyBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="{DynamicResource KoyBgControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource KoyRadiusSmall}" />
        <Setter Property="TextBlock.FontFamily" Value="{DynamicResource KoyFontMono}" />
        <Setter Property="TextBlock.FontSize" Value="{DynamicResource KoyFontKey}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
        <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Mavi bilgi kutusu -->
    <Style x:Key="InfoNoticeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KoyBgInfo}" />
        <Setter Property="CornerRadius" Value="{DynamicResource KoyRadiusRow}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- Açılır liste: düğme -->
    <Style x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="border" Background="{DynamicResource KoyBgControl}"
                                BorderBrush="{DynamicResource KoyBorderStrong}" BorderThickness="1"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <Border x:Name="hover" Background="{DynamicResource KoyBgHover}" Opacity="0"
                                CornerRadius="{DynamicResource KoyRadiusControl}" />
                        <m:KoyIcon x:Name="arrow" Data="{DynamicResource IconChevronDown}" Size="14" StrokeWidth="2"
                                   Foreground="{DynamicResource KoyTextSecondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="m:Motion.FadeTo" Value="1" />
                            <Setter TargetName="arrow" Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Açılır liste: öğe -->
    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource KoyFontControl}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="itemBorder" Background="Transparent" CornerRadius="{DynamicResource KoyRadiusSmall}"
                            Margin="2,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource KoyBgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource KoyAccentSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyAccentText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Açılır liste -->
    <Style x:Key="SettingComboBoxStyle" TargetType="ComboBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource KoyFontControl}" />
        <Setter Property="Height" Value="{DynamicResource KoyControlHeight}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Name="ToggleButton" Style="{StaticResource DarkComboBoxToggle}" Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                            <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,12,16">
                                <Border Background="{DynamicResource KoyBgRow}" BorderBrush="{DynamicResource KoyBorderStrong}"
                                        BorderThickness="1" CornerRadius="{DynamicResource KoyRadiusControl}" Padding="2">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="14" ShadowDepth="3" Direction="270" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- MODERN DARK SCROLLBAR & SCROLLVIEWER (HeroUI / Corvus Stili)   -->
    <!-- ============================================================== -->

    <!-- ScrollBar Thumb Şablonu -->
    <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="thumbBorder"
                            Background="{DynamicResource KoyScrollThumb}"
                            CornerRadius="3"
                            Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource KoyScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource KoyScrollThumbDrag}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar Butonları (Görünmez Sayfa Atlatıcılar) -->
    <Style x:Key="ModernScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Evrensel Modern ScrollBar Stili -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <!-- Dikey ScrollBar: 6 px genişlik, ince şeffaf iz, yuvarlak koyu tutamak -->
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <!-- Yatay ScrollBar: 8 px yükseklik -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Evrensel Modern ScrollViewer Stili -->
    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1" Grid.Row="0"
                                   Orientation="Vertical"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Minimum="0"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Margin="2,0,2,0" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Column="0" Grid.Row="1"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Minimum="0"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Margin="0,2,0,2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- MODERN DARK CONTEXTMENU & MENUITEM (HeroUI / Corvus Stili)     -->
    <!-- ============================================================== -->

    <!-- Evrensel Modern Separator Stili -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Background" Value="{DynamicResource KoyMenuSeparator}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="{TemplateBinding Height}" Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
           TargetType="{x:Type Separator}"
           BasedOn="{StaticResource {x:Type Separator}}" />

    <!-- Evrensel Modern MenuItem Stili -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource KoyMenuText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                    <Border x:Name="menuItemBorder"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="2,1"
                            Padding="{TemplateBinding Padding}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="Icon"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center" />

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource KoyMenuTextMuted}"
                                       FontSize="11"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center" />

                            <!-- Alt menüsü olan satırda sağa ok -->
                            <Path x:Name="SubmenuArrow"
                                  Grid.Column="2"
                                  Data="{DynamicResource IconChevronRight}"
                                  Stroke="{DynamicResource KoyMenuTextMuted}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="9"
                                  Height="9"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Alt menü: yalnız öğesi olan satırda açılır (ör. Başlat menüsünde "Kapat veya oturumu kapat") -->
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="None"
                           Placement="Right"
                           HorizontalOffset="-2"
                           VerticalOffset="-5"
                           PlacementTarget="{Binding ElementName=menuItemBorder}"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Background="{DynamicResource KoyMenuBg}"
                                BorderBrush="{DynamicResource KoyMenuBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4"
                                MinWidth="160"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="20" ShadowDepth="4" Direction="270" />
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                        </Border>
                    </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="menuItemBorder" Property="Background" Value="{DynamicResource KoyMenuHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource KoyMenuText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource KoyMenuTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Evrensel Modern ContextMenu Stili -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource KoyMenuBg}"
                            BorderBrush="{DynamicResource KoyMenuBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4"
                            MinWidth="160">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="20" ShadowDepth="4" Direction="270" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tek satırlık metin kutusu (ör. şehir arama): kontrol yüksekliğinde, odakta vurgu kenarlığı -->
    <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource KoyControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource KoyBgControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KoyBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource KoyTextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource KoyFontControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource KoyRadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource KoyAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bağlantı düğmesi: vurgu renginde metin, üzerine gelince altı çizilir ("Mağazadan daha fazla al…") -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource KoyAccentText}" />
        <Setter Property="FontSize" Value="{DynamicResource KoyFontCaption}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KoyFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        <Path Data="M 9 18 L 15 12 L 9 6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" Width="9" Height="9"
                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="5,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
