<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Temadan bağımsız tasarım token'ları: yazı tipi, boyut, boşluk, köşe, ölçüler.
        Boşluk ölçeği 4'ün katıdır (Corvus ile aynı mantık). Köşe yarıçapları Standart seçimdir;
        Görünüm > Köşe yuvarlaklığı değişince ThemeManager aynı anahtarları uygulama düzeyinde ezer (DynamicResource).
    -->

    <!-- Yazı tipi -->
    <FontFamily x:Key="KoyFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="KoyFontMono">Consolas</FontFamily>

    <!-- Yazı boyutları -->
    <sys:Double x:Key="KoyFontPageTitle">20</sys:Double>
    <sys:Double x:Key="KoyFontSubtitle">12.5</sys:Double>
    <sys:Double x:Key="KoyFontSection">11.5</sys:Double>
    <sys:Double x:Key="KoyFontRowTitle">13.5</sys:Double>
    <sys:Double x:Key="KoyFontBody">13</sys:Double>
    <sys:Double x:Key="KoyFontControl">12.5</sys:Double>
    <sys:Double x:Key="KoyFontCaption">12</sys:Double>
    <sys:Double x:Key="KoyFontKey">11.5</sys:Double>

    <!-- Boşluk ölçeği (DIP) -->
    <sys:Double x:Key="KoySpace1">4</sys:Double>
    <sys:Double x:Key="KoySpace2">8</sys:Double>
    <sys:Double x:Key="KoySpace3">12</sys:Double>
    <sys:Double x:Key="KoySpace4">16</sys:Double>
    <sys:Double x:Key="KoySpace5">24</sys:Double>
    <sys:Double x:Key="KoySpace6">32</sys:Double>

    <!-- Köşe yarıçapları (Standart) -->
    <CornerRadius x:Key="KoyRadiusWindow">12</CornerRadius>
    <CornerRadius x:Key="KoyRadiusWindowTop">11,11,0,0</CornerRadius>
    <CornerRadius x:Key="KoyRadiusWindowBottomLeft">0,0,0,11</CornerRadius>
    <CornerRadius x:Key="KoyRadiusRow">8</CornerRadius>
    <CornerRadius x:Key="KoyRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="KoyRadiusSmall">4</CornerRadius>

    <!-- Ölçüler -->
    <sys:Double x:Key="KoyControlHeight">28</sys:Double>
    <sys:Double x:Key="KoyRowMinHeight">52</sys:Double>
    <sys:Double x:Key="KoyNavItemHeight">34</sys:Double>
    <sys:Double x:Key="KoyIconSize">16</sys:Double>
    <sys:Double x:Key="KoyIconSizeLarge">20</sys:Double>
    <sys:Double x:Key="KoyIconStroke">2</sys:Double>

    <!-- Temadan bağımsız (sabit koyu) yüzeyler: dock ve çentik koyu kalır, bu yüzden bağlam menüsü ve kaydırma çubuğu da tema değiştirmez. -->
    <SolidColorBrush x:Key="KoyMenuBg" Color="#18181B" />
    <SolidColorBrush x:Key="KoyMenuBorder" Color="#2E2E33" />
    <SolidColorBrush x:Key="KoyMenuText" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyMenuTextMuted" Color="#8B8B95" />
    <SolidColorBrush x:Key="KoyMenuTextDisabled" Color="#71717A" />
    <SolidColorBrush x:Key="KoyMenuHover" Color="#2E2E35" />
    <SolidColorBrush x:Key="KoyMenuSeparator" Color="#2E2E33" />

    <!-- Çentik her zaman koyu yüzeydir (temadan bağımsız). Sekmeler ve durum simgeleri bu fırçaları kullanır. -->
    <SolidColorBrush x:Key="KoyNotchText" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyNotchTextSecondary" Color="#D4D4D8" />
    <!-- Seçili sekmenin (açık dolgu) üstündeki koyu yazı: çentik yüzeyiyle aynı renk -->
    <SolidColorBrush x:Key="KoyNotchTextOnLight" Color="#0A0A0B" />
    <!-- Beyazın %10'u: koyu yüzeyde fare üstü katmanı (yarı saydam olduğu için token karşılığı yok) -->
    <SolidColorBrush x:Key="KoyNotchHover" Color="#1AFFFFFF" />
    <!-- Beyazın %20'si ve %15'i: koyu yüzeyde basılı ve açık (seçili) düğme katmanı (dock tepsi düğmesi) -->
    <SolidColorBrush x:Key="KoyNotchPressed" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="KoyNotchActive" Color="#26FFFFFF" />
    <!-- Çentikte ikincil yazı (DESIGN: #A1A1AA) ve bölümleri ayıran ince çizgi -->
    <SolidColorBrush x:Key="KoyNotchTextMuted" Color="#A1A1AA" />
    <SolidColorBrush x:Key="KoyNotchDivider" Color="#20FFFFFF" />
    <!-- Açılır pencerelerin gölgesi (DropShadowEffect fırça değil renk ister) -->
    <Color x:Key="KoyShadowColor">#000000</Color>

    <!-- Yarı saydam gri: hem koyu hem açık yüzeyde okunur. -->
    <SolidColorBrush x:Key="KoyScrollThumb" Color="#66808088" />
    <SolidColorBrush x:Key="KoyScrollThumbHover" Color="#99808088" />
    <SolidColorBrush x:Key="KoyScrollThumbDrag" Color="#CC808088" />

    <!--
        Çentik H arayüzü (docs/design/source/CentikH.dc.html). Çentik temadan bağımsız koyu yüzeydir; her sayfanın
        kendi vurgu rengi ve kart tonları vardır. Pano ve Sistem sayfaları eklenince kendi kartları da buraya gelir.
    -->
    <SolidColorBrush x:Key="KoyNotchSurface" Color="#0A0A0B" />
    <SolidColorBrush x:Key="KoyNotchCard" Color="#141416" />
    <SolidColorBrush x:Key="KoyNotchChip" Color="#1F1F23" />
    <SolidColorBrush x:Key="KoyNotchMuted" Color="#A1A1AA" />
    <SolidColorBrush x:Key="KoyNotchDim" Color="#71717A" />
    <SolidColorBrush x:Key="KoyNotchOk" Color="#34D399" />
    <!-- Sekme vurguları (seçili sekmenin simgesi bu renge boyanır) -->
    <SolidColorBrush x:Key="KoyNotchAccentHome" Color="#F4F4F5" />
    <SolidColorBrush x:Key="KoyNotchAccentFocus" Color="#FB7185" />
    <SolidColorBrush x:Key="KoyNotchAccentShelf" Color="#FBBF24" />
    <SolidColorBrush x:Key="KoyNotchAccentClipboard" Color="#A78BFA" />
    <SolidColorBrush x:Key="KoyNotchAccentSystem" Color="#34D399" />
    <SolidColorBrush x:Key="KoyNotchAccentControl" Color="#3B82F6" />
    <!-- Ana: müzik kartı ve hava kartı -->
    <SolidColorBrush x:Key="KoyNotchMusicCard" Color="#0E2A18" />
    <SolidColorBrush x:Key="KoyNotchMusicCover" Color="#22C55E" />
    <SolidColorBrush x:Key="KoyNotchMusicSub" Color="#BBF7D0" />
    <SolidColorBrush x:Key="KoyNotchMusicSpectrum" Color="#BFBBF7D0" />
    <SolidColorBrush x:Key="KoyNotchWeatherCard" Color="#121A2B" />
    <SolidColorBrush x:Key="KoyNotchWeatherSoft" Color="#BFDBFE" />
    <SolidColorBrush x:Key="KoyNotchWeatherIconBg" Color="#223B82F6" />
    <!-- Odak -->
    <SolidColorBrush x:Key="KoyNotchFocusCard" Color="#1C1416" />
    <SolidColorBrush x:Key="KoyNotchFocusTrack" Color="#3A1F25" />
    <SolidColorBrush x:Key="KoyNotchFocusButton" Color="#2A1D20" />
    <SolidColorBrush x:Key="KoyNotchFocusSoft" Color="#FDA4AF" />
    <!-- Raf -->
    <SolidColorBrush x:Key="KoyNotchShelfCard" Color="#1A160C" />
    <SolidColorBrush x:Key="KoyNotchShelfChip" Color="#2A2312" />
    <SolidColorBrush x:Key="KoyNotchShelfChipText" Color="#FDE68A" />
    <SolidColorBrush x:Key="KoyNotchShelfSoft" Color="#FCD34D" />
    <SolidColorBrush x:Key="KoyNotchShelfDash" Color="#6B5A24" />
    <!-- Kontrol -->
    <SolidColorBrush x:Key="KoyNotchControlCard" Color="#121A2B" />
    <SolidColorBrush x:Key="KoyNotchControlTrack" Color="#1E2A44" />
    <SolidColorBrush x:Key="KoyNotchControlSoft" Color="#BFDBFE" />
    <SolidColorBrush x:Key="KoyNotchControlTile" Color="#1F1F23" />
    <SolidColorBrush x:Key="KoyNotchBrightness" Color="#FACC15" />
    <!-- Kontrol listeleri, kulaklık kartı ve "Bağlı cihazlar": pil yüzdesi, simge zemini, bağlı satır, hover -->
    <SolidColorBrush x:Key="KoyNotchControlBattery" Color="#93C5FD" />
    <SolidColorBrush x:Key="KoyNotchControlIconBg" Color="#383B82F6" />
    <SolidColorBrush x:Key="KoyNotchRowHover" Color="#2A2A30" />
    <SolidColorBrush x:Key="KoyNotchRowError" Color="#F87171" />
    <!-- Takvim -->
    <SolidColorBrush x:Key="KoyNotchAccentCalendar" Color="#38BDF8" />
    <SolidColorBrush x:Key="KoyNotchCalendarCard" Color="#0E1A24" />
    <SolidColorBrush x:Key="KoyNotchCalendarChip" Color="#16293A" />
    <SolidColorBrush x:Key="KoyNotchCalendarSoft" Color="#BAE6FD" />
    <!-- Pano -->
    <SolidColorBrush x:Key="KoyNotchClipCard" Color="#18132B" />
    <SolidColorBrush x:Key="KoyNotchClipChip" Color="#241D3D" />
    <SolidColorBrush x:Key="KoyNotchClipChipText" Color="#DDD6FE" />
    <SolidColorBrush x:Key="KoyNotchClipSoft" Color="#C4B5FD" />
    <!-- Sistem ve Ana'daki sistem kartları -->
    <SolidColorBrush x:Key="KoyNotchSystemCard" Color="#0F1F19" />
    <SolidColorBrush x:Key="KoyNotchSystemTrack" Color="#1E3A2F" />
    <SolidColorBrush x:Key="KoyNotchSystemSoft" Color="#A7F3D0" />
    <SolidColorBrush x:Key="KoyNotchNetCard" Color="#18132B" />
    <SolidColorBrush x:Key="KoyNotchNetSoft" Color="#C4B5FD" />
    <!-- Hızlı başlat boş yuva çerçevesi -->
    <SolidColorBrush x:Key="KoyNotchDash" Color="#3F3F46" />
    <!-- Görev onay kutusu çerçevesi, tamamlanan görev yazısı -->
    <SolidColorBrush x:Key="KoyNotchCheckBorder" Color="#52525B" />
    <SolidColorBrush x:Key="KoyNotchDoneText" Color="#71717A" /></ResourceDictionary>
